// Replication — серверная механика смерти и «репликации» (возрождения) криттеров в мире TLA.
// Выбирает карту возрождения (ближайший репликатор, ад или нестандартную карту Чистилища), ведёт счётчик
// визитов в ад и список PermanentDeath, сбрасывает состояние воскрешённого криттера и раскрывает новичку
// стартовую область глобальной карты; целиком под #if SERVER, дёргается из таймаутов репликации и старта игрока.
namespace Replication
{

#if SERVER

///@ Property Critter Server int32 ReplicationTime Mutable Persistent
///@ Property Critter Server int32 HellVisits Mutable Persistent
///@ Property Game Server ident[] PermanentDeath Mutable Persistent

const hstring HellMapPid = Content::Map::repl1; // TODO: вернуть ад Content::Map::repl_hell;
const hstring[] ReplicatorsMapPids = {Content::Map::repl1, Content::Map::repl2, Content::Map::repl3, Content::Map::repl4};
int ReplicatorPos = 0;

bool IsPermanentDeath(ident id)
{
    return Game.PermanentDeath.exists(id);
}

void ClearPermanentDeath()
{
    Game.PermanentDeath = array<ident>();
}

void AddPermanentDeath(ident id)
{
    auto permanentDeath = Game.PermanentDeath.clone();
    if (!permanentDeath.exists(id)) {
        permanentDeath.insertLast(id);
        Game.PermanentDeath = permanentDeath;
    }
}

Map? GetStartReplicatorMap()
{
    return Game.GetMap(ReplicatorsMapPids[0]);
}

Map? GetNearReplicatorMap(Critter cr)
{
    Map? nearMap = null;
    int nearDist = 0;
    for (int i = 0; i < ReplicatorsMapPids.length(); i++) {
        Map? map = Game.GetMap(ReplicatorsMapPids[i]);
        if (map != null) {
            Location loc = map.GetLocation();
            int dx = int(cr.WorldPos.x) - int(loc.WorldPos.x);
            int dy = int(cr.WorldPos.y) - int(loc.WorldPos.y);
            int dist = int(math::sqrt(dx * dx + dy * dy));

            // GameEventReplicator.fos: не даём реплицировать в replication4, пока идёт событие на станции
            if (loc.ProtoId == Content::Location::replication_4 && Game.GEReplStationStatus) {
                continue;
            }

            if (nearMap == null || dist < nearDist) {
                nearMap = map;
                nearDist = dist;
            }
        }
    }

    return nearMap;
}

void AddStartLocationSyncEntity(Entity[] & entities, Entity entity)
{
    for (int i = 0; i < entities.length(); i++) {
        if (entities[i] is entity) {
            return;
        }
    }

    entities.insertLast(entity);
}

void AddStartKnownLocation(Location[] & locations, Entity[] & syncCover, Location? loc)
{
    if (loc == null) {
        return;
    }

    for (int i = 0; i < locations.length(); i++) {
        if (locations[i] is loc) {
            return;
        }
    }

    locations.insertLast(loc);
    AddStartLocationSyncEntity(syncCover, loc);
}

// Перенос при создании и загрузке криттера вызывается из ре-энтрантного init-события. Сохраняем
// его покрытие и одним набором блокируем криттера, карту репликатора и все изменяемые известные локации.
[[Async]]
void SetStartLocation(Critter cr)
{
    Map? replicator = GetStartReplicatorMap();
    if (replicator == null) {
        return;
    }

    Entity[] syncCover = Sync::Snapshot();
    AddStartLocationSyncEntity(syncCover, cr);
    AddStartLocationSyncEntity(syncCover, replicator);
    if (!Sync::Lock(syncCover)) {
        return;
    }

    Location replicatorLocation = replicator.GetLocation();
    Location[] knownLocations = {};
    AddStartKnownLocation(knownLocations, syncCover, replicatorLocation);
    if (!Sync::Lock(syncCover) || replicator.GetLocation() !is replicatorLocation) {
        return;
    }

    AddStartKnownLocation(knownLocations, syncCover, Game.GetLocation(Content::Location::replication_hell));

    hstring replicatorPid = replicatorLocation.ProtoId;
    if (replicatorPid == Content::Location::replication_1) {
        AddStartKnownLocation(knownLocations, syncCover, Game.GetLocation(Content::Location::den));
        AddStartKnownLocation(knownLocations, syncCover, Game.GetLocation(Content::Location::klamath));
        AddStartKnownLocation(knownLocations, syncCover, Game.GetLocation(Content::Location::arroyo));
    }
    else if (replicatorPid == Content::Location::replication_2) {
        AddStartKnownLocation(knownLocations, syncCover, Game.GetLocation(Content::Location::modoc));
    }
    else if (replicatorPid == Content::Location::replication_3) {
        AddStartKnownLocation(knownLocations, syncCover, Game.GetLocation(Content::Location::redding));
    }
    else if (replicatorPid == Content::Location::replication_4) {
        AddStartKnownLocation(knownLocations, syncCover, Game.GetLocation(Content::Location::broken_hills));
        AddStartKnownLocation(knownLocations, syncCover, Game.GetLocation(Content::Location::new_reno));
    }

    if (!Sync::Lock(syncCover) || replicator.GetLocation() !is replicatorLocation) {
        return;
    }

    // Полностью закрываем туманом область вокруг стартовой позиции игрока
    int zoneX = cr.WorldPos.x / Settings.GlobalMap.GlobalMapZoneLength;
    int zoneY = cr.WorldPos.y / Settings.GlobalMap.GlobalMapZoneLength;
    GlobalMapFog::SetFog(cr, zoneX, zoneY, GlobalMapFog::GM_FOG_FULL);
    GlobalMapFog::SetFog(cr, zoneX - 1, zoneY - 1, GlobalMapFog::GM_FOG_FULL);
    GlobalMapFog::SetFog(cr, zoneX, zoneY - 1, GlobalMapFog::GM_FOG_FULL);
    GlobalMapFog::SetFog(cr, zoneX + 1, zoneY - 1, GlobalMapFog::GM_FOG_FULL);
    GlobalMapFog::SetFog(cr, zoneX - 1, zoneY, GlobalMapFog::GM_FOG_FULL);
    GlobalMapFog::SetFog(cr, zoneX + 1, zoneY, GlobalMapFog::GM_FOG_FULL);
    GlobalMapFog::SetFog(cr, zoneX - 1, zoneY + 1, GlobalMapFog::GM_FOG_FULL);
    GlobalMapFog::SetFog(cr, zoneX, zoneY + 1, GlobalMapFog::GM_FOG_FULL);
    GlobalMapFog::SetFog(cr, zoneX + 1, zoneY + 1, GlobalMapFog::GM_FOG_FULL);

    bool transferred = Entrance::CritterTransferToMapEntry(cr, replicator.Id, Tla::ENTRY_REPLICATION);

    // TransferToMap запускает вложенные события, которые могут заменить набор Game.Sync.
    if (!Sync::Lock(syncCover) || (transferred && (cr.MapId != replicator.Id || cr.GetMap() !is replicator)) || replicator.GetLocation() !is replicatorLocation) {
        return;
    }

    for (int i = 0; i < knownLocations.length(); i++) {
        Location::SetKnownLoc(cr, knownLocations[i]);
    }

    zoneX = cr.WorldPos.x / Settings.GlobalMap.GlobalMapZoneLength;
    zoneY = cr.WorldPos.y / Settings.GlobalMap.GlobalMapZoneLength;
    GlobalMapFog::SetFog(cr, zoneX, zoneY, GlobalMapFog::GM_FOG_NONE);
    GlobalMapFog::SetFog(cr, zoneX - 1, zoneY - 1, GlobalMapFog::GM_FOG_HALF);
    GlobalMapFog::SetFog(cr, zoneX, zoneY - 1, GlobalMapFog::GM_FOG_HALF);
    GlobalMapFog::SetFog(cr, zoneX + 1, zoneY - 1, GlobalMapFog::GM_FOG_HALF);
    GlobalMapFog::SetFog(cr, zoneX - 1, zoneY, GlobalMapFog::GM_FOG_HALF);
    GlobalMapFog::SetFog(cr, zoneX + 1, zoneY, GlobalMapFog::GM_FOG_HALF);
    GlobalMapFog::SetFog(cr, zoneX - 1, zoneY + 1, GlobalMapFog::GM_FOG_HALF);
    GlobalMapFog::SetFog(cr, zoneX, zoneY + 1, GlobalMapFog::GM_FOG_HALF);
    GlobalMapFog::SetFog(cr, zoneX + 1, zoneY + 1, GlobalMapFog::GM_FOG_HALF);
}

void SetReplicationTime(Critter cr)
{
    int replTime = cr.ReplicationTime;
    if (replTime < 0) {
        return; // Возрождение отключено
    }

    if (replTime == 0) // Берём значения по умолчанию
    {
        if (cr.ControlledByPlayer) {
            replTime = 3; // 3 минуты
        }
        else {
            replTime = Game.Random(90, 120); // 90-120 минут
        }
    }

    cr.TimeoutReplication = Game.SynchronizedTime + Time::Minutes(replTime);
}

bool IsHellMap(hstring mapPid)
{
    return mapPid == HellMapPid;
}

void ReplicateCritter(Critter cr)
{
    Map? dieMap = cr.GetMap();
    Map? map = null;
    mpos hex;

    // Проверяем наличие машины
    Item[] cars = cr.GetItems(ItemProperty::Type, ItemType::Car);
    if (cars.length() > 0) {
        // Переносим на случайную встречу (энкаунтер)
        bool transferred = false;
        int encounterDescriptor = int(-1);
        bool waitForAnswer = false;
        Worldmap::FindEncounter(GlobalmapGroupExtended::GetGlobalGroup(cr), cars[0], cr.WorldPos.x, cr.WorldPos.y, encounterDescriptor, waitForAnswer, true);
        if (encounterDescriptor != int(-1)) {
            ident mapId;
            uint8 dir = 0;
            Worldmap::InviteToEncounter(GlobalmapGroupExtended::GetGlobalGroup(cr), cars[0], encounterDescriptor, 0, mapId, hex, dir);
            if (mapId != ZERO_IDENT) {
                Map? mapTo = Game.GetMap(mapId);
                if (mapTo != null) {
                    cr.TransferToMap(mapTo, hex, dir);
                    transferred = true;
                }
            }
        }

        // Встреча не найдена или перенос не удался — уничтожаем машины
        if (!transferred) {
            for (int i = 0; i < cars.length(); i++) {
                Game.DestroyItem(cars[i]);
            }
        }

        // Остаёмся мёртвыми, повторим репликацию позже
        cr.TimeoutReplication = Game.SynchronizedTime + Time::Minutes(1);
        return;
    }

    if (cr.ControlledByPlayer) {
        bool dieMapIsHell = (dieMap != null && IsHellMap(dieMap.ProtoId));
        bool customReplMap = false;
        if (cr.NextReplicationMap != ZERO_IDENT) {
            // Нестандартная репликация в Чистилище
            Purgatory::NeedReplicateCritterToBattle(cr);
            customReplMap = true; // репликация на других картах
        }

        if (not customReplMap && cr.ReplicationMoney < 0) {
            map = Game.GetMap(HellMapPid);

            if (not dieMapIsHell) {
                cr.HellVisits += 1;

                // Показываем ролик ада при первом попадании
                if (cr.HellVisits == 1) {
                    Media::PlayVideo(cr, "TheLifeAfterHell.ogv|TheLifeAfterHell.ogg", false);
                }

                // Окончательная смерть
                if (Settings.Combat.PermanentDeath > 0 && cr.HellVisits > Settings.Combat.PermanentDeath) {
                    AddPermanentDeath(cr.Id);
                    Messaging::Info(cr, TextPackKey(TextPackName::Game, "" + (MsgStr::StrNetPermanentDeath)));
                    cr.Disconnect();
                }
            }
        }
        else {
            if (customReplMap) {
                map = Game.GetMap(cr.NextReplicationMap);
            }
            else {
                map = GetNearReplicatorMap(cr);
            }
        }

        if (map == null || not Entrance::GetEntryFreeHex(map, (customReplMap ? cr.NextReplicationEntry : Tla::ENTRY_REPLICATION), hex)) {
            // Остаёмся мёртвыми, повторим репликацию позже
            cr.TimeoutReplication = Game.SynchronizedTime + Time::Minutes(1);
            return;
        }

        if (Tla::CanCritterDropItemsOnDead(cr)) {
            Map? dropMap = cr.GetMap();
            Item[] items = cr.GetItems();

            // Скрытые предметы не роняем, а gag-предметы (мешки с песком) удаляем
            for (int i = 0; i < items.length(); i++) {
                if (items[i].IsGag) {
                    Game.DestroyItem(items[i]);
                    items[i] = null;
                }
                else if (items[i].Hidden) {
                    items[i] = null;
                }
            }

            // Роняем предметы на землю
            if (dropMap != null) {
                ItemMovement::MoveItems(items, dropMap, cr.Hex);
            }
            else {
                Game.DestroyItems(items);
            }
        }

        if (!customReplMap) {
            if (not dieMapIsHell) {
                cr.ReplicationMoney -= cr.ReplicationCost;
                cr.AddItem(Content::Item::flower, 1);
                if (cr.ReplicationMoney >= 100) {
                    cr.AddItem(Content::Item::radio, 1); // Выдаём радио
                }
            }

            cr.ReplicationCount += 1;
        }
        else {
            // Очистка данных по нестандартной репликации
            cr.NextReplicationMap = ZERO_IDENT;
            cr.NextReplicationEntry = EMPTY_HSTRING;
        }
    }
    else {
        NpcPlanes::DropPlanes(cr);
        EnemyStack::ClearEnemyStackNpc(cr);
        cr.LastWeaponId = ZERO_IDENT;
        cr.LastWeaponNotFound = false;
        map = cr.GetMap();
        if (map == null) // На глобальной карте — просто удаляем
        {
            Game.DestroyCritter(cr);
            return;
        }

        hex = cr.Hex;

        if (cr.DeadBlockerId != ZERO_IDENT) {
            Item? block = Game.GetItem(cr.DeadBlockerId);
            if (block != null) {
                Game.DestroyItem(block);
            }

            cr.DeadBlockerId = ZERO_IDENT;
        }

        if (not map.IsHexMovable(hex)) {
            bool founded = false;
            for (int x = -1; x <= 1; x++) {
                for (int y = -1; y <= 1; y++) {
                    if (x == 0 && y == 0) {
                        continue; // Пропускаем центральную клетку
                    }

                    if (Settings.Geometry.MapHexagonal) {
                        if ((hex.x % 2) == 1 && ((x == -1 && y == 1) || (x == 1 && y == 1))) {
                            continue;
                        }

                        if ((hex.x % 2) == 0 && ((x == -1 && y == -1) || (x == 1 && y == -1))) {
                            continue;
                        }
                    }

                    if (map.IsHexMovable(mpos(hex.x + x, hex.y + y))) {
                        hex.x += x;
                        hex.y += y;
                        founded = true;
                        break;
                    }
                }

                if (founded) {
                    break;
                }
            }

            if (not founded) {
                // Остаёмся мёртвыми, повторим репликацию позже
                cr.TimeoutReplication = Game.SynchronizedTime + Time::Minutes(1);
                return;
            }
        }
    }

    if (map == null) {
        cr.TimeoutReplication = Game.SynchronizedTime + Time::Minutes(1);
        return;
    }

    cr.TransferToMap(map, hex, HDIR_Random);
    cr.IsDamagedEye = false;
    cr.IsDamagedRightArm = false;
    cr.IsDamagedLeftArm = false;
    cr.IsDamagedRightLeg = false;
    cr.IsDamagedLeftLeg = false;
    if (cr.NextCrType != EMPTY_HSTRING) {
        // cr.ChangeCrType( cr.NextCrType );
        cr.ModelNameBase = cr.NextCrType;
        cr.NextCrType = EMPTY_HSTRING;
    }

    CritterState::ToAlive(cr);
    cr.CurrentHp = cr.MaxLife;
    cr.CurrentAp = cr.ActionPoints * Tla::AP_DIVIDER;
    Poison::DropPoison(cr);
    Radiation::DropRadiation(cr);
    if (!cr.ControlledByPlayer || map.ProtoId != HellMapPid) {
        Drugs::DropDrugEffects(cr); // Внимание: снимает эффекты всех активных наркотиков/радиации/яда!
    }

    GlobalmapGroupExtended::DropTimers(cr);
    for (int i = 0; i < CritterPropertyGroup::Timeouts.length(); i++) {
        if (CritterPropertyGroup::Timeouts[i] != CritterProperty::TimeoutKarmaVoting) {
            cr.SetAsInt(CritterPropertyGroup::Timeouts[i], 0);
        }
    }
}

//
// Турель
//
void TurretInit(Critter turret, bool firstTime)
{
    turret.PerceptionBase = 10;
    turret.SkillBigGuns = 300;
    turret.SkillEnergyWeapons = 300;
    turret.IsNoEnemyStack = true;
    turret.IsUnlimitedAmmo = true;
}

//
// Хабологист
//
void HubologistInit(Critter hubologist, bool firstTime)
{
    hubologist.IsNoEnemyStack = true;
}

#endif

}
