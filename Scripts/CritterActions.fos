// CritterActions — серверная обработка действий криттера в реальном времени (RT). Ключевые обязанности:
// списание AP (ProcessAp), подбор/выброс/перенос предметов, операции с контейнерами/бартер/кража,
// перезарядка оружия, использование умений/предметов, атака. Сторона: SERVER.
// Связи: Tla (AP_DIVIDER), CritterState, ItemMovement, Combat, Parameters, WeaponHelpers, Messaging, MsgStr.
namespace CritterActions
{

const int CONTAINER_ACTION_TAKE = 0;
const int CONTAINER_ACTION_TAKE_ALL = 1;
const int CONTAINER_ACTION_PUT = 2;
const int USE_TIMER_MIN_SECONDS = 1;
const int USE_TIMER_MAX_SECONDS = 599;

// Кодирует actionExt контейнерного действия по контракту GameEnums/ClientMain:
// десятки — TransferTypes, единицы — направление операции.
int EncodeContainerActionExt(TransferTypes transferType, bool take, bool all)
{
    int direction = !take ? CONTAINER_ACTION_PUT : (all ? CONTAINER_ACTION_TAKE_ALL : CONTAINER_ACTION_TAKE);
    return int(transferType) * 10 + direction;
}

// Общий пространственный контракт предметного контейнера на карте.
bool IsMapContainerAccessValid(ItemOwnership ownership, ident critterMapId, ident containerMapId, int distance, int critterMultihex)
{
    return ownership == ItemOwnership::MapHex && critterMapId != ZERO_IDENT && critterMapId == containerMapId && distance >= 0 && critterMultihex >= 0 &&
           distance <= 1 + critterMultihex;
}

// Дистанция взаимодействия с контейнером-криттером учитывает multihex обеих сторон.
bool IsCritterContainerInRange(int distance, int critterMultihex, int containerMultihex)
{
    return distance >= 0 && critterMultihex >= 0 && containerMultihex >= 0 && distance <= 1 + critterMultihex + containerMultihex;
}

// Без переполнения добавляет объём стека к уже занятому объёму контейнера.
bool TryAddContainerStackVolume(int64 currentVolume, int unitVolume, int count, int64 capacity, int64& nextVolume)
{
    nextVolume = currentVolume;
    if (currentVolume < 0 || unitVolume < 0 || count <= 0 || capacity < 0 || currentVolume > capacity) {
        return false;
    }

    int64 remaining = capacity - currentVolume;
    if (int64(unitVolume) > remaining / count) {
        return false;
    }

    nextVolume = currentVolume + int64(unitVolume) * count;
    return true;
}

// Таймер разрешён только таймерному предмету при использовании на себя. Обычные применения
// обязаны передавать ноль, чтобы произвольный RPC-параметр не превращался в скрытый режим предмета.
bool IsUseItemTimerAllowed(bool timedItem, bool selfTarget, int timer)
{
    return timedItem ? selfTarget && timer >= USE_TIMER_MIN_SECONDS && timer <= USE_TIMER_MAX_SECONDS : timer == 0;
}

bool IsSelfUseTarget(ident critterId, ident targetCritterId)
{
    return critterId != ZERO_IDENT && targetCritterId == critterId;
}

bool IsContainerSelfMove(ident movingItemId, ident containerId)
{
    return movingItemId != ZERO_IDENT && movingItemId == containerId;
}

#if SERVER

// Пытается списать ap очков действия. Если очков не хватает — ставит криттера в ожидание
// до момента, когда регенерация доберёт недостающее, и возвращает false (действие не выполняем).
// При успехе списывает AP, взводит тик регенерации и брейктайм, возвращает true.
bool ProcessAp(Critter cr, int ap)
{
    if (cr.CurrentAp / Tla::AP_DIVIDER < int(ap)) {
        int apRegeneration = cr.ApRegenerationTime;
        if (apRegeneration == 0) {
            apRegeneration = Settings.Combat.ApRegeneration;
        }

        CritterState::Wait(cr, apRegeneration / cr.ActionPoints * (ap - cr.CurrentAp / Tla::AP_DIVIDER));
        return false;
    }

    cr.CurrentAp = (cr.CurrentAp / Tla::AP_DIVIDER - ap) * Tla::AP_DIVIDER;
    cr.ApRegenerationTick = Game.FrameTime + Time::Milliseconds(Settings.Movement.Breaktime);
    CritterState::Wait(cr, Settings.Movement.Breaktime);

    return true;
}

// Обыск (лут) мёртвого криттера. Списывает AP, проверяет дистанцию и состояние цели,
// затем поднимает событие навыка лута.
void PickCritter(Critter cr, Critter pickCr)
{
    // Списываем AP
    if (!ProcessAp(cr, Settings.Movement.RtApCostPickCritter)) {
        return;
    }

    if (!cr.IsAlive()) {
        throw("Critter is not alive", cr);
    }

    if (!pickCr.IsDead()) {
        throw("Pick critter is not dead", pickCr);
    }

    if (pickCr.IsNoLoot) {
        return;
    }

    if (Game.GetDistance(cr.Hex, pickCr.Hex) > 1 + cr.Multihex) {
        throw("Target too far", cr, cr.Hex.x, cr.Hex.y, pickCr.Hex.x, pickCr.Hex.y);
    }

    Map? map = cr.GetMap();
    if (map == null) {
        throw("Critter is on global map", cr);
    }

    Map? mapPick = pickCr.GetMap();
    if (mapPick == null) {
        throw("Pick critter is on global map", pickCr);
    }

    cr.Action(CritterAction::PickCritter, 0, null);
    (Game.OnCritterUseSkill.Fire(cr, CritterProperty::SpecialSkillLootCritter, pickCr, null, null) == EventResult::ContinueChain);
}

// Подбор предмета с гекса. Различает обычный предмет на земле, сценерий и стену:
// для предмета/сценерия поднимает событие навыка подбора, для стены — сообщение «нечем взять».
void PickItem(Critter cr, mpos hex, hstring pid)
{
    // Списываем AP
    if (!ProcessAp(cr, Settings.Movement.RtApCostPickItem)) {
        return;
    }

    if (!cr.IsAlive()) {
        throw("Critter is not alive", cr);
    }

    if (Game.GetDistance(cr.Hex, hex) > 1 + cr.Multihex) {
        throw("Target too far", cr, cr.Hex.x, cr.Hex.y, hex.x, hex.y);
    }

    Map? map = cr.GetMap();
    if (map == null) {
        throw("Critter is on global map", cr);
    }

    if (hex.x >= map.Size.width || hex.y >= map.Size.height) {
        throw("Invalid hex position", cr, hex.x, hex.y);
    }

    if (!Game.CheckProtoItem(pid)) {
        throw("Invalid pid", cr, pid);
    }

    ProtoItem proto = Game.GetProtoItem(pid);

    if (!proto.IsScenery && !proto.IsWall) {
        Item? item = map.GetItemOnHex(hex, pid);
        if (item == null) {
            throw("Item not found", cr, hex.x, hex.y, pid);
        }

        cr.Action(CritterAction::PickItem, 0, item);
        (Game.OnCritterUseSkill.Fire(cr, CritterProperty::SpecialSkillPickOnGround, null, item, null) == EventResult::ContinueChain);
    }
    else if (proto.IsScenery) {
        StaticItem? scenery = map.GetStaticItemOnHex(hex, pid);
        if (scenery == null) {
            throw("Scenery not found", cr, hex.x, hex.y, pid);
        }

        cr.Action(CritterAction::PickItem, 0, scenery);
        (Game.OnCritterUseSkill.Fire(cr, CritterProperty::SpecialSkillPickOnGround, null, null, scenery) == EventResult::ContinueChain);
    }
    else if (proto.IsWall) {
        Messaging::Info(cr, TextPackKey(TextPackName::Game, "" + (MsgStr::Get("StrUseNothing"))));
    }
    else {
        Messaging::Info(cr, TextPackKey(TextPackName::Game, "" + (MsgStr::Get("StrUseNothing"))));
    }
}

// Выброс предмета из инвентаря. На карте кладёт предмет на гекс криттера; на глобалке —
// либо уменьшает стак, либо уничтожает предмет (положить некуда).
void DropInvItem(Critter cr, ident itemId, int count)
{
    // Списываем AP
    if (!ProcessAp(cr, Settings.Movement.RtApCostDropItem)) {
        return;
    }

    // Проверки криттера
    if (!cr.IsAlive()) {
        throw("Critter is not alive", cr);
    }

    // Берём предмет
    Item? item = cr.GetItem(itemId);
    if (item == null) {
        throw("Item not found", cr, itemId);
    }

    if (count == 0) {
        count = item.Count;
    }

    if (count <= 0 || count > item.Count) {
        throw("Invalid count", cr, item, count);
    }

    // Анимация
    cr.Action(CritterAction::DropItem, -1, item);

    // Выбрасываем
    Map? map = cr.GetMap();
    if (map != null) {
        ItemMovement::MoveItem(item, count, map, cr.Hex);
    }
    else if (count < item.Count) {
        item.Count -= count;
    }
    else {
        Game.DestroyItem(item);
    }
}

// Применение навыка к цели: криттеру, предмету на карте или сценерию. Резолвит цель по id/pid,
// проверяет видимость и дистанцию, затем поднимает событие применения навыка.
void UseSkill(Critter cr, CritterProperty skill, ident targetCrId, ident targetItemId, hstring sceneryPid, int hx, int hy)
{
    if (!cr.IsAlive()) {
        throw("Client is not alive", cr);
    }

    // Списываем AP
    int ap = Settings.Movement.RtApCostUseSkill;
    if (!ProcessAp(cr, ap)) {
        return;
    }

    Critter? targetCr;
    Item? targetItem;
    StaticItem? targetScen;
    int useDist = 3 + cr.Multihex;

    if (targetCrId != ZERO_IDENT) {
        if (cr.Id != targetCrId) {
            if (cr.GetMap() != null) {
                targetCr = Game.GetCritter(targetCrId);
                if (targetCr == null) {
                    throw("Target critter not found", cr, targetCrId);
                }

                if (!cr.IsSee(targetCr)) {
                    throw("Critter doesn't see target critter", cr, targetCr);
                }

                if (Game.GetDistance(cr.Hex, targetCr.Hex) > useDist + targetCr.Multihex) {
                    throw("Target critter too far", cr, targetCr);
                }
            }
            else {
                // нужна реализация
                throw("Target critter not found in global group", cr, targetCrId);
            }
        }
        else {
            targetCr = cr;
        }
    }
    else if (targetItemId != ZERO_IDENT || sceneryPid != EMPTY_HSTRING) {
        Map? map = cr.GetMap();
        if (map == null) {
            throw("Critter on global map", cr);
        }

        if (sceneryPid == EMPTY_HSTRING) {
            targetItem = map.GetItem(targetItemId);
            if (targetItem == null) {
                throw("Target item not found on map", cr, map, targetItemId);
            }

            if (targetItem.Hidden) {
                throw("Target item is hidden", cr, map, targetItem);
            }

            if (Game.GetDistance(cr.Hex, targetItem.Hex) > useDist) {
                throw("Target item too far", cr, targetItem);
            }
        }
        else {
            if (!Game.CheckProtoItem(sceneryPid)) {
                throw("Proto item not found", cr, sceneryPid);
            }

            ProtoItem proto = Game.GetProtoItem(sceneryPid);

            if (Game.GetDistance(cr.Hex, mpos(hx, hy)) > useDist) {
                throw("Target scenery too far", cr, hx, hy, sceneryPid);
            }

            targetScen = map.GetStaticItemOnHex(mpos(hx, hy), sceneryPid);
            if (targetScen == null) {
                throw("Scenery not found", cr, hx, hy, sceneryPid);
            }
        }
    }

    // Запускаем действие
    cr.Action(CritterAction::UseSkill, 0, null);

    (Game.OnCritterUseSkill.Fire(cr, skill, targetCr, targetItem, targetScen) == EventResult::ContinueChain);
}

// Перемещение предмета между слотами инвентаря криттера. Перекладка между основным
// и вторым слотом руки бесплатна (apCost = 0), остальное стоит AP.
void MoveInvItem(Critter cr, ident itemId, CritterItemSlot slot)
{
    // Берём предмет
    Item? item = cr.GetItem(itemId);
    if (item == null) {
        throw("Item not found", cr, itemId);
    }

    // Считаем стоимость перемещения
    int apCost = Settings.Movement.RtApCostMoveItemInventory;
    if ((item.CritterSlot == CritterItemSlot::Main && slot == CritterItemSlot::Secondary) ||
        (item.CritterSlot == CritterItemSlot::Secondary && slot == CritterItemSlot::Main)) {
        apCost = 0;
    }

    // Списываем AP
    if (!ProcessAp(cr, apCost)) {
        return;
    }

    // Проверки криттера
    if (!cr.IsAlive()) {
        throw("Critter is not alive", cr);
    }

    // Перемещаем
    cr.ChangeItemSlot(item.Id, slot);
}

// Захватывает полный набор сущностей, который затем читает/меняет OperateContainer. Промежуточный
// lock cr+target нужен до чтения карт; итоговый Game.Sync одним вызовом удерживает обе карты тоже.
[[Async]]
bool LockContainerTransfer(Critter cr, TransferTypes expectedTransferType, ident expectedContainerId, uint expectedTransferSession)
{
    while (true) {
        if (!Sync::Lock(cr)) {
            return false;
        }

        if (cr.TransferType != expectedTransferType || cr.TransferContainerId != expectedContainerId || cr.TransferSession != expectedTransferSession ||
            expectedContainerId == ZERO_IDENT || expectedContainerId == cr.Id) {
            return false;
        }

        if (expectedTransferType == TransferTypes::HexContUp || expectedTransferType == TransferTypes::HexContDown ||
            expectedTransferType == TransferTypes::SelfCont || expectedTransferType == TransferTypes::FarCont) {
            Item? itemCont = Game.GetItem(expectedContainerId);
            if (itemCont == null || !Sync::Lock(cr, itemCont)) {
                return false;
            }

            if (cr.TransferType != expectedTransferType || cr.TransferContainerId != expectedContainerId || cr.TransferSession != expectedTransferSession) {
                return false;
            }

            Map? crMap = cr.GetMap();
            Map? itemMap = itemCont.GetMap();
            ident crMapId = cr.MapId;
            ident itemMapId = itemCont.MapId;
            Entity[] syncCover = {cr, itemCont};
            if (crMap != null) {
                syncCover.insertLast(crMap);
            }
            if (itemMap != null && (crMap == null || itemMap.Id != crMap.Id)) {
                syncCover.insertLast(itemMap);
            }

            if (!Sync::Lock(syncCover)) {
                return false;
            }

            if (cr.TransferType != expectedTransferType || cr.TransferContainerId != expectedContainerId || cr.TransferSession != expectedTransferSession) {
                return false;
            }
            if (cr.MapId != crMapId || itemCont.MapId != itemMapId) {
                continue;
            }

            return true;
        }

        if (expectedTransferType == TransferTypes::CritLoot || expectedTransferType == TransferTypes::CritSteal ||
            expectedTransferType == TransferTypes::FarCrit) {
            Critter? crCont = Game.GetCritter(expectedContainerId);
            if (crCont == null || !Sync::Lock(cr, crCont)) {
                return false;
            }

            if (cr.TransferType != expectedTransferType || cr.TransferContainerId != expectedContainerId || cr.TransferSession != expectedTransferSession) {
                return false;
            }

            Map? crMap = cr.GetMap();
            Map? contMap = crCont.GetMap();
            ident crMapId = cr.MapId;
            ident contMapId = crCont.MapId;
            Entity[] syncCover = {cr, crCont};
            if (crMap != null) {
                syncCover.insertLast(crMap);
            }
            if (contMap != null && (crMap == null || contMap.Id != crMap.Id)) {
                syncCover.insertLast(contMap);
            }

            if (!Sync::Lock(syncCover)) {
                return false;
            }

            if (cr.TransferType != expectedTransferType || cr.TransferContainerId != expectedContainerId || cr.TransferSession != expectedTransferSession) {
                return false;
            }
            if (cr.MapId != crMapId || crCont.MapId != contMapId) {
                continue;
            }

            return true;
        }

        return false;
    }

    return false;
}

// Только эти типы transfer разрешают общий контейнерный RPC. NPC-бартер обязан идти через
// Barter::ProcessBarterNpcOffer, иначе клиент мог бы забрать товар без проверки стоимости.
bool IsContainerTransferType(TransferTypes transferType)
{
    return transferType == TransferTypes::HexContUp || transferType == TransferTypes::HexContDown || transferType == TransferTypes::SelfCont ||
           transferType == TransferTypes::CritLoot || transferType == TransferTypes::CritSteal || transferType == TransferTypes::FarCont ||
           transferType == TransferTypes::FarCrit;
}

bool IsActiveContainerTransfer(Critter cr, TransferTypes transferType, ident containerId, uint transferSession)
{
    return cr.TransferType == transferType && cr.TransferContainerId == containerId && cr.TransferSession == transferSession;
}

// Единое правило видимости применяется и к первому снимку, и ко всем refresh после операции.
bool IsContainerItemVisible(TransferTypes transferType, bool isNoLoot, bool isNoSteal)
{
    return !((transferType == TransferTypes::CritLoot && isNoLoot) || (transferType == TransferTypes::CritSteal && isNoSteal));
}

void FilterContainerItems(Item[] items, TransferTypes transferType)
{
    for (int i = 0; i < items.length();) {
        if (!IsContainerItemVisible(transferType, items[i].IsNoLoot, items[i].IsNoSteal)) {
            items.removeAt(i);
        }
        else {
            i++;
        }
    }
}

bool IsContainerAccessOpen(bool changeable, bool opened)
{
    return !changeable || opened;
}

void CloseContainerTransfer(Critter cr)
{
    Item[]? items = null;
    cr.TransferType = TransferTypes::Close;
    cr.TransferContainerId = ZERO_IDENT;
    cr.SendItems(items);
}

void SendContainerSnapshot(Critter cr, TransferTypes transferType, Item? itemCont, Critter? crCont)
{
    Item[] items;
    if (itemCont != null && !itemCont.IsDestroyed) {
        items = itemCont.GetItems(Tla::RootContainerStack());
    }
    else if (crCont != null && !crCont.IsDestroyed) {
        items = crCont.GetItems(ItemProperty::CritterSlot, CritterItemSlot::Inventory);
    }
    else {
        CloseContainerTransfer(cr);
        return;
    }

    FilterContainerItems(items, transferType);
    cr.SendItems(items, false, false, 1);
}

// Проверяет вместимость предметного контейнера с учётом уже лежащих в корневом стеке
// предметов и добавляемой операции. Все промежуточные суммы ограничены capacity.
bool CanPutItemsInContainer(Item container, Item[] movingItems, bool all, int itemCount)
{
    int64 capacity = container.Container_Volume;
    int64 volume = 0;
    int64 nextVolume = 0;
    Item[] containedItems = container.GetItems(Tla::RootContainerStack());

    for (int i = 0; i < containedItems.length(); i++) {
        if (!TryAddContainerStackVolume(volume, containedItems[i].Volume, containedItems[i].Count, capacity, nextVolume)) {
            return false;
        }
        volume = nextVolume;
    }

    for (int i = 0; i < movingItems.length(); i++) {
        int moveCount = all ? movingItems[i].Count : itemCount;
        if (!TryAddContainerStackVolume(volume, movingItems[i].Volume, moveCount, capacity, nextVolume)) {
            return false;
        }
        volume = nextVolume;
    }

    return true;
}

// Запрещает сделать контейнер собственным потомком. Повреждённая или уже циклическая
// цепочка родителей также считается небезопасной и не расширяется новым перемещением.
bool WouldCreateContainerCycle(Item movingItem, Item targetContainer)
{
    if (movingItem.Type != ItemType::Container) {
        return false;
    }

    Item current = targetContainer;
    for (int depth = 0; depth < 256; depth++) {
        if (IsContainerSelfMove(movingItem.Id, current.Id)) {
            return true;
        }
        if (current.Ownership != ItemOwnership::ItemContainer || current.ContainerId == ZERO_IDENT) {
            return false;
        }

        Item? parent = Game.GetItem(current.ContainerId);
        if (parent == null) {
            return true;
        }
        current = parent;
    }

    return true;
}

// Универсальная операция перекладки предметов через активный TransferType криттера:
// лут/кража с криттера и контейнеры на гексе/в инвентаре/дальние. Все проверки повторяются
// на сервере под полным sync-cover; клиент получает authoritative snapshot даже при stale-вводе.
void OperateContainer(Critter cr, bool take, bool all, ident itemId, int itemCount)
{
    TransferTypes transferType = cr.TransferType;
    if (!IsContainerTransferType(transferType)) {
        return;
    }

    ident transferContainerId = cr.TransferContainerId;
    uint transferSession = cr.TransferSession;

    if (!cr.IsAlive()) {
        CloseContainerTransfer(cr);
        return;
    }

    Map? map = cr.GetMap();
    if (map == null && transferType != TransferTypes::CritSteal && transferType != TransferTypes::FarCont && transferType != TransferTypes::FarCrit &&
        transferType != TransferTypes::SelfCont) {
        CloseContainerTransfer(cr);
        return;
    }

    // Резолвим контейнер (предмет-контейнер или криттер-контейнер) и повторно проверяем
    // capability, которая могла стать недействительной после открытия окна.
    Item? itemCont;
    Critter? crCont;
    if (transferType == TransferTypes::HexContUp || transferType == TransferTypes::HexContDown || transferType == TransferTypes::SelfCont ||
        transferType == TransferTypes::FarCont) {
        itemCont = transferType == TransferTypes::SelfCont ? cr.GetItem(cr.TransferContainerId) : Game.GetItem(cr.TransferContainerId);
        if (itemCont == null || itemCont.Type != ItemType::Container || !IsContainerAccessOpen(itemCont.Container_Changeble, itemCont.Opened)) {
            CloseContainerTransfer(cr);
            return;
        }

        if (transferType == TransferTypes::HexContUp || transferType == TransferTypes::HexContDown) {
            if (map == null || !IsMapContainerAccessValid(itemCont.Ownership, cr.MapId, itemCont.MapId, Game.GetDistance(cr.Hex, itemCont.Hex), cr.Multihex)) {
                CloseContainerTransfer(cr);
                return;
            }
        }
    }
    else {
        crCont = Game.GetCritter(cr.TransferContainerId);
        if (crCont == null || crCont.Id == cr.Id) {
            CloseContainerTransfer(cr);
            return;
        }

        if (transferType != TransferTypes::FarCrit &&
            (cr.MapId != crCont.MapId || !cr.IsSee(crCont) || !IsCritterContainerInRange(Game.GetDistance(cr.Hex, crCont.Hex), cr.Multihex, crCont.Multihex))) {
            CloseContainerTransfer(cr);
            return;
        }

        if ((transferType == TransferTypes::CritSteal && crCont.IsNoSteal) ||
            (transferType == TransferTypes::CritLoot && (crCont.IsNoLoot || !crCont.IsDead()))) {
            CloseContainerTransfer(cr);
            return;
        }
    }

    if ((!all && itemCount <= 0) || (all && transferType == TransferTypes::CritSteal)) {
        SendContainerSnapshot(cr, transferType, itemCont, crCont);
        return;
    }

    // Собираем список предметов для перекладки. Stale id/count является обычным отказом
    // недоверенного клиента: возвращаем свежий снимок вместо исключения и зависшего UI.
    Item[] items;
    if (take) {
        if (itemCont != null) {
            if (!all) {
                Item? item = Game.GetItem(itemId);
                if (item == null || item.Ownership != ItemOwnership::ItemContainer || item.ContainerId != itemCont.Id || item.ContainerStack != any() ||
                    itemCount > item.Count) {
                    SendContainerSnapshot(cr, transferType, itemCont, crCont);
                    return;
                }

                items = {item};
            }
            else {
                items = itemCont.GetItems(Tla::RootContainerStack());
            }
        }
        else {
            verify(crCont != null, "Critter container must be resolved", cr);
            Critter critterContainer = crCont;
            if (!all) {
                Item? item = critterContainer.GetItem(itemId);
                if (item == null || item.Ownership != ItemOwnership::CritterInventory || item.CritterId != critterContainer.Id ||
                    item.CritterSlot != CritterItemSlot::Inventory || itemCount > item.Count) {
                    SendContainerSnapshot(cr, transferType, itemCont, crCont);
                    return;
                }

                items = {item};
            }
            else {
                items = critterContainer.GetItems(ItemProperty::CritterSlot, CritterItemSlot::Inventory);
            }
        }
    }
    else if (!all) {
        Item? item = cr.GetItem(itemId);
        if (item == null || item.CritterSlot != CritterItemSlot::Inventory || itemCount > item.Count ||
            (itemCont != null && IsContainerSelfMove(item.Id, itemCont.Id))) {
            SendContainerSnapshot(cr, transferType, itemCont, crCont);
            return;
        }

        items = {item};
    }
    else {
        items = cr.GetItems(ItemProperty::CritterSlot, CritterItemSlot::Inventory);
        if (itemCont != null) {
            for (int i = 0; i < items.length(); i++) {
                if (IsContainerSelfMove(items[i].Id, itemCont.Id)) {
                    items.removeAt(i);
                    break;
                }
            }
        }
    }

    if (take) {
        FilterContainerItems(items, transferType);
    }
    if (items.isEmpty()) {
        SendContainerSnapshot(cr, transferType, itemCont, crCont);
        return;
    }

    if (!take && itemCont != null) {
        for (int i = 0; i < items.length(); i++) {
            if (WouldCreateContainerCycle(items[i], itemCont)) {
                SendContainerSnapshot(cr, transferType, itemCont, crCont);
                return;
            }
        }
        if (!CanPutItemsInContainer(itemCont, items, all, itemCount)) {
            Messaging::Info(cr, TextPackKey(TextPackName::Game, "" + (MsgStr::StrOvervolume)));
            SendContainerSnapshot(cr, transferType, itemCont, crCont);
            return;
        }
    }

    // Проверка перевеса у приёмника. Считаем в int64 с насыщением выше любого
    // возможного CarryWeight, чтобы большой стек не обошёл проверку через int32 wrap.
    const int64 maxCheckedWeight = 2147483647;
    int64 weight = 0;
    for (int i = 0; i < items.length(); i++) {
        int moveCount = all ? items[i].Count : itemCount;
        int64 unitWeight = items[i].Weight;
        if (moveCount <= 0 || unitWeight < 0 || unitWeight > (maxCheckedWeight - weight) / moveCount) {
            weight = maxCheckedWeight + 1;
            break;
        }
        weight += unitWeight * moveCount;
    }

    Critter? weightTarget;
    if (itemCont == null) {
        weightTarget = take ? cr : crCont;
    }
    else if (take && transferType != TransferTypes::SelfCont) {
        // Перекладка из собственного вложенного контейнера не меняет общий вес инвентаря.
        weightTarget = cr;
    }
    if (weightTarget != null) {
        int64 targetWeight = Parameters::CritterGetItemsWeightLimited(weightTarget, int64(weightTarget.CarryWeight));
        if (targetWeight > weightTarget.CarryWeight || weight > int64(weightTarget.CarryWeight) - targetWeight) {
            Messaging::Info(cr, TextPackKey(TextPackName::Game, "" + (take ? MsgStr::StrOverweight : MsgStr::StrOvervolume)));
            SendContainerSnapshot(cr, transferType, itemCont, crCont);
            return;
        }
    }

    // AP списываются authoritative на сервере. Клиент повторяет списание только для плавного UI.
    if (!ProcessAp(cr, Settings.Movement.RtApCostMoveItemContainer)) {
        SendContainerSnapshot(cr, transferType, itemCont, crCont);
        return;
    }

    cr.Action(CritterAction::OperateContainer, EncodeContainerActionExt(transferType, take, all), !all ? items[0] : null);

    if (transferType == TransferTypes::CritSteal) {
        verify(crCont != null, "Steal target must be resolved", cr);
        Critter stealContainer = crCont;
        EventResult stealResult = Game.OnCritterStealing.Fire(stealContainer, cr, items[0], itemCount);
        if (!IsActiveContainerTransfer(cr, transferType, transferContainerId, transferSession)) {
            return;
        }
        if (stealResult == EventResult::ContinueChain) {
            ItemMovement::MoveItem(items[0], itemCount, take ? cr : stealContainer);
        }
        else {
            CloseContainerTransfer(cr);
            return;
        }
    }
    else if (take) {
        if (!all) {
            ItemMovement::MoveItem(items[0], itemCount, cr);
        }
        else {
            ItemMovement::MoveItems(items, cr);
        }
    }
    else if (itemCont != null) {
        if (!all) {
            ItemMovement::MoveItem(items[0], itemCount, itemCont, Tla::RootContainerStack());
        }
        else {
            ItemMovement::MoveItems(items, itemCont, Tla::RootContainerStack());
        }
    }
    else {
        verify(crCont != null, "Critter container must be resolved", cr);
        if (!all) {
            ItemMovement::MoveItem(items[0], itemCount, crCont);
        }
        else {
            ItemMovement::MoveItems(items, crCont);
        }
    }

    if (!IsActiveContainerTransfer(cr, transferType, transferContainerId, transferSession)) {
        return;
    }

    Entity cont = itemCont != null ? cast<Entity>(itemCont) : cast<Entity>(crCont);
    for (int i = 0; i < items.length(); i++) {
        (Game.OnClientOperateContainer.Fire(cr, cont, items[i], take) == EventResult::ContinueChain);
    }

    SendContainerSnapshot(cr, transferType, itemCont, crCont);
}

// Перезарядка оружия. Если новый патрон не совпадает с заряженным (или патрон не указан) —
// сначала выгружает текущий боезапас обратно в инвентарь, затем досыпает новый до максимума.
void ReloadWeapon(Critter cr, ident weaponId, ident ammoId)
{
    if (!cr.IsAlive()) {
        throw("Client is not alive", cr);
    }

    // Берём оружие
    Item? weapon = cr.GetItem(weaponId);
    if (weapon == null) {
        throw("Unable to find weapon", cr, weaponId);
    }

    if (weapon.Type != ItemType::Weapon) {
        throw("Invalid type of weapon", cr, weapon);
    }

    if (weapon.Weapon_Caliber == 0) {
        throw("Weapon doesn't have caliber", cr, weapon);
    }

    if (weapon.Weapon_MaxAmmoCount == 0) {
        throw("Weapon doesn't have ammo holder", cr, weapon);
    }

    // Списываем AP
    int ap = Settings.Movement.RtApCostReloadWeapon;
    if (!ProcessAp(cr, ap)) {
        return;
    }

    // Берём патроны
    Item? ammo = (ammoId != ZERO_IDENT ? cr.GetItem(ammoId) : null);
    if (ammoId != ZERO_IDENT && ammo == null) {
        throw("Ammo not found", cr, weapon, ammoId);
    }

    if (ammo != null && weapon.AmmoPid == ammo.ProtoId && weapon.AmmoCount >= weapon.Weapon_MaxAmmoCount) {
        throw("Weapon is full", cr, weapon, ammo);
    }

    // Выгрузка текущего боезапаса. Только при ненулевом остатке: AddItem с нулём бросает
    // исключение "Count arg must be positive" на уже пустом оружии
    if (ammo == null || (weapon.AmmoCount > 0 && weapon.AmmoPid != ammo.ProtoId)) {
        if (weapon.AmmoPid != EMPTY_HSTRING && weapon.AmmoCount > 0) {
            Item? existAmmo = cr.GetItem(weapon.AmmoPid);
            if (existAmmo == null) {
                cr.AddItem(weapon.AmmoPid, weapon.AmmoCount);
            }
            else {
                existAmmo.Count += weapon.AmmoCount;
            }
        }

        weapon.AmmoCount = 0;
    }

    // Загрузка нового боезапаса
    if (ammo != null) {
        int count = Math::Min(ammo.Count, weapon.Weapon_MaxAmmoCount - weapon.AmmoCount);
        weapon.AmmoCount += count;
        weapon.AmmoPid = ammo.ProtoId;

        if (ammo.Count > count) {
            ammo.Count -= count;
        }
        else {
            Game.DestroyItem(ammo);
        }
    }

    cr.Action(CritterAction::ReloadWeapon, 0, weapon);
}

// Атака цели оружием. mode упаковывает режим использования (младшие 4 бита) и зону прицеливания
// (старшие биты). Проверяет руки/двуручность, прицел, дистанцию и трассу до цели, наличие патрона,
// взводит таймаут агрессора и передаёт удар в Combat::CombatAttack.
void Attack(Critter cr, ident targetId, int mode)
{
    Critter? target = Game.GetCritter(targetId);

    // Распаковываем режим использования и зону прицеливания из mode
    int use = mode & 0xF;
    int aim = (mode >> 4) & 0xF;

    // mode приходит от клиента: без проверки диапазона зона прицела 10..15 давала бесплатный
    // прицельный выстрел (нулевой AP/штраф) и уводила чтение таблицы критов в чужие строки
    if (aim < HitLocations::LocationNone || aim > HitLocations::LocationUncalled) {
        throw("Invalid aim location", cr, mode, aim);
    }

    AbstractItem weapon = CritterItem::GetActive(cr);
    if (weapon.Type != ItemType::Weapon) {
        throw("Critter item is not weapon", cr, weapon);
    }

    if (weapon.Weapon_IsTwoHanded && (cr.IsDamagedLeftArm || cr.IsDamagedRightArm)) {
        throw("Critter is damaged arm for two handed weapon", cr, weapon);
    }

    if (cast<Item?>(weapon) == null && cr.IsDamagedLeftArm && cr.IsDamagedRightArm) {
        throw("Critter is damaged two arms for armed attack", cr, weapon);
    }

    if (weapon.Weapon_ActiveUses <= use) {
        throw("Weapon use is not allowed", cr, weapon, use);
    }

    if (aim != HitLocations::LocationNone) {
        if (cr.IsNoAim) {
            throw("Critter try aim when mode IsNoAim", cr, weapon, aim);
        }

        if (!WeaponHelpers::WeaponAim(weapon, use)) {
            throw("Critter try aim when weapon no aim for use", cr, weapon, aim, use);
        }
    }

    // Списываем AP
    int ap = Parameters::GetItemUseApCost(cr, weapon, mode);
    if (!ProcessAp(cr, ap)) {
        return;
    }

    if (target != null && cr.Id == target.Id) {
        throw("Critter tried attack himself", cr);
    }

    Map? map = cr.GetMap();
    if (map == null) {
        throw("Critter on global map", cr);
    }

    if (target != null) {
        if (!cr.IsSee(target)) {
            throw("Critter don't sees target", cr, target);
        }

        if (target.IsDead()) {
            throw("Target critter is dead", cr, target);
        }
    }
    else {
        // TODO: атака по гексу
        throw("Target == null for critter", cr);
    }

    Critter attackTarget = target;
    mpos targetHex = attackTarget.Hex;
    mpos hex = cr.Hex;

    int maxDist = Parameters::GetCritterAttackDistance(cr, weapon, mode);
    if (maxDist == 0) {
        throw("Invalid weapon range", cr, weapon, use, targetHex.x, targetHex.y);
    }

    int dist = Game.GetDistance(hex, targetHex);
    if (dist - attackTarget.Multihex > maxDist) {
        throw("Target too far", cr, weapon, use, targetHex.x, targetHex.y);
    }

    mpos tracedHex = targetHex;
    map.GetHexInPath(hex, tracedHex, 0.0f, dist);
    if (targetHex != tracedHex) {
        throw("Target blocked", cr, weapon, use, targetHex.x, targetHex.y);
    }

    // Патрон: берём заряженный, иначе дефолтный из прото оружия
    ProtoItem? ammo = null;

    if (weapon.Weapon_Caliber != 0 && weapon.Weapon_MaxAmmoCount > 0) {
        if (Game.CheckProtoItem(weapon.AmmoPid)) {
            ammo = Game.GetProtoItem(weapon.AmmoPid);
        }
        else if (Game.CheckProtoItem(weapon.Weapon_DefaultAmmoPid)) {
            ammo = Game.GetProtoItem(weapon.Weapon_DefaultAmmoPid);
        }

        if (ammo == null) {
            throw("Weapon ammo not found", cr, weapon);
        }

        if (ammo.Type != ItemType::Ammo) {
            throw("Weapon ammo item isn't have ammo type", cr, weapon, ammo);
        }

        if (!cr.IsUnlimitedAmmo && weapon.AmmoCount == 0) {
            throw("Weapon ammo count is zero", cr, weapon, ammo);
        }
    }

    // Помечаем криттера агрессором и проводим удар
    cr.TimeoutAggressor = Game.SynchronizedTime + Time::Minutes(1);
    Combat::CombatAttack(cr, attackTarget, weapon, mode, ammo);
}

bool HasSingleUseItemTarget(bool hasCritterTarget, bool hasItemTarget, bool hasSceneryTarget)
{
    return (hasCritterTarget ? 1 : 0) + (hasItemTarget ? 1 : 0) + (hasSceneryTarget ? 1 : 0) == 1;
}

bool IsUseItemCapabilityAllowed(bool selfTarget, bool isCanUse, bool isCanUseOnSmth)
{
    return selfTarget ? isCanUse : isCanUseOnSmth;
}

// Применение предмета на цель: криттера, предмет на карте или сценерий. Используемый предмет
// обязан принадлежать криттеру, target mode должен быть единственным, а capability повторно
// проверяется на сервере независимо от того, что показал клиентский UI.
void UseItemOn(Critter cr, ident usedItemId, ident targetCrId, ident targetItemId, hstring sceneryPid, int hx, int hy, int timer)
{
    if (!cr.IsAlive()) {
        throw("Client is not alive", cr);
    }

    if (usedItemId == ZERO_IDENT) {
        return;
    }

    bool hasCritterTarget = targetCrId != ZERO_IDENT;
    bool hasItemTarget = targetItemId != ZERO_IDENT;
    bool hasSceneryTarget = sceneryPid != EMPTY_HSTRING;
    if (!HasSingleUseItemTarget(hasCritterTarget, hasItemTarget, hasSceneryTarget)) {
        return;
    }

    Item? usedItem = cr.GetItem(usedItemId);
    if (usedItem == null) {
        return;
    }

    bool selfTarget = hasCritterTarget && IsSelfUseTarget(cr.Id, targetCrId);
    if (!IsUseItemCapabilityAllowed(selfTarget, usedItem.IsCanUse, usedItem.IsCanUseOnSmth)) {
        return;
    }

    if (!IsUseItemTimerAllowed(Parameters::IsTimedUseItem(usedItem), selfTarget, timer)) {
        return;
    }

    int ap = Settings.Movement.RtApCostUseItem;
    if (!ProcessAp(cr, ap)) {
        return;
    }

    Critter? targetCr;
    Item? targetItem;
    StaticItem? targetScen;
    int useDist = 1 + cr.Multihex;

    if (targetCrId != ZERO_IDENT) {
        if (cr.Id != targetCrId) {
            if (cr.GetMap() != null) {
                targetCr = Game.GetCritter(targetCrId);
                if (targetCr == null) {
                    throw("Target critter not found", cr, targetCrId);
                }

                if (!cr.IsSee(targetCr)) {
                    throw("Critter doesn't see target critter", cr, targetCr);
                }

                if (Game.GetDistance(cr.Hex, targetCr.Hex) > useDist + targetCr.Multihex) {
                    throw("Target critter too far", cr, targetCr);
                }
            }
            else {
                // нужна реализация
                throw("Target critter not found in global group", cr, targetCrId);
            }
        }
        // Self-use в контракте OnCritterUseItemOn представлен пустыми target handles.
        // selfTarget уже вычислен выше для capability/timer-проверок.
    }
    else if (targetItemId != ZERO_IDENT || sceneryPid != EMPTY_HSTRING) {
        Map? map = cr.GetMap();
        if (map == null) {
            throw("Critter on global map", cr);
        }

        if (sceneryPid == EMPTY_HSTRING) {
            targetItem = map.GetItem(targetItemId);
            if (targetItem == null) {
                throw("Target item not found on map", cr, map, targetItemId);
            }

            if (targetItem.Hidden) {
                throw("Target item is hidden", cr, map, targetItem);
            }

            if (Game.GetDistance(cr.Hex, targetItem.Hex) > useDist) {
                throw("Target item too far", cr, targetItem);
            }
        }
        else {
            if (!Game.CheckProtoItem(sceneryPid)) {
                throw("Proto item not found", cr, sceneryPid);
            }

            ProtoItem proto = Game.GetProtoItem(sceneryPid);

            if (Game.GetDistance(cr.Hex, mpos(hx, hy)) > useDist) {
                throw("Target scenery too far", cr, hx, hy, sceneryPid);
            }

            targetScen = map.GetStaticItemOnHex(mpos(hx, hy), sceneryPid);
            if (targetScen == null) {
                throw("Scenery not found", cr, hx, hy, sceneryPid);
            }
        }
    }

    // Запускаем действие
    cr.Action(CritterAction::UseItem, 0, null);
    (Game.OnCritterUseItemOn.Fire(cr, usedItem, targetCr, targetItem, targetScen, timer) == EventResult::ContinueChain);
}

#endif

}
