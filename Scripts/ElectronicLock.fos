// ElectronicLock — электронный кодовый замок предметов.
// Обязанности: генерация кода доступа, перехват скилла вскрытия, запрос кода через экран Say, проверка кода и открытие двери/контейнера с авто-закрытием.
// Сторона: SERVER. Связи: Say, Lockers, Messaging, Item::AutoCloseDoor.
namespace ElectronicLock
{

#if SERVER

// Свойства предмета: какой замок последним вскрывал криттер, время авто-закрытия и сам код доступа
///@ Property Critter Server ident LastElectronicLocked Mutable Persistent

///@ Property Item Server int32 ELockCloseAtSeconds Mutable Persistent // Время автоматического закрытия контейнера или двери
///@ Property Item Server string ELockCode Mutable Persistent

const int STR_HEADER = 403; // Система авторизации. Введите код доступа.
const int STR_OPEN = 410;   // Доступ подтвержден. Замок открыт.
const int STR_ERROR = 411;  // Ошибка. Неправильный код доступа.

// Алфавит символов кода: только однозначно различимые буквы/цифры, чтобы код было удобно вводить
const string[] CodeChars = {"Q", "S", "Y", "W", "F", "Z", "1", "2", "3", "4", "5", "6", "7", "8", "9", "R", "U", "L", "N"};

// Генерирует и сохраняет в предмете новый случайный код доступа фиксированной длины
void GenerateCode(Item item)
{
    string code = "";
    for (int i = 0; i < 5; i++) {
        code += CodeChars[Game.Random(0, (CodeChars.length() - 1))];
    }

    item.ELockCode = code;
}

string GetCode(Item item)
{
    return item.ELockCode;
}

void ClearCode(Item item)
{
    item.ELockCode = "";
}

// Init-скрипт прото замка: подписывает перехват скилла и выдаёт предмету стартовый код
void LockedInit(Item item, bool firstTime)
{
    item.OnCritterUseSkill.Subscribe(LockedSkill);
    GenerateCode(item);
}

// Перехват скилла вскрытия на запертом замке: если контейнер/дверь ещё не открыты — вместо
// обычного вскрытия запрашиваем код доступа через экран Say
[[Event]]
EventResult LockedSkill(Item item, Critter cr, CritterProperty skill)
{
    if (skill == CritterProperty::SpecialSkillPickOnGround && item.ELockCode.length() > 0) {
        if ((item.Type == ItemType::Container || item.Type == ItemType::Door) && item.Opened) {
            return EventResult::StopChain;
        }

        Say::Show(cr, TextPackKey(TextPackName::Text, "" + STR_HEADER), TextPackKey(), LockedSkillAnswer, {item.Id});
        CritterState::Wait(cr, 1000);

        return EventResult::StopChain;
    }

    return EventResult::StopChain;
}

// Обработчик введённого игроком кода: при совпадении открывает замок и при необходимости
// планирует авто-закрытие; иначе сообщает об ошибке
void LockedSkillAnswer(Critter player, string answerS, any[] context)
{
    ident itemId = context[0];
    Item? item = Game.GetItem(itemId);
    if (item == null || item.Ownership != ItemOwnership::MapHex || item.MapId != player.MapId ||
        Game.GetDistance(player.Hex, item.Hex) > Settings.Dialog.TalkDistance || item.ELockCode.length() == 0 ||
        (item.Type != ItemType::Container && item.Type != ItemType::Door)) {
        return;
    }

    // Код верный: открываем замок, показываем содержимое и при заданном таймауте ставим авто-закрытие
    if (GetCode(item) == answerS) {
        Messaging::Info(player, TextPackKey(TextPackName::Text, "" + (STR_OPEN)));
        Lockers::SwitchLocker(item, true);
        Lockers::ShowContainer(player, null, item, TransferTypes::HexContUp);

        if (item.ELockCloseAtSeconds > 0) {
            // отложенный вызов сохраняется в сейве (SavedDeferredCall) — закроется даже после рестарта
            Game.StartTimeEvent(Time::Seconds(item.ELockCloseAtSeconds), Item::AutoCloseDoor, item.Id);
        }
    }
    else {
        Messaging::Info(player, TextPackKey(TextPackName::Text, "" + (STR_ERROR)));
    }
}

#endif

}
