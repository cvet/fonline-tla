//       "OnLMouseClick":
{
    {
        {
            string inputText = ::GuiScreensExt::NeedText(::GuiScreensExt::NeedScreen(Screen).FindText("MainSayText")).Text;
            if (!cast<Say>(::GuiScreensExt::NeedObject(Parent)).DontShowMessage) {
                ::Messaging::Info(inputText);
            }
            //Game.CustomCall( "ScreenSay_" + inputText );
            if (!HasChosen) {
                Gui::HideScreen();
                return;
            }
            Say screen = cast<Say>(::GuiScreensExt::NeedObject(Parent));
            if (screen.RequestId != 0) {
                CurPlayer.ServerCall.AnswerSayRequest(screen.RequestId, inputText, false);
                screen.RequestId = 0;
            }
            else {
                ::Say::ProcessSay(inputText, screen.SayRevision);
            }
            Gui::HideScreen();
        }
    }
}
