// ItemKinds — категории предметов поверх компонентов свойств и флагов Engine; заменяют диапазоны прежнего енума вида предмета.
// Обязанности: переносимые товары, прочее (Misc), объекты сценерии (Generic и Grid) и чистая сценерия (Generic).
// Нестатичный предмет без маркера вида считается прочим (Misc). Сторона: COMMON (без #if).
// Связи: компоненты Armor, Drug, Weapon, Ammo, Key, Container, Door, Grid, Car (ItemProps, Lockers); Engine Static, IsWall, IsTile.
namespace ItemKinds
{

// Переносимый товар (бывший диапазон Armor..Key): нестатичный предмет, не контейнер, не дверь и не транспорт
bool IsPortableGoods(AbstractItem item)
{
    return !item.Static && !item.HasContainer && !item.HasDoor && !item.HasCar;
}

// Прочее (бывший Misc): переносимый товар без компонентов Armor, Drug, Weapon, Ammo и Key
bool IsMisc(AbstractItem item)
{
    return IsPortableGoods(item) && !item.HasArmor && !item.HasDrug && !item.HasWeapon && !item.HasAmmo && !item.HasKey;
}

// Объект сценерии (бывшие Generic и Grid): статичный предмет, не стена и не тайл
bool IsSceneryObject(AbstractItem item)
{
    return item.Static && !item.IsWall && !item.IsTile;
}

// Чистая сценерия (бывший Generic): объект сценерии без компонента Grid
bool IsGenericScenery(AbstractItem item)
{
    return IsSceneryObject(item) && !item.HasGrid;
}

}
