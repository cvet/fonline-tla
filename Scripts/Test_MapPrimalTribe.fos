// Test_MapPrimalTribe — регрессии итоговых стадий квеста Сулика после набега на племя.
// Проверяет чистую механику выбора провала независимо от async-обхода живых игроков.
namespace Test_MapPrimalTribe
{

#if SERVER

[[ModuleInit]]
void InitTestMapPrimalTribe()
{
    Game.OnTestingInit.Subscribe(OnTestingInit);
}

[[Event]]
void OnTestingInit()
{
    Testing::RegisterTest("map_primal_tribe", "quest_failure_stages", QuestFailureStages);
}

void QuestFailureStages(Testing::TestContext ctx)
{
    Testing::ExpectEq(ctx,
                      MapPrimalTribe::ResolveQuestFailureStat(false, 0, true, false),
                      MapPrimalTribe::QUEST_STAT_FAIL_RUNAWAY,
                      "Ушедший с карты участник без сюжетной развилки должен считаться сбежавшим");
    Testing::ExpectEq(ctx,
                      MapPrimalTribe::ResolveQuestFailureStat(false, 1, true, false),
                      MapPrimalTribe::QUEST_STAT_FAIL_NOT_START,
                      "Участник сюжетной развилки, не пришедший к началу, должен получить отдельный провал");
    Testing::ExpectEq(ctx,
                      MapPrimalTribe::ResolveQuestFailureStat(false, 1, false, true),
                      MapPrimalTribe::QUEST_STAT_FAIL_RUNAWAY,
                      "Участник сюжетной развилки, ушедший после начала, должен считаться сбежавшим");
    Testing::ExpectEq(ctx,
                      MapPrimalTribe::ResolveQuestFailureStat(true, 0, false, true),
                      MapPrimalTribe::QUEST_STAT_FAIL_TRIBE_IS_DEAD,
                      "Оставшийся на карте игрок должен получить провал гибели племени");
    Testing::ExpectEq(ctx,
                      MapPrimalTribe::ResolveQuestFailureStat(true, 0, false, false),
                      MapPrimalTribe::QUEST_STAT_FAIL_NO_HELP,
                      "Оставшийся на карте игрок без гибели племени должен получить провал бездействия");
}

#endif

}
