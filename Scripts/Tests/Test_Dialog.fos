// Test_Dialog — тесты CheckSomeValue, через который проходит каждый числовой деманд диалогов.
// Закрепляют направление сравнения (проверяется actualValue относительно value, а не наоборот)
// и поведение при неизвестном операторе.
namespace Test_Dialog
{

#if SERVER

[[ModuleInit]]
void InitTestDialog()
{
    Game.OnTestingInit.Subscribe(OnTestingInit);
}

[[Event]]
void OnTestingInit()
{
    Testing::RegisterTest("dialog", "demand_comparison_direction", DemandComparisonDirection);
    Testing::RegisterTest("dialog", "demand_boundary_values", DemandBoundaryValues);
    Testing::RegisterTest("dialog", "demand_unknown_operator_fails_closed", DemandUnknownOperatorFailsClosed);
}

// Сравнивается actualValue ОТНОСИТЕЛЬНО value: CheckSomeValue(">", 5, 7) читается как «7 больше 5».
// Перепутанный порядок — самая тихая поломка деманда: квест просто перестаёт открываться.
void DemandComparisonDirection(Testing::TestContext ctx)
{
    if (!Testing::Expect(ctx, Dialog::CheckSomeValue(">".hstr(), 5, 7), "7 больше 5")) {
        return;
    }

    if (!Testing::Expect(ctx, !Dialog::CheckSomeValue(">".hstr(), 7, 5), "5 не больше 7")) {
        return;
    }

    if (!Testing::Expect(ctx, Dialog::CheckSomeValue("<".hstr(), 7, 5), "5 меньше 7")) {
        return;
    }

    Testing::Expect(ctx, !Dialog::CheckSomeValue("<".hstr(), 5, 7), "7 не меньше 5");
}

// Границы: строгие сравнения не срабатывают на равенстве, "=" и "!" взаимно исключают друг друга.
void DemandBoundaryValues(Testing::TestContext ctx)
{
    if (!Testing::Expect(ctx, !Dialog::CheckSomeValue(">".hstr(), 5, 5), "Равные значения не проходят строгое больше")) {
        return;
    }

    if (!Testing::Expect(ctx, !Dialog::CheckSomeValue("<".hstr(), 5, 5), "Равные значения не проходят строгое меньше")) {
        return;
    }

    if (!Testing::Expect(ctx, Dialog::CheckSomeValue("=".hstr(), 5, 5), "Равные значения проходят равенство")) {
        return;
    }

    if (!Testing::Expect(ctx, !Dialog::CheckSomeValue("!".hstr(), 5, 5), "Равные значения не проходят неравенство")) {
        return;
    }

    if (!Testing::Expect(ctx, Dialog::CheckSomeValue("!".hstr(), 5, 6), "Разные значения проходят неравенство")) {
        return;
    }

    // Отрицательные значения свойств встречаются (карма, репутация)
    if (!Testing::Expect(ctx, Dialog::CheckSomeValue(">".hstr(), -10, -5), "-5 больше -10")) {
        return;
    }

    Testing::Expect(ctx, Dialog::CheckSomeValue("<".hstr(), 0, -1), "-1 меньше нуля");
}

// Неизвестный оператор закрывает деманд, а не открывает: опечатка в диалоге прячет ветку,
// но не выдаёт награду мимо условия.
void DemandUnknownOperatorFailsClosed(Testing::TestContext ctx)
{
    if (!Testing::Expect(ctx, !Dialog::CheckSomeValue(">=".hstr(), 5, 7), "Составной оператор не поддерживается и закрывает деманд")) {
        return;
    }

    if (!Testing::Expect(ctx, !Dialog::CheckSomeValue("==".hstr(), 5, 5), "Двойное равенство не поддерживается и закрывает деманд")) {
        return;
    }

    Testing::Expect(ctx, !Dialog::CheckSomeValue(EMPTY_HSTRING, 5, 5), "Пустой оператор закрывает деманд");
}

#endif

}
