// Test_ClientItems — тесты общих инвариантов клиентских коллекций предметов.
namespace Test_ClientItems
{

#if SERVER

[[ModuleInit]]
void InitTestClientItems()
{
    Game.OnTestingInit.Subscribe(OnTestingInit);
}

[[Event]]
void OnTestingInit()
{
    Testing::RegisterTest("client_items", "split_count_bounds", SplitCountBounds);
    Testing::RegisterTest("client_items", "use_collection_accepts_only_target_items", UseCollectionAcceptsOnlyTargetItems);
}

void SplitCountBounds(Testing::TestContext ctx)
{
    if (!Testing::ExpectEq(ctx, ClientItems::NormalizeSplitCount(0, 20), 1, "Нулевой count должен стать единицей")) {
        return;
    }
    if (!Testing::ExpectEq(ctx, ClientItems::NormalizeSplitCount(-5, 20), 1, "Отрицательный count должен стать единицей")) {
        return;
    }
    if (!Testing::ExpectEq(ctx, ClientItems::NormalizeSplitCount(25, 20), 20, "Count не должен превышать размер стека")) {
        return;
    }
    if (!Testing::ExpectEq(ctx, ClientItems::NormalizeSplitCount(120000, 120000), 99999, "Окно Split ограничено пятью цифрами")) {
        return;
    }

    Testing::ExpectEq(ctx, ClientItems::NormalizeSplitCount(7, 20), 7, "Допустимый count должен сохраняться");
}

void UseCollectionAcceptsOnlyTargetItems(Testing::TestContext ctx)
{
    ProtoItem stimpak = Game.GetProtoItem(Content::Item::stimpak);
    if (!Testing::Expect(ctx, ClientItems::IsUsableOnTarget(stimpak), "Стимулятор должен быть доступен для применения к цели")) {
        return;
    }

    ProtoItem radio = Game.GetProtoItem(Content::Item::radio);
    if (!Testing::Expect(ctx, radio.IsCanUse, "Рация должна оставаться применяемой на себя")) {
        return;
    }
    if (!Testing::Expect(ctx, !ClientItems::IsUsableOnTarget(radio), "Предмет только для применения на себя не должен попадать в ITEMS_USE")) {
        return;
    }

    ProtoItem caps = Game.GetProtoItem(Content::Item::bottle_caps);
    Testing::Expect(ctx, !ClientItems::IsUsableOnTarget(caps), "Обычный предмет не должен попадать в ITEMS_USE");
}

#endif

}
