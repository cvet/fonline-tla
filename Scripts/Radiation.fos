// Radiation — серверная система облучения по образцу Fallout 2: накопление рем, стадии лучевой болезни и их эффекты.
// Начисляет дозу с учётом сопротивления радиации, ведёт RadiationLevel/IsRadiated и по достижении порогов запускает
// таймерное событие Radiation, которое временно снижает статы/HP по таблице стадий, а при смертельной дозе убивает.
// Только SERVER (#if SERVER); AffectRadiation/DropRadiation вызывают внешние механики урона и окружения.

namespace Radiation
{

#if SERVER

// Оригинальная система радиации из Fallout 2

const int RADIATION_STAGES = 6;
const int RADIATION_STATS = 8;
const int RADIATION_DURATION =
    10080 * 60; // 10080 игровых минут (неделя) в игровых секундах; при миграции потеряли множитель *60 → стадии спадали в ~60 раз быстрее
const int RADIATION_DAMAGE_VALUE = 66;
const int RADIATION_HIGH_DOSE = 66;
const int RADIATION_DEAD_DOSE = 1800;

int RadiationStageTextId(int stage)
{
    return 12799 + (stage);
}
const int STR_RADIATION_DIE = 12806;
const int STR_RADIATION_HIGH_DOSE = 12807;

// clang-format off

const int[] RadiationEffects =
{
    1,  100,  200,  400,  600, 1000,                                                                 /*пороги стадий*/
    CritterProperty::Strength,    CritterProperty::StrengthBase,    0,    0,    0,    2,    4,    6, /*величины изменения статов по стадиям*/
    CritterProperty::Perception,  CritterProperty::PerceptionBase,  0,    0,    1,    0,    3,    5,
    CritterProperty::Endurance,   CritterProperty::EnduranceBase,   0,    0,    0,    1,    3,    5,
    CritterProperty::Charisma,    CritterProperty::CharismaBase,    0,    0,    0,    0,    3,    5,
    CritterProperty::Intellect,   CritterProperty::IntellectBase,   0,    0,    0,    0,    1,    3,
    CritterProperty::Agility,     CritterProperty::AgilityBase,     0,    0,    1,    2,    5,    6,
    CritterProperty::CurrentHp,   CritterProperty::CurrentHp,       0,    1,    3,    5,   15,   20,
    CritterProperty::HealingRate, CritterProperty::HealingRateBase, 0,    0,    0,    5,   10,   10,
};

// clang-format on

// Смещения внутри таблицы RadiationEffects
int RadiationStageValue(int stage)
{
    return RadiationEffects[(stage)-1];
}
CritterProperty RadiationStatReadIndex(int stat)
{
    return CritterProperty(RadiationEffects[6 + (stat) * 8]);
}
CritterProperty RadiationStatWriteIndex(int stat)
{
    return CritterProperty(RadiationEffects[6 + (stat) * 8 + 1]);
}
int RadiationStatAmount(int stat, int stage)
{
    return RadiationEffects[6 + (stat) * 8 + (stage)];
}

void AffectRadiation(Critter cr, int value)
{
    if (cr.IsDead()) {
        return;
    }

    if (cr.BodyType == BodyTypes::Robot || cr.BodyType == BodyTypes::Alien) {
        return;
    }

    bool isActive = cr.CountTimeEvent(Radiation) != 0;
    int levelVal = cr.RadiationLevel;
    int resistVal = cr.DamageResistance[DamageTypes::Radiation];

    if (value >= 0) {
        value -= value * resistVal / 100;
    }

    cr.RadiationLevel = Math::Clamp(levelVal + value, 0, 2000);
    levelVal = cr.RadiationLevel;

    if (value > RADIATION_HIGH_DOSE) {
        Messaging::Info(cr, TextPackKey(TextPackName::Game, "" + (STR_RADIATION_HIGH_DOSE)));
    }

    if (levelVal >= RADIATION_DAMAGE_VALUE) {
        if (!cr.IsRadiated) {
            cr.IsRadiated = true;
        }
    }
    else {
        if (cr.IsRadiated) {
            cr.IsRadiated = false;
        }
    }

    if (isActive) // Событие уже идёт — обновляем стадию под новый уровень
    {
        /*int stage = rates[0];
        int newStage = GetRadiationStage(levelVal);
        if (stage != newStage) {
            cr.ChangeTimeEvent(indexes[0], 0, stage);
        }*/
        cr.SetTimeEventData(Radiation, {GetRadiationStage(levelVal)});
    }
    else // Событие ещё не запущено — стартуем с первой стадии
    {
        int stage1Val = RadiationStageValue(1);
        if (levelVal >= stage1Val) {
            cr.StartTimeEvent(ZERO_TIMESPAN, Radiation, {1});
        }
    }

    if (levelVal >= RADIATION_DEAD_DOSE) {
        CritterState::ToDead(cr, CritterActionAnim::DeadFused, null);
        Messaging::Info(cr, TextPackKey(TextPackName::Game, "" + (STR_RADIATION_DIE)));
    }
}

void DropRadiation(Critter cr)
{
    bool isActive = cr.CountTimeEvent(Radiation) != 0;
    if (isActive) {
        int stage = GetRadiationStage(cr.RadiationLevel);
        ChangeStage(cr, stage, false);
        cr.StopTimeEvent(Radiation);
    }

    cr.RadiationLevel = 0;
    if (cr.IsRadiated) {
        cr.IsRadiated = false;
    }
}

[[TimeEvent]] [[Async]]
void Radiation(Critter cr, TimeEventContext event)
{
    if (!Sync::LockCritterWithMap(cr)) {
        return;
    }

    any rate = event.GetData();
    if (cr.IsDead()) {
        timespan delayTicks = Time::Minutes(5);
        if (delayTicks != ZERO_TIMESPAN) {
            event.Repeat(delayTicks);
        }

        return;
    }

    int stage = rate;
    int newStage = GetRadiationStage(cr.RadiationLevel);
    int duration = RADIATION_DURATION;

    if (stage != newStage) // Стадия сменилась — снимаем старые эффекты и накладываем новые
    {
        ChangeStage(cr, stage, false);
        ChangeStage(cr, newStage, true);
        cr.SetTimeEventData(Radiation, {newStage});
    }
    else // Уровень не изменился — снимаем эффекты стадии
    {
        ChangeStage(cr, stage, false);
        duration = 0;
    }

    timespan delayTicks = GameTime::GameSeconds(duration);
    if (delayTicks != ZERO_TIMESPAN) {
        event.Repeat(delayTicks);
    }
}

int GetRadiationStage(int level)
{
    for (int i = 0, j = RADIATION_STAGES; i <= j; i++) {
        int valMin = (i > 0 ? RadiationStageValue(i) : 0);
        int valMax = (i < j ? RadiationStageValue(i + 1) : level + 1);
        if (level >= valMin && level < valMax) {
            return i;
        }
    }

    return 0;
}

void ChangeStage(Critter cr, int stage, bool gain)
{
    if (stage == 0) {
        return;
    }

    if (gain) {
        Messaging::Info(cr, TextPackKey(TextPackName::Game, "" + (RadiationStageTextId(stage))));
    }

    for (int i = 0, j = RADIATION_STATS; i < j; i++) {
        CritterProperty statPropRead = RadiationStatReadIndex(i);
        CritterProperty statPropWrite = RadiationStatWriteIndex(i);
        int statAmount = RadiationStatAmount(i, stage);

        if (statAmount != 0) {
            int curVal = cr.GetAsInt(statPropRead);
            if (gain) // Наложение эффекта: временно ухудшаем стат
            {
                statAmount = -statAmount;
                if (statPropRead == CritterProperty::CurrentHp) {
                    cr.CurrentHp += statAmount;
                    if (cr.CurrentHp <= 0) {
                        CritterState::ToDead(cr, CritterActionAnim::DeadFused, null);
                    }
                }
                else {
                    cr.SetAsInt(statPropWrite, cr.GetAsInt(statPropWrite) + statAmount);
                }
            }
            else // Снятие эффекта: возвращаем стат к норме
            {
                if (statPropRead != CritterProperty::CurrentHp) {
                    cr.SetAsInt(statPropWrite, cr.GetAsInt(statPropWrite) + statAmount);
                }
            }
        }
    }
}

/*
   Радиация (справочная выжимка по механике Fallout 2, на которой построен модуль).
   Небольшая, но присутствующая в мире Fallout механика. Источники облучения — фрукты, золотые гекконы,
   а также пришельцы и кентавры в случайных встречах. При большой разовой дозе в окно сообщений выводится
   "You have received a large dose of radiation"; значок радиации появляется по достижении 66 рем.

   Урон от радиации работает так: через некоторое время после получения дозы криттер получает одно из
   сообщений ниже и может временно потерять очки статов, Healing Rate и текущие Hit Points. Тяжесть "удара"
   зависит от суммарного числа рем, а также от объёма недавней радиации, вызвавшей сообщение. Через 7 дней
   статы возвращаются к норме — что, слегка сбивая с толку, сигнализируется тем же сообщением, что и первое.
   Если за это время накопить ещё дозу, текущий штраф может смениться более тяжёлым.

   Возможные штрафы (значения рем приблизительные).
   Rem      Message                   HR   CHP  ST   PE   EN   CH   IN   AG
   >0       "very nauseous"
   >150     "slightly fatigued"             -1
   >300     "vomiting does not stop"   -3        -1              -1
   >450     "hair is falling out"  -5   -5   -2        -1        -2
   >600     "skin is falling off" -10   -15  -4   -3   -3   -3   -1   -5
   >1000    "intense agony"       -10   -20  -6   -5   -5   -5   -3   -6


   Криттер умирает, если любой из этих статов, кроме Healing Rate (включая CH), падает до 0 или ниже.
   Проверка выполняется только в момент понижения, поэтому препаратами можно успеть выжить. Если так не
   погибнуть, жить можно с любым числом рем и бегать вообще без штрафа. В обычной игре радиация не является
   значимым фактором: чтобы набрать даже 300 рем, пришлось бы нарезать круги по реакторному залу Гекко или
   намеренно торчать у свалки токсичных отходов. Насколько можно судить, перманентного урона от радиации нет.

   Ссылки на записи текст-пака Game (id -> английский текст):
   {12800}{}{You feel very nauseous.}
   {12801}{}{You feel very nauseous, and after some mild vomiting, slightly fatigued.}
   {12802}{}{You are very fatigued, the vomiting does not stop, and your recovery time is impaired.}
   {12803}{}{You are hemorrhaging violently. You are very sick, and your hair is falling out.}
   {12804}{}{You are hemorrhaging violently and continuously. The vomitus is stained red from your blood. Your skin is falling off of your bones.}
   {12805}{}{There is bleeding from your intestines and you have severe diarrhea. You feel bloated and are in intense agony.}
   {12806}{}{You have died from radiation sickness.}
   {12807}{}{You have received a large dose of radiation.}
   {12808}{}{The geiger counter is clicking.}
   {12809}{}{The geiger counter is clicking wildly.}
 */

#endif

}
