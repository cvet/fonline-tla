// Test_MoveCursor — тесты оценки цели курсора передвижения (MoveCursor::CanTarget): своя клетка и мёртвый
// персонаж недостижимы, непроходимый гекс недостижим, кроме клеток в пределах размера многогексового криттера.
namespace Test_MoveCursor
{

#if SERVER

[[ModuleInit]]
void InitTestMoveCursor()
{
    Game.OnTestingInit.Subscribe(OnTestingInit);
}

[[Event]]
void OnTestingInit()
{
    Testing::RegisterTest("move_cursor", "own_hex_and_dead_chosen_are_unreachable", OwnHexAndDeadChosenAreUnreachable);
    Testing::RegisterTest("move_cursor", "blocked_hex_is_reachable_only_within_multihex", BlockedHexIsReachableOnlyWithinMultihex);
}

void OwnHexAndDeadChosenAreUnreachable(Testing::TestContext ctx)
{
    if (!Testing::Expect(ctx, !MoveCursor::CanTarget(0, true, 0, true), "Своя клетка") ||
        !Testing::Expect(ctx, !MoveCursor::CanTarget(3, true, 0, false), "Мёртвый персонаж") ||
        !Testing::Expect(ctx, MoveCursor::CanTarget(3, true, 0, true), "Свободный гекс")) {
        return;
    }

    Testing::Pass(ctx);
}

void BlockedHexIsReachableOnlyWithinMultihex(Testing::TestContext ctx)
{
    if (!Testing::Expect(ctx, !MoveCursor::CanTarget(1, false, 0, true), "Непроходимый гекс рядом") ||
        !Testing::Expect(ctx, MoveCursor::CanTarget(2, false, 2, true), "Непроходимый гекс в пределах размера") ||
        !Testing::Expect(ctx, !MoveCursor::CanTarget(3, false, 2, true), "Непроходимый гекс за пределами размера")) {
        return;
    }

    Testing::Pass(ctx);
}

#endif

}
