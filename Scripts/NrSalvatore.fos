// NrSalvatore — серверная логика NPC Мэйсона, охраняющего проход к боссу Сальваторе (Нью-Рено).
// Мэйсон стоит непроходимым (IsNoPush) и по команде из диалога временно отходит в сторону
// случайным шагом (асинхронный TimeEvent), а при провокации переключается в план атаки на игрока.
// Только #if SERVER; функции вызываются из демо/результатов диалога Мэйсона (.fodlg).
namespace NrSalvatore
{

#if SERVER

const int CTE_MM = 12;

ident MaisonId;

// Мэйсон загораживает проход к Сальваторе. Может отойти только, если у игрока есть доступ
void MasonInit(Critter cr, bool firstTime)
{
    MaisonId = cr.Id;
    cr.IsNoPush = true;
}

// По реплике диалога Мэйсон отходит один раз: повторный запуск глушим, пока событие уже висит
void MoveMasonText(Critter cr, Critter? npc, string& text)
{
    if (npc != null && npc.CountTimeEvent(MoveMasonTimeEvent) == 0) {
        npc.StartTimeEvent(Time::Seconds(3), MoveMasonTimeEvent);
    }
}

[[TimeEvent]] [[Async]]
void MoveMasonTimeEvent(Critter cr)
{
    // Асинхронный обработчик обязан взять блокировку криттера с картой перед движением
    if (!Sync::LockCritterWithMap(cr)) {
        return;
    }

    MoveRandom::CritterMoveRandom(cr);
    return;
}

// Провокация из диалога: поднимаем Мэйсона (по сохранённому id) в атаку на игрока
void AttackMaison(Critter player, Critter npc, string& text)
{
    if (MaisonId != ZERO_IDENT) {
        Critter? cr = Game.GetCritter(MaisonId);
        if (cr != null) {
            NpcPlanes::AddAttackPlane(cr, 0, player);
        }
    }
}

#endif

}
