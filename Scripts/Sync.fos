// Sync — скриптовая обёртка над нативным примитивом блокировки Game.Sync(...) для async-кода воркеров.
// Весь модуль — только SERVER (#if SERVER). Хелперы Sync::Lock(...) добавляют поверх Game.Sync политику
// живучести: проверяют IsDestroyed до и после захвата и возвращают false для раннего выхода без обращения
// к мёртвым хэндлам. Snapshot/Restore сохраняют покрытие блокировок вокруг ре-энтрантной работы, а
// LockCritterWithMap[AndLocation] расширяют набор до карты/локации с повторами при миграции криттера,
// а перегрузка с fixedEntities сохраняет в том же покрытии дополнительные ведущие сущности.

namespace Sync
{

#if SERVER

// Game.Sync(...) — нативный примитив блокировки: он только захватывает локи, полностью заменяя набор
// блокировок SyncContext ровно перечисленными сущностями. Возврата у него нет: если ожидание лока
// прерывается остановкой сервера (после истечения окна дренажа Server.ShutdownGraceMs), он бросает
// EntityLockWaitAbortedException, которое здесь не ловится — исключение разворачивает async-задачу и
// останавливает её работу при завершении. Эти хелперы Sync::Lock(...) добавляют сверху политику живучести:
// проверяют IsDestroyed до и после захвата и возвращают `false`, чтобы вызывающий рано вышел, не трогая
// мёртвые хэндлы. Уничтоженная сущность не всегда фатальна — например, предполагаемая карта криттера может
// смениться, а старая быть уничтожена; тогда вызывающий перечитывает карту и блокирует заново, а не считает
// `false` жёсткой остановкой.
//
// Пустой ввод трактуется как «блокировать нечего» и возвращает `true`. Все точки вызова используют
// единый шаблон:
//
//     if (!Sync::Lock(npc, map)) return;
//     if (!Sync::Lock(npc, map, nearbyCritters)) return;

[[Async]]
bool Lock(Entity entity)
{
    if (entity.IsDestroyed) {
        return false;
    }

    Game.Sync(entity);

    return !entity.IsDestroyed;
}

[[Async]]
bool Lock(Entity firstEntity, Entity secondEntity)
{
    if (firstEntity.IsDestroyed || secondEntity.IsDestroyed) {
        return false;
    }

    Game.Sync(firstEntity, secondEntity);

    return !firstEntity.IsDestroyed && !secondEntity.IsDestroyed;
}

[[Async]]
bool Lock(Entity firstEntity, Entity secondEntity, Entity thirdEntity)
{
    if (firstEntity.IsDestroyed || secondEntity.IsDestroyed || thirdEntity.IsDestroyed) {
        return false;
    }

    Game.Sync(firstEntity, secondEntity, thirdEntity);

    return !firstEntity.IsDestroyed && !secondEntity.IsDestroyed && !thirdEntity.IsDestroyed;
}

[[Async]]
bool Lock(Entity[] entities)
{
    if (entities.isEmpty()) {
        return true;
    }

    for (int i = 0; i < entities.length(); i++) {
        if (entities[i].IsDestroyed) {
            return false;
        }
    }

    Game.Sync(entities);

    for (int i = 0; i < entities.length(); i++) {
        if (entities[i].IsDestroyed) {
            return false;
        }
    }

    return true;
}

// Снимок текущего покрытия блокировок (сущности, чьи локи удержаны), чтобы вызывающий мог
// запустить хелпер, который ЗАМЕНЯЕТ набор блокировок (Modifiers::FireCritterEvent, async-подхелперы, …), и
// затем восстановить ровно то же покрытие через Restore(). Это скриптовый аналог вложенного SyncContext
// движка на каждый колбэк: он сохраняет доступ вызывающего к нижележащим сущностям сквозь ре-энтрантную
// работу, которая внутри сама делает повторный Sync.
Entity[] Snapshot()
{
    return Game.GetHeldSyncEntities();
}

[[Async]]
bool Restore(Entity[] entities)
{
    // По возможности: заново блокируем то из снятого покрытия, что ещё существует. Ре-энтрантная работа
    // могла законно уничтожить какую-то из покрытых сущностей (израсходованный предмет, убитый NPC); их
    // пропускаем и восстанавливаем выживших, чтобы вызывающий продолжал читать ещё живые сущности.
    Entity[] survivors = {};

    for (int i = 0; i < entities.length(); i++) {
        if (!entities[i].IsDestroyed) {
            survivors.insertLast(entities[i]);
        }
    }

    if (survivors.isEmpty()) {
        Release();
        return true;
    }

    return Lock(survivors);
}

[[Async]]
bool Lock(Critter[] critters)
{
    if (critters.isEmpty()) {
        return true;
    }

    Entity[] entities = array<Entity>(critters.length());
    for (int i = 0; i < critters.length(); i++) {
        if (critters[i].IsDestroyed) {
            return false;
        }

        entities[i] = critters[i];
    }
    return Lock(entities);
}

[[Async]]
bool Lock(Item[] items)
{
    if (items.isEmpty()) {
        return true;
    }

    Entity[] entities = array<Entity>(items.length());
    for (int i = 0; i < items.length(); i++) {
        if (items[i].IsDestroyed) {
            return false;
        }

        entities[i] = items[i];
    }
    return Lock(entities);
}

[[Async]]
bool Lock(Map[] maps)
{
    if (maps.isEmpty()) {
        return true;
    }

    Entity[] entities = array<Entity>(maps.length());
    for (int i = 0; i < maps.length(); i++) {
        if (maps[i].IsDestroyed) {
            return false;
        }

        entities[i] = maps[i];
    }
    return Lock(entities);
}

[[Async]]
bool Lock(Location[] locations)
{
    if (locations.isEmpty()) {
        return true;
    }

    Entity[] entities = array<Entity>(locations.length());
    for (int i = 0; i < locations.length(); i++) {
        if (locations[i].IsDestroyed) {
            return false;
        }

        entities[i] = locations[i];
    }
    return Lock(entities);
}

// Каждый Game.Sync полностью заменяет набор блокировок SyncContext, поэтому скрипту, которому нужны и
// фиксированные сущности (обычно владелец [[TimeEvent]] и связанная сущность вроде карты), И список
// соседей, приходится перечислять всё в одном вызове. Эти перегрузки собирают фиксированные ведущие
// сущности вместе с типизированным массивом в единый запрос синхронизации Entity[] и проверяют живучесть
// по всему объединению.

[[Async]]
bool Lock(Entity entity, Critter[] critters)
{
    if (entity.IsDestroyed) {
        return false;
    }

    Entity[] entities = array<Entity>(critters.length() + 1);
    entities[0] = entity;
    for (int i = 0; i < critters.length(); i++) {
        if (critters[i].IsDestroyed) {
            return false;
        }

        entities[i + 1] = critters[i];
    }
    return Lock(entities);
}

[[Async]]
bool Lock(Entity firstEntity, Entity secondEntity, Critter[] critters)
{
    if (firstEntity.IsDestroyed || secondEntity.IsDestroyed) {
        return false;
    }

    Entity[] entities = array<Entity>(critters.length() + 2);
    entities[0] = firstEntity;
    entities[1] = secondEntity;
    for (int i = 0; i < critters.length(); i++) {
        if (critters[i].IsDestroyed) {
            return false;
        }

        entities[i + 2] = critters[i];
    }
    return Lock(entities);
}

[[Async]]
bool Lock(Entity entity, Item[] items)
{
    if (entity.IsDestroyed) {
        return false;
    }

    Entity[] entities = array<Entity>(items.length() + 1);
    entities[0] = entity;
    for (int i = 0; i < items.length(); i++) {
        if (items[i].IsDestroyed) {
            return false;
        }

        entities[i + 1] = items[i];
    }
    return Lock(entities);
}

[[Async]]
bool Lock(Entity firstEntity, Entity secondEntity, Item[] items)
{
    if (firstEntity.IsDestroyed || secondEntity.IsDestroyed) {
        return false;
    }

    Entity[] entities = array<Entity>(items.length() + 2);
    entities[0] = firstEntity;
    entities[1] = secondEntity;
    for (int i = 0; i < items.length(); i++) {
        if (items[i].IsDestroyed) {
            return false;
        }

        entities[i + 2] = items[i];
    }
    return Lock(entities);
}

void Release()
{
    Game.SyncRelease();
}

[[Async]]
bool LockCritterWithMap(Critter cr)
{
    while (true) {
        if (cr.IsDestroyed) {
            return false;
        }

        if (!Lock(cr)) {
            return false;
        }

        Map? map = cr.GetMap();

        if (map == null) {
            return true;
        }

        if (map.IsDestroyed) {
            return false;
        }

        ident mapId = map.Id;

        if (!Lock(cr, map)) {
            continue;
        }

        // Криттер мигрировал на другую карту между чтением и блокировкой; повтор.
        if (cr.MapId != mapId) {
            continue;
        }

        return true;
    }

    return false;
}

[[Async]]
bool LockCritterWithMapAndLocation(Critter cr)
{
    while (true) {
        if (cr.IsDestroyed) {
            return false;
        }

        if (!Lock(cr)) {
            return false;
        }

        Map? map = cr.GetMap();

        if (map == null) {
            return true;
        }

        if (map.IsDestroyed) {
            return false;
        }

        ident mapId = map.Id;

        // cr + map должны быть удержаны, прежде чем map.GetLocation() можно прочитать под локом карты.
        if (!Lock(cr, map)) {
            continue;
        }

        if (cr.MapId != mapId) {
            continue;
        }

        Location loc = map.GetLocation();
        if (loc.IsDestroyed) {
            return false;
        }

        ident locId = loc.Id;

        // Расширяем до cr + map + location, чтобы стали доступны собственные свойства локации.
        if (!Lock(cr, map, loc)) {
            continue;
        }

        // Криттер мигрировал при расширении набора блокировок; повтор.
        if (cr.MapId != mapId) {
            continue;
        }

        if (map.GetLocation().Id != locId) {
            continue;
        }

        return true;
    }

    return false;
}

[[Async]]
bool LockCritterWithMapAndLocation(Critter cr, Entity[] fixedEntities)
{
    while (true) {
        if (cr.IsDestroyed) {
            return false;
        }

        Entity[] critterCover = fixedEntities.clone();
        critterCover.insertLast(cr);
        if (!Lock(critterCover)) {
            return false;
        }

        Map? map = cr.GetMap();

        if (map == null) {
            return true;
        }

        if (map.IsDestroyed) {
            return false;
        }

        ident mapId = map.Id;

        // Ведущие сущности должны оставаться в каждом наборе: Game.Sync полностью заменяет покрытие.
        Entity[] mapCover = critterCover.clone();
        mapCover.insertLast(map);
        if (!Lock(mapCover)) {
            continue;
        }

        if (cr.MapId != mapId) {
            continue;
        }

        Location loc = map.GetLocation();
        if (loc.IsDestroyed) {
            return false;
        }

        ident locId = loc.Id;

        Entity[] locationCover = mapCover.clone();
        locationCover.insertLast(loc);
        if (!Lock(locationCover)) {
            continue;
        }

        // Карта или локация могли смениться, пока воркер ждал полный набор локов.
        if (cr.MapId != mapId || map.GetLocation().Id != locId) {
            continue;
        }

        return true;
    }

    return false;
}

#endif

}
