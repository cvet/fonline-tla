// Test_Explode — тесты нормализации задержки взрывчатки из окна Timer.
namespace Test_Explode
{

#if SERVER

[[ModuleInit]]
void InitTestExplode()
{
    Game.OnTestingInit.Subscribe(OnTestingInit);
}

[[Event]]
void OnTestingInit()
{
    Testing::RegisterTest("explode", "timer_seconds_bounds", TimerSecondsBounds);
}

void TimerSecondsBounds(Testing::TestContext ctx)
{
    if (!Testing::ExpectEq(ctx, Explode::NormalizeTimerSeconds(0), 1, "Нулевая задержка должна стать одной секундой")) {
        return;
    }
    if (!Testing::ExpectEq(ctx, Explode::NormalizeTimerSeconds(600), 599, "Задержка должна помещаться в формат 09:59")) {
        return;
    }

    Testing::ExpectEq(ctx, Explode::NormalizeTimerSeconds(61), 61, "Значение 01:01 должно остаться 61 секундой");
}

#endif

}
