// GMTown — просмотр и вход в город с глобальной карты.
// Обязанности: SERVER RPC сбора локаций/входов и переноса игрока; CLIENT RPC показа экрана города. Сторона: MIXED (SERVER+CLIENT).
// Связи: Location, GlobalmapGroup, Gui, Stdlib.
namespace GMTown
{

///@ RemoteCall Client ShowGMTown(ident locId, hstring locPid, int32[] indexMaps)

///@ RemoteCall Server Rpc_TransferToMap(ident locId, int32 mapIndex)
///@ RemoteCall Server Rpc_ShowTownView(ident locId, int32 mapIndex)
///@ RemoteCall Server Rpc_ShowGMTown()

#if SERVER

// Открываем экран ближайшего видимого города с обычными серверными проверками разрешённых входов.
[[ServerRemoteCall]]
void Rpc_ShowGMTown(Player player)
{
    Critter? cr = player.GetControlledCritter();
    if (cr == null || cr.GetMap() != null) {
        return;
    }

    Location[] locs = {};
    locs = Location::GetVisibleLocations(ipos(cr.WorldPos.x, cr.WorldPos.y), 0, cr);
    if (locs.length() == 0) {
        return;
    }

    GlobalmapGroup::ProcessGlobalMapCommandImpl(player, GlobalmapGroup::GM_CMD_ENTRANCES, locs[0].Id, 0);
}

// Предпросмотр города проходит обычные серверные проверки; mapIndex — порядковый номер входа.
[[ServerRemoteCall]]
void Rpc_ShowTownView(Player player, ident locId, int mapIndex)
{
    GlobalmapGroup::ProcessGlobalMapCommandImpl(player, GlobalmapGroup::GM_CMD_VIEW_MAP, locId, mapIndex);
}

// Вход в город проходит обычные проверки расстояния, группы, таймаута и разрешённого входа.
[[ServerRemoteCall]]
void Rpc_TransferToMap(Player player, ident locId, int mapIndex)
{
    GlobalmapGroup::ProcessGlobalMapCommandImpl(player, GlobalmapGroup::GM_CMD_TOLOCAL, locId, mapIndex);
}
#endif

#if CLIENT

// Показываем экран города по данным от сервера (id/прототип локации и индексы карт-входов).
[[ClientRemoteCall]]
void ShowGMTown(ident locId, hstring locPid, int[] indexMaps)
{
    Gui::ShowScreen(GuiScreen::GmTown, dict<string, any> = {{"LocationId", locId}, {"LocationPid", locPid}, {"IndexMaps", Stdlib::IntArrToStr(indexMaps)}});
}

#endif

}
