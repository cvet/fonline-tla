// Test_Stdlib — тесты конвертеров строка<->массив из Stdlib (int/string/hstring).
// Закрепляют контракт кодирования через "\n" и регрессию R4: у одноэлементного массива
// нет ведущего разделителя (баг result.isEmpty() -> i == 0).
namespace Test_Stdlib
{

#if SERVER

[[ModuleInit]]
void InitTestStdlib()
{
    Game.OnTestingInit.Subscribe(OnTestingInit);
}

[[Event]]
void OnTestingInit()
{
    Testing::RegisterTest("stdlib", "int_arr_roundtrip", IntArrRoundtrip);
    Testing::RegisterTest("stdlib", "str_arr_roundtrip", StrArrRoundtrip);
    Testing::RegisterTest("stdlib", "hstr_arr_roundtrip", HStrArrRoundtrip);
    Testing::RegisterTest("stdlib", "single_element_no_separator", SingleElementNoSeparator);
    Testing::RegisterTest("stdlib", "empty_arr_to_str", EmptyArrToStr);
}

void IntArrRoundtrip(Testing::TestContext ctx)
{
    int[] source = {1, -2, 30, 0, 2147483647};
    string encoded = Stdlib::IntArrToStr(source);
    if (!Testing::ExpectStrEq(ctx, encoded, "1\n-2\n30\n0\n2147483647", "IntArrToStr должен разделять элементы \\n")) {
        return;
    }

    int[] decoded = Stdlib::StrToIntArr(encoded);
    if (!Testing::ExpectEq(ctx, decoded.length(), source.length(), "Round-trip должен сохранить длину")) {
        return;
    }

    for (int i = 0; i < source.length(); i++) {
        if (!Testing::ExpectEq(ctx, decoded[i], source[i], "Round-trip должен сохранить элемент " + i)) {
            return;
        }
    }
}

void StrArrRoundtrip(Testing::TestContext ctx)
{
    string[] source = {"alpha", "beta", "", "гамма"};
    string encoded = Stdlib::StrArrToStr(source);
    if (!Testing::ExpectStrEq(ctx, encoded, "alpha\nbeta\n\nгамма", "StrArrToStr должен сохранять пустые элементы")) {
        return;
    }

    string[] decoded = Stdlib::StrToStrArr(encoded);
    if (!Testing::ExpectEq(ctx, decoded.length(), source.length(), "Round-trip должен сохранить длину")) {
        return;
    }

    for (int i = 0; i < source.length(); i++) {
        if (!Testing::ExpectStrEq(ctx, decoded[i], source[i], "Round-trip должен сохранить элемент " + i)) {
            return;
        }
    }
}

void HStrArrRoundtrip(Testing::TestContext ctx)
{
    hstring[] source = {"test_alpha".hstr(), "test_beta".hstr()};
    string encoded = Stdlib::HStrArrToStr(source);
    if (!Testing::ExpectStrEq(ctx, encoded, "test_alpha\ntest_beta", "HStrArrToStr должен кодировать имена через \\n")) {
        return;
    }

    hstring[] decoded = Stdlib::StrToHStrArr(encoded);
    if (!Testing::ExpectEq(ctx, decoded.length(), source.length(), "Round-trip должен сохранить длину")) {
        return;
    }

    for (int i = 0; i < source.length(); i++) {
        if (!Testing::Expect(ctx, decoded[i] == source[i], "Round-trip должен сохранить элемент " + i)) {
            return;
        }
    }
}

// Регрессия R4: у одноэлементного массива не должно быть ведущего "\n"
void SingleElementNoSeparator(Testing::TestContext ctx)
{
    int[] one = {42};
    if (!Testing::ExpectStrEq(ctx, Stdlib::IntArrToStr(one), "42", "Один int-элемент кодируется без разделителя")) {
        return;
    }

    string[] oneStr = {"solo"};
    Testing::ExpectStrEq(ctx, Stdlib::StrArrToStr(oneStr), "solo", "Один string-элемент кодируется без разделителя");
}

void EmptyArrToStr(Testing::TestContext ctx)
{
    int[] empty = {};
    Testing::ExpectStrEq(ctx, Stdlib::IntArrToStr(empty), "", "Пустой массив кодируется в пустую строку");
}

#endif

}
