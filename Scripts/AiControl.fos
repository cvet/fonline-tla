// AI Control Bridge (клиентский мост тестирования/автоматизации).
//
// Скрипт строит структурированные наблюдения (observation), отдаёт события и исполняет
// семантические команды через обычные пути управления игроком (ChosenActions / ServerCall),
// поэтому сервер по-прежнему валидирует каждый итоговый запрос. Нативная часть моста
// (SourceExt/ClientAiBridge.cpp) поднимает локальный TCP-сокет и обменивается JSON-строками;
// Python-адаптер из Tools/AiControlMcp оборачивает это в MCP. См. Docs/AiControl.md.
//
// Это первая (foundation) версия порта из родственного проекта: покрыты observation, события и
// базовые команды поверх реального API TLA. Системы, которых в TLA пока нет (roster, admin,
// фракции, overwatch, глобальные интересы и т.п.), сознательно опущены и будут добавляться по мере
// появления соответствующих систем.

namespace AiControl
{

///@ Setting Client bool AiControl.Enabled
///@ Setting Client string AiControl.Host
///@ Setting Client int32 AiControl.Port
///@ Setting Client int32 AiControl.PortStride
///@ Setting Client string AiControl.Token
///@ Setting Client int32 AiControl.MaxQueuedCommands
///@ Setting Client int32 AiControl.MaxEvents
///@ Setting Client int32 AiControl.ObservationInterval
///@ Setting Client int32 AiControl.MaxObservedEntities
///@ Setting Client bool AiControl.SkipRosterOnLogin
///@ Setting Client int32 AiControl.ProfileObservationThresholdMs
///@ Setting Client bool AiControl.CaptureRawInputEvents
///@ Setting Common bool AiControl.AllowQaCommands

// QA-телепорты (только для тестов): двойной гейт через AiControl.AllowQaCommands (default False)
// на клиенте и на сервере. Используются, чтобы вывести тест-персонажа со стартовой карты на
// контент/глобалку или подвинуть на недостижимый гекс. Это не нормальная игровая способность.
///@ RemoteCall Server AiControlQaTeleportGlobal()
///@ RemoteCall Server AiControlQaTeleportHex(mpos hex)
///@ RemoteCall Server AiControlQaTeleportMap(hstring locPid, hstring mapPid, mpos hex)
///@ RemoteCall Server AiControlQaSetProp(CritterProperty prop, int32 value, int32 requestId)
///@ RemoteCall Server AiControlQaSetGameProp(GameProperty prop, int32 value)
///@ RemoteCall Server AiControlQaGiveItem(hstring pid, int32 count)
///@ RemoteCall Server AiControlQaGetProp(CritterProperty prop, int32 requestId)
///@ RemoteCall Server AiControlQaShowDialogBox()
///@ RemoteCall Client AiControlReceiveQaProp(CritterProperty prop, int32 value, int32 requestId)
///@ RemoteCall Client AiControlReceiveQaPropSet(CritterProperty prop, int32 value, int32 requestId)
///@ RemoteCall Client AiControlReceiveTalkDiagnostic(ident npcId, int32 status, bool playerAlive, bool npcAlive, bool npcControlled, bool npcNoTalk, bool sameMap, int32 distance, int32 talkDistance, bool playerSeesNpc, bool npcSeesPlayer)

const int TalkDiagnosticEligible = 0;
const int TalkDiagnosticStarted = 1;
const int TalkDiagnosticNoVisibleStartSpeech = 2;
const int TalkDiagnosticPlayerDead = 3;
const int TalkDiagnosticNpcDead = 4;
const int TalkDiagnosticNpcControlled = 5;
const int TalkDiagnosticNpcNoTalk = 6;
const int TalkDiagnosticDifferentMap = 7;
const int TalkDiagnosticOutOfRange = 8;
const int TalkDiagnosticPlayerCannotSeeNpc = 9;
const int TalkDiagnosticNpcCannotSeePlayer = 10;
const int TalkDiagnosticMissingDialog = 11;

#if CLIENT

const int DefaultPort = 43011;
const int DefaultMaxQueuedCommands = 64;
const int DefaultMaxEvents = 512;
const int DefaultObservationInterval = 250;
const int DefaultMaxObservedEntities = 80;

// Спецзначение закрытия диалога (0xF2 означает переход в бартер).
const int DialogAnswerClose = 0xF1;

bool BridgeStarted = false;
nanotime NextObservationTick = ZERO_NANOTIME;
int ObservationBuildSeq = 0;

// Видимые предметы на карте отслеживаем по событиям in/out, т.к. клиентский MapView не отдаёт
// общий список предметов карты одним вызовом.
ident[] VisibleMapItemIds = {};

// Состояние активного диалога. Заполняется напрямую из Dialogs.fos::ReceiveDialogContext через
// SetDialogState/ClearDialogState — это источник данных до того, как params экрана опустошается
// внутри Gui::ShowScreen (поэтому захват из OnScreenChange ненадёжен).
bool DialogActive = false;
hstring DialogId = EMPTY_HSTRING;
ident DialogTalkerId = ZERO_IDENT;
string DialogText;
string[] DialogAnswers = {};

[[ModuleInit]]
void InitAiControl()
{
    Game.OnStart.Subscribe(OnStart);
    Game.OnFinish.Subscribe(OnFinish);
    Game.OnConnecting.Subscribe(OnConnecting);
    Game.OnConnectingFailed.Subscribe(OnConnectingFailed);
    Game.OnConnected.Subscribe(OnConnected);
    Game.OnDisconnected.Subscribe(OnDisconnected);
    Game.OnLoginSuccess.Subscribe(OnLoginSuccess);
    Game.OnInfoMessage.Subscribe(OnInfoMessage);
    Game.OnLoop.Subscribe(OnLoop);
    Game.OnInputLost.Subscribe(OnInputLost);
    Game.OnMapLoad.Subscribe(OnMapLoad);
    Game.OnMapUnload.Subscribe(OnMapUnload);
    Game.OnCritterIn.Subscribe(OnCritterIn);
    Game.OnCritterOut.Subscribe(OnCritterOut);
    Game.OnItemMapIn.Subscribe(OnItemMapIn);
    Game.OnItemMapOut.Subscribe(OnItemMapOut);
    Game.OnItemInvIn.Subscribe(OnItemInvIn);
    Game.OnItemInvOut.Subscribe(OnItemInvOut);
    Game.OnReceiveItems.Subscribe(OnReceiveItems);
    Game.OnScreenChange.Subscribe(OnScreenChange);
    Game.OnConsoleMessage.Subscribe(OnConsoleMessage);
}

[[Event]]
void OnStart()
{
    if (!Settings.AiControl.Enabled) {
        return;
    }

    string host = Settings.AiControl.Host.isEmpty() ? "127.0.0.1" : Settings.AiControl.Host;
    int basePort = Settings.AiControl.Port > 0 ? Settings.AiControl.Port : DefaultPort;
    int maxQueuedCommands = Settings.AiControl.MaxQueuedCommands > 0 ? Settings.AiControl.MaxQueuedCommands : DefaultMaxQueuedCommands;
    int maxEvents = Settings.AiControl.MaxEvents > 0 ? Settings.AiControl.MaxEvents : DefaultMaxEvents;
    int clientIndex = Game.GetEmbeddedClientIndex();

    // Мультиклиент: первый встроенный клиент (index 1) — на базовом порту, последующие — со сдвигом
    // PortStride, чтобы их мосты не конфликтовали.
    int stride = Settings.AiControl.PortStride > 0 ? Settings.AiControl.PortStride : 1;
    int port = basePort + (clientIndex > 1 ? (clientIndex - 1) * stride : 0);

    BridgeStarted = Game.AiControlStart(true, host, port, Settings.AiControl.Token, maxQueuedCommands, maxEvents);
    PushEvent(Object({StringMember("type", "bridge_started"),
                      BoolMember("success", BridgeStarted),
                      StringMember("host", host),
                      IntMember("port", port),
                      IntMember("clientIndex", clientIndex)}));
}

[[Event]]
void OnFinish()
{
    if (BridgeStarted) {
        PushEvent(Object({StringMember("type", "bridge_stopped")}));
    }

    Game.AiControlStop();
    BridgeStarted = false;
}

[[Event]]
void OnConnecting()
{
    PushSimpleEvent("connecting");
}

[[Event]]
void OnConnectingFailed()
{
    PushSimpleEvent("connecting_failed");
}

[[Event]]
void OnConnected()
{
    PushSimpleEvent("connected");
}

[[Event]]
void OnDisconnected()
{
    VisibleMapItemIds.resize(0);
    ClearDialogState();
    PushSimpleEvent("disconnected");
}

[[Event]]
void OnLoginSuccess()
{
    PushSimpleEvent("login_success");
}

[[Event]]
void OnInfoMessage(EngineInfoMessage infoMessage, string extraText)
{
    PushEvent(
        Object({StringMember("type", "info_message"), StringMember("message", Game.EnumToString(infoMessage, true)), StringMember("extraText", extraText)}));
}

[[Event]]
void OnLoop()
{
    if (!Settings.AiControl.Enabled || !Game.AiControlIsRunning()) {
        return;
    }

    ProcessCommands();

    if (NextObservationTick == ZERO_NANOTIME || Game.FrameTime >= NextObservationTick) {
        Game.AiControlSetObservation(BuildObservation());
        NextObservationTick = Game.FrameTime + Time::Milliseconds(GetObservationInterval());
    }
}

[[Event]]
void OnInputLost()
{
    // OnInputLost срабатывает каждый кадр, пока окно клиента не в фокусе (а автоматический/headless-клиент
    // в фокусе почти никогда) — без гейта это затопляет кольцо событий и вытесняет полезные (command_completed,
    // qa_prop_value). Поэтому шлём только при включённом захвате сырого ввода.
    if (Settings.AiControl.CaptureRawInputEvents) {
        PushSimpleEvent("input_lost");
    }
}

[[Event]]
void OnMapLoad()
{
    VisibleMapItemIds.resize(0);
    PushSimpleEvent("map_load");
}

[[Event]]
void OnMapUnload()
{
    VisibleMapItemIds.resize(0);
    PushSimpleEvent("map_unload");
}

[[Event]]
void OnCritterIn(Critter cr)
{
    PushEvent(Object({StringMember("type", "critter_in"), RawMember("critter", CritterJson(cr))}));
}

[[Event]]
void OnCritterOut(Critter cr)
{
    PushEvent(Object({StringMember("type", "critter_out"), IdentMember("critterId", cr.Id)}));
}

[[Event]]
void OnItemMapIn(Item item)
{
    TrackMapItem(item.Id, true);
    PushEvent(Object({StringMember("type", "item_map_in"), RawMember("item", MapItemJson(item))}));
}

[[Event]]
void OnItemMapOut(Item item)
{
    TrackMapItem(item.Id, false);
    PushEvent(Object({StringMember("type", "item_map_out"), IdentMember("itemId", item.Id)}));
}

[[Event]]
void OnItemInvIn(Item item)
{
    PushEvent(Object({StringMember("type", "item_inv_in"), RawMember("item", InventoryItemJson(item))}));
}

[[Event]]
void OnItemInvOut(Item item)
{
    PushEvent(Object({StringMember("type", "item_inv_out"), IdentMember("itemId", item.Id)}));
}

[[Event]]
void OnReceiveItems(Item[] items, any contextParam)
{
    string[] entries = {};
    for (int i = 0; i < items.length(); i++) {
        entries.insertLast(InventoryItemJson(items[i]));
    }
    PushEvent(Object({StringMember("type", "receive_items"),
                      IntMember("count", int(items.length())),
                      IntMember("context", int(contextParam)),
                      RawMember("items", Array(entries))}));
}

[[Event]]
void OnScreenChange(bool show, GuiScreen screenNum, dict<string, any> params)
{
    // Подстраховка: если экран диалога скрыт любым путём, состояние диалога сбрасываем.
    if (screenNum == GuiScreen::Dialog && !show) {
        ClearDialogState();
    }

    string uiPrompt = UiPromptJson(Gui::GetActiveScreen());
    PushEvent(Object({StringMember("type", "screen_change"),
                      BoolMember("show", show),
                      StringMember("screen", Game.EnumToString(screenNum, true)),
                      RawMember("uiPrompt", uiPrompt)}));

    if (screenNum == GuiScreen::DialogBox || screenNum == GuiScreen::Elevator) {
        PushEvent(Object({StringMember("type", show ? "ui_prompt_opened" : "ui_prompt_closed"),
                          StringMember("screen", Game.EnumToString(screenNum, true)),
                          RawMember("uiPrompt", show ? uiPrompt : Object({BoolMember("active", false)}))}));
    }
}

// Вызывается из Dialogs.fos::ReceiveDialogContext при открытии/обновлении диалога.
void SetDialogState(hstring dialogId, ident talkerId, string text, string answersOneLine)
{
    DialogActive = true;
    DialogId = dialogId;
    DialogTalkerId = talkerId;
    DialogText = text;
    DialogAnswers = answersOneLine.isEmpty() ? array<string>() : answersOneLine.split("\n");

    PushEvent(Object({StringMember("type", "dialog_updated"),
                      StringMember("dialogId", string(dialogId)),
                      IdentMember("talkerId", talkerId),
                      RawMember("dialog", DialogJson())}));
}

// Вызывается из Dialogs.fos::ReceiveDialogContext при закрытии диалога.
void ClearDialogState()
{
    bool wasActive = DialogActive;
    DialogActive = false;
    DialogId = EMPTY_HSTRING;
    DialogTalkerId = ZERO_IDENT;
    DialogText = "";
    DialogAnswers = {};

    if (wasActive) {
        PushSimpleEvent("dialog_closed");
    }
}

// Ответ сервера на qa_get_prop: публикуем значение свойства как событие qa_prop_value (имя свойства +
// числовое значение). Так раннер может верифицировать Server-scope квестовые флаги, невидимые в наблюдении.
[[ClientRemoteCall]] [[Async]]
void AiControlReceiveQaProp(CritterProperty prop, int value, int requestId)
{
    PushEvent(Object({StringMember("type", "qa_prop_value"),
                      StringMember("prop", Game.EnumToString(prop, true)),
                      IntMember("value", value),
                      IntMember("requestId", requestId)}));
}

// Подтверждение qa_set_prop приходит только после явного скриптового critter-cover и успешной записи.
// Корреляция отделяет поздний ответ предыдущей попытки от текущей настройки предусловия.
[[ClientRemoteCall]] [[Async]]
void AiControlReceiveQaPropSet(CritterProperty prop, int value, int requestId)
{
    PushEvent(Object({StringMember("type", "qa_prop_set"),
                      StringMember("prop", Game.EnumToString(prop, true)),
                      IntMember("value", value),
                      IntMember("requestId", requestId)}));
}

// Диагностика приходит из обычного StartDialog и только наблюдает его серверные проверки. Она не
// открывает диалог в обход механик и не меняет состояние игрового мира.
[[ClientRemoteCall]] [[Async]]
void AiControlReceiveTalkDiagnostic(ident npcId, int status, bool playerAlive, bool npcAlive, bool npcControlled, bool npcNoTalk, bool sameMap, int distance,
                                    int talkDistance, bool playerSeesNpc, bool npcSeesPlayer)
{
    PushEvent(Object({StringMember("type", "talk_diagnostic"),
                      IdentMember("npcId", npcId),
                      StringMember("status", TalkDiagnosticStatus(status)),
                      BoolMember("playerAlive", playerAlive),
                      BoolMember("npcAlive", npcAlive),
                      BoolMember("npcControlled", npcControlled),
                      BoolMember("npcNoTalk", npcNoTalk),
                      BoolMember("sameMap", sameMap),
                      IntMember("distance", distance),
                      IntMember("talkDistance", talkDistance),
                      BoolMember("playerSeesNpc", playerSeesNpc),
                      BoolMember("npcSeesPlayer", npcSeesPlayer)}));
}

string TalkDiagnosticStatus(int status)
{
    if (status == TalkDiagnosticEligible) {
        return "eligible";
    }
    if (status == TalkDiagnosticStarted) {
        return "started";
    }
    if (status == TalkDiagnosticNoVisibleStartSpeech) {
        return "no_visible_start_speech";
    }
    if (status == TalkDiagnosticPlayerDead) {
        return "player_dead";
    }
    if (status == TalkDiagnosticNpcDead) {
        return "npc_dead";
    }
    if (status == TalkDiagnosticNpcControlled) {
        return "npc_controlled";
    }
    if (status == TalkDiagnosticNpcNoTalk) {
        return "npc_no_talk";
    }
    if (status == TalkDiagnosticDifferentMap) {
        return "different_map";
    }
    if (status == TalkDiagnosticOutOfRange) {
        return "out_of_range";
    }
    if (status == TalkDiagnosticPlayerCannotSeeNpc) {
        return "player_cannot_see_npc";
    }
    if (status == TalkDiagnosticNpcCannotSeePlayer) {
        return "npc_cannot_see_player";
    }
    if (status == TalkDiagnosticMissingDialog) {
        return "missing_dialog";
    }
    return "unknown";
}

[[Event]]
void OnConsoleMessage(string text)
{
    PushEvent(Object({StringMember("type", "console_message"), StringMember("text", text)}));
}

// --- Учёт видимых предметов карты ------------------------------------------------------------

void TrackMapItem(ident itemId, bool present)
{
    for (int i = 0; i < VisibleMapItemIds.length(); i++) {
        if (VisibleMapItemIds[i] == itemId) {
            if (!present) {
                VisibleMapItemIds.removeAt(i);
            }
            return;
        }
    }

    if (present) {
        VisibleMapItemIds.insertLast(itemId);
    }
}

// --- Исполнение команд -----------------------------------------------------------------------

void ProcessCommands()
{
    for (int i = 0; i < 16; i++) {
        uint commandSeq = 0;
        string type;
        ident targetId = ZERO_IDENT;
        ident itemId = ZERO_IDENT;
        ident auxId = ZERO_IDENT;
        int hexX = 0;
        int hexY = 0;
        int screenX = 0;
        int screenY = 0;
        int intArg = 0;
        string stringArg;
        string sceneryProtoId;
        bool append = false;

        if (!Game.AiControlPullCommand(commandSeq, type, targetId, itemId, auxId, hexX, hexY, screenX, screenY, intArg, stringArg, sceneryProtoId, append)) {
            return;
        }

        string message;
        bool success = ExecuteCommand(type, targetId, itemId, auxId, hexX, hexY, screenX, screenY, intArg, stringArg, sceneryProtoId, append, message);
        Game.AiControlCompleteCommand(commandSeq, success, message);
    }
}

// Открывает параметризованные окна на реальных клиентских сущностях. Это QA-вход в тот же
// контракт OnShow, который используют игровые обработчики; действия из окна остаются штатными.
bool ShowContextScreen(string screenName, ident targetId, ident itemId, int intArg, string& message)
{
    if (!HasChosen) {
        message = "no_chosen";
        return false;
    }

    GuiScreen screenNum = GuiScreen::None;
    if (!Game.TryParseEnum(screenName, screenNum)) {
        message = "unknown_screen:" + screenName;
        return false;
    }

    dict<string, any> params = {};
    if (screenNum == GuiScreen::Aim) {
        if (!HasCurMap) {
            message = "no_map";
            return false;
        }
        Critter? target = targetId != ZERO_IDENT ? Game.GetCritter(targetId) : null;
        if (target == null) {
            message = targetId == ZERO_IDENT ? "missing_target" : "target_missing";
            return false;
        }
        if (!target.IsAlive()) {
            message = "target_not_alive";
            return false;
        }

        params["TargetCritterId"] = target.Id;
    }
    else if (screenNum == GuiScreen::Use) {
        bool hasCritterTarget = targetId != ZERO_IDENT;
        bool hasItemTarget = itemId != ZERO_IDENT;
        if (hasCritterTarget == hasItemTarget) {
            message = "invalid_context_target";
            return false;
        }

        Critter? targetCr = hasCritterTarget ? Game.GetCritter(targetId) : null;
        Item? targetItem = hasItemTarget ? Game.GetItem(itemId) : null;
        if (hasCritterTarget && targetCr == null) {
            message = "target_missing";
            return false;
        }
        if (hasItemTarget && targetItem == null) {
            message = "item_missing";
            return false;
        }

        params["TargetCritterId"] = targetId;
        params["TargetItemId"] = itemId;
    }
    else if (screenNum == GuiScreen::Timer || screenNum == GuiScreen::Split) {
        Item? item = itemId != ZERO_IDENT ? Game.GetItem(itemId) : null;
        if (item == null) {
            message = "item_missing";
            return false;
        }
        if (item.Ownership != ItemOwnership::CritterInventory || item.CritterId != Chosen.Id) {
            message = "item_not_owned";
            return false;
        }

        if (screenNum == GuiScreen::Timer) {
            if (!Parameters::IsTimedUseItem(item)) {
                message = "item_not_timed";
                return false;
            }
            params["TargetItemId"] = item.Id;
        }
        else {
            if (intArg != ClientDefines::ITEMS_CHOSEN_ALL) {
                message = "unsupported_split_collection";
                return false;
            }
            if (!item.Stackable || item.Count <= 1) {
                message = "item_not_stackable";
                return false;
            }

            params["TargetItemId"] = item.Id;
            params["ItemsCollection"] = ClientDefines::ITEMS_CHOSEN_ALL;
            params["TransferType"] = 0;
            params["TransferContainerId"] = ZERO_IDENT;
            params["TransferSession"] = uint(0);
        }
    }
    else if (screenNum == GuiScreen::SkillBox) {
        bool hasCritterTarget = targetId != ZERO_IDENT;
        bool hasItemTarget = itemId != ZERO_IDENT;
        if (hasCritterTarget && hasItemTarget) {
            message = "invalid_context_target";
            return false;
        }
        Critter? targetCr = hasCritterTarget ? Game.GetCritter(targetId) : null;
        Item? targetItem = hasItemTarget ? Game.GetItem(itemId) : null;
        if (hasCritterTarget && targetCr == null) {
            message = "target_missing";
            return false;
        }
        if (hasItemTarget && targetItem == null) {
            message = "item_missing";
            return false;
        }

        int isInventory = 0;
        if (targetItem != null && targetItem.Ownership == ItemOwnership::CritterInventory && targetItem.CritterId == Chosen.Id) {
            isInventory = 1;
        }
        if (intArg >= 0 && intArg != isInventory) {
            message = "item_ownership_mismatch";
            return false;
        }

        params["TargetCritterId"] = targetId;
        params["TargetItemId"] = itemId;
        params["IsInventory"] = isInventory;
    }
    else {
        message = "unsupported_context_screen:" + screenName;
        return false;
    }

    Gui::ShowScreen(screenNum, params);
    message = "shown";
    return true;
}

int ResolveUiPromptAnswerIndex(int requestedIndex, string answerId, string idPrefix, int firstValue, int count)
{
    if (answerId.isEmpty()) {
        return requestedIndex;
    }

    for (int i = 0; i < count; i++) {
        string value = "" + (firstValue + i);
        if (answerId == idPrefix + value || answerId == value) {
            return requestedIndex >= 0 && requestedIndex != i ? -1 : i;
        }
    }

    return -1;
}

int ResolveElevatorUiPromptAnswerIndex(int requestedIndex, string answerId, int elevatorType, int count)
{
    if (answerId.isEmpty()) {
        return requestedIndex;
    }

    for (int i = 0; i < count; i++) {
        int displayLevel = Elevator::GetElevatorDisplayLevel(elevatorType, i);
        string value = "" + displayLevel;
        if (displayLevel >= 0 && (answerId == "level_" + value || answerId == value)) {
            return requestedIndex >= 0 && requestedIndex != i ? -1 : i;
        }
    }

    return -1;
}

bool ExecuteUiPromptAnswer(int requestedIndex, string answerId, ident expectedSession, string& message)
{
    Gui::Screen? activeScreen = Gui::GetActiveScreen();
    if (activeScreen == null) {
        message = "ui_prompt_missing";
        return false;
    }

    if (activeScreen.Num == GuiScreen::DialogBox) {
        auto dialogBox = cast<GuiScreens::DialogBox::DialogBox>(activeScreen);
        if (dialogBox.Answers < 1 || dialogBox.Answers > Dialogbox::MAX_DIALOG_BOX_ANSWERS || dialogBox.Session == 0) {
            message = "ui_prompt_stale";
            return false;
        }
        if (expectedSession == ZERO_IDENT) {
            message = "ui_prompt_session_required";
            return false;
        }
        if (expectedSession.value != int64(dialogBox.Session)) {
            message = "ui_prompt_stale";
            return false;
        }

        int answer = ResolveUiPromptAnswerIndex(requestedIndex, answerId, "answer_", 0, dialogBox.Answers);
        if (answer < 0 || answer >= dialogBox.Answers) {
            message = "ui_answer_out_of_range";
            return false;
        }

        Dialogbox::AnswerDialog(dialogBox.Session, dialogBox.DialogType, answer);
        Gui::HideScreen(GuiScreen::DialogBox);
        message = "ui_answered";
        return true;
    }

    if (activeScreen.Num == GuiScreen::Elevator) {
        // Сессия относится только к DialogBox: запоздавший ответ от него не должен выбрать
        // этаж внезапно открывшегося лифта с тем же индексом кнопки.
        if (expectedSession != ZERO_IDENT) {
            message = "ui_prompt_stale";
            return false;
        }
        if (!HasCurPlayer) {
            message = "not_connected";
            return false;
        }

        auto elevator = cast<GuiScreens::Elevator::Elevator>(activeScreen);
        if (!elevator.Valid || int(elevator.Data.length()) < 14) {
            message = "ui_prompt_stale";
            return false;
        }

        int firstLevel = int(elevator.Data[1]);
        int answerCount = int(elevator.Data[13]);
        int elevatorType = elevator.Type & 0xFFFF;
        if (answerCount < 1 || answerCount > 16 || int(elevator.Data.length()) < 14 + answerCount * 4 ||
            answerCount != Elevator::GetElevatorExpectedLevelCount(elevatorType)) {
            message = "ui_prompt_stale";
            return false;
        }

        int answer = ResolveElevatorUiPromptAnswerIndex(requestedIndex, answerId, elevatorType, answerCount);
        if (answer < 0 || answer >= answerCount) {
            message = "ui_answer_out_of_range";
            return false;
        }

        CurPlayer.ServerCall.Rpc_SelectLevel(firstLevel + answer, 0, 0);
        Gui::HideScreen(GuiScreen::Elevator);
        message = "ui_answered";
        return true;
    }

    message = "ui_prompt_missing";
    return false;
}

bool TryParseTimerUseMode(string value, int& seconds)
{
    const string prefix = "timer:";
    if (value.length() <= prefix.length() || value.substr(0, prefix.length()) != prefix) {
        return false;
    }

    string secondsText = value.substr(prefix.length());
    if (secondsText.isEmpty() || secondsText.length() > 3) {
        return false;
    }
    for (int i = 0; i < secondsText.length(); i++) {
        string digit = secondsText[i];
        if (digit < "0" || digit > "9") {
            return false;
        }
    }
    int parsedSeconds = 0;
    // Ограничение длины выше не даёт tryToInt переполниться, а каноническая обратная запись
    // запрещает пробелы, знак, ведущие нули и хвост после числа.
    if (!secondsText.tryToInt(parsedSeconds) || parsedSeconds < 1 || parsedSeconds > 599 || secondsText != "" + parsedSeconds) {
        return false;
    }

    seconds = parsedSeconds;
    return true;
}

bool ExecuteCommand(string type, ident targetId, ident itemId, ident auxId, int hexX, int hexY, int screenX, int screenY, int intArg, string stringArg,
                    string sceneryProtoId, bool append, string& message)
{
    // Команды, не требующие управляемого персонажа / карты.
    if (type == "clear_actions") {
        ChosenActions::SetChosenActions({});
        message = "cleared";
        return true;
    }
    if (type == "say") {
        if (!HasCurPlayer) {
            message = "not_connected";
            return false;
        }
        CurPlayer.ServerCall.ReceiveChosenSay(SayType(intArg), stringArg);
        message = "said";
        return true;
    }
    if (type == "dialog_answer") {
        if (!HasCurPlayer) {
            message = "not_connected";
            return false;
        }
        CurPlayer.ServerCall.SpeechAnswer(intArg);
        message = "answered";
        return true;
    }
    if (type == "close_dialog") {
        if (!HasCurPlayer || !DialogActive) {
            message = "dialog_not_active";
            return false;
        }
        CurPlayer.ServerCall.SpeechAnswer(DialogAnswerClose);
        message = "dialog_closed";
        return true;
    }
    if (type == "barter_return_dialog") {
        if (!HasCurPlayer || !HasChosen || Chosen.TransferType != TransferTypes::CritBarter || !Gui::IsScreenActive(GuiScreen::Barter)) {
            message = "barter_not_active";
            return false;
        }
        CurPlayer.ServerCall.ResumeDialogFromBarter(Chosen.TransferContainerId, Chosen.TransferSession);
        message = "barter_returned_to_dialog";
        return true;
    }
    if (type == "close_screen") {
        Gui::HideScreen();
        message = "closed";
        return true;
    }
    if (type == "show_screen") {
        GuiScreen screenNum = GuiScreen::None;
        if (!Game.TryParseEnum(stringArg, screenNum)) {
            message = "unknown_screen:" + stringArg;
            return false;
        }
        Gui::ShowScreen(screenNum);
        message = "shown";
        return true;
    }
    if (type == "ui_answer") {
        return ExecuteUiPromptAnswer(intArg, stringArg, auxId, message);
    }
    if (type == "show_context_screen") {
        return ShowContextScreen(stringArg, targetId, itemId, intArg, message);
    }
    if (type == "hide_screen") {
        GuiScreen screenNum = GuiScreen::None;
        if (!Game.TryParseEnum(stringArg, screenNum)) {
            message = "unknown_screen:" + stringArg;
            return false;
        }
        Gui::HideScreen(screenNum);
        message = "hidden";
        return true;
    }
    if (type == "save_screenshot") {
        Game.SaveScreenshot(stringArg);
        message = "saved";
        return true;
    }
    if (type == "set_resolution") {
        Game.SetResolution(hexX, hexY);
        message = "resolution_set";
        return true;
    }
    if (type == "toggle_fullscreen") {
        Game.ToggleFullscreen();
        message = "toggled";
        return true;
    }
    if (type == "set_mouse_pos") {
        Game.SetForcedMousePos(ipos(screenX, screenY));
        message = "mouse_pinned";
        return true;
    }
    if (type == "mouse_click") {
        Game.SimulateMouseClick(ipos(screenX, screenY), MouseButton(intArg));
        message = "clicked";
        return true;
    }
    if (type == "key_press") {
        Game.SimulateKeyboardPress(KeyCode(intArg), KeyCode::None, stringArg, "");
        message = "pressed";
        return true;
    }
    if (type == "environment_query") {
        // intArg=queryId, screenX/screenY=fromHex (или -1 => chosen), x/y=toHex, stringArg=опции.
        return ExecuteEnvironmentQuery(intArg, screenX, screenY, hexX, hexY, stringArg, message);
    }
    if (type == "qa_show_dialog_box") {
        if (!Settings.AiControl.AllowQaCommands) {
            message = "qa_commands_disabled";
            return false;
        }
        if (!HasCurPlayer || !HasChosen) {
            message = "no_chosen";
            return false;
        }
        if (Gui::IsScreenActive(GuiScreen::DialogBox)) {
            message = "dialog_box_already_active";
            return false;
        }
        CurPlayer.ServerCall.AiControlQaShowDialogBox();
        message = "qa_dialog_box_requested";
        return true;
    }
    if (type == "qa_teleport_global" || type == "qa_teleport_hex" || type == "qa_teleport_map") {
        if (!Settings.AiControl.AllowQaCommands) {
            message = "qa_commands_disabled";
            return false;
        }
        if (!HasCurPlayer) {
            message = "not_connected";
            return false;
        }
        if (type == "qa_teleport_global") {
            CurPlayer.ServerCall.AiControlQaTeleportGlobal();
        }
        else if (type == "qa_teleport_hex") {
            CurPlayer.ServerCall.AiControlQaTeleportHex(mpos(hexX, hexY));
        }
        else {
            // Составной pid нельзя передавать одним hstring: сервер отклонит неизвестный хеш строки
            // "location/map" до вызова скрипта. Передаём два известных content-id отдельно.
            string[] pidParts = stringArg.split("/");
            if (pidParts.length() > 2 || pidParts[0].isEmpty() || (pidParts.length() > 1 && pidParts[1].isEmpty())) {
                message = "invalid_map_target";
                return false;
            }
            hstring locPid = pidParts[0].hstr();
            hstring mapPid = pidParts.length() > 1 ? pidParts[1].hstr() : locPid;
            bool hasLocationProto = Game.CheckProtoLocation(locPid);
            bool hasMapProto = Game.CheckProtoMap(mapPid);
            bool directMapTarget = locPid == mapPid && hasMapProto;
            if ((!hasLocationProto && !directMapTarget) || (locPid != mapPid && !hasMapProto)) {
                message = "unknown_map_target";
                return false;
            }
            CurPlayer.ServerCall.AiControlQaTeleportMap(locPid, mapPid, mpos(hexX, hexY));
        }
        message = "qa_sent";
        return true;
    }
    if (type == "qa_set_prop") {
        // QA-настройка предусловия квеста: задать целочисленное свойство криттера по имени enum'а
        // CritterProperty (репутация, лояльность, стадия квеста и т.п.).
        if (!Settings.AiControl.AllowQaCommands) {
            message = "qa_commands_disabled";
            return false;
        }
        if (!HasCurPlayer) {
            message = "not_connected";
            return false;
        }
        CritterProperty prop = CritterProperty::None;
        if (!Game.TryParseEnum(stringArg, prop)) {
            message = "unknown_property:" + stringArg;
            return false;
        }
        // Для этой команды x используется как correlation id подтверждения записи.
        CurPlayer.ServerCall.AiControlQaSetProp(prop, intArg, hexX);
        message = "qa_prop_set";
        return true;
    }
    if (type == "qa_set_game_prop") {
        // QA-настройка предусловия квеста на УРОВНЕ ИГРЫ: задать целочисленное Game-свойство по имени
        // enum'а GameProperty (мировые флаги квестов, напр. DenVirginIsAway). Многие квестовые ответы
        // гейтятся именно Game-, а не Critter-свойствами, поэтому qa_set_prop их не покрывает.
        if (!Settings.AiControl.AllowQaCommands) {
            message = "qa_commands_disabled";
            return false;
        }
        if (!HasCurPlayer) {
            message = "not_connected";
            return false;
        }
        GameProperty gprop = GameProperty::None;
        if (!Game.TryParseEnum(stringArg, gprop)) {
            message = "unknown_game_property:" + stringArg;
            return false;
        }
        CurPlayer.ServerCall.AiControlQaSetGameProp(gprop, intArg);
        message = "qa_game_prop_set";
        return true;
    }
    if (type == "qa_get_prop") {
        // QA-чтение свойства криттера по имени enum'а CritterProperty. Нужно для Server-scope квестовых
        // флагов (не OwnerSync), которых нет в клиентском наблюдении: сервер читает значение и присылает
        // его обратно событием qa_prop_value. Ответ асинхронный (round-trip), не в message этой команды.
        if (!Settings.AiControl.AllowQaCommands) {
            message = "qa_commands_disabled";
            return false;
        }
        if (!HasCurPlayer) {
            message = "not_connected";
            return false;
        }
        CritterProperty prop = CritterProperty::None;
        if (!Game.TryParseEnum(stringArg, prop)) {
            message = "unknown_property:" + stringArg;
            return false;
        }
        CurPlayer.ServerCall.AiControlQaGetProp(prop, intArg);
        message = "qa_prop_requested";
        return true;
    }
    if (type == "qa_get_text") {
        // QA-чтение нумерованной реплики диалога (NPC Say/SayOnHead/Info) по id диалога и номеру строки
        // через тот же MsgStr::DialogTextKey, который использует игра. Пустая строка означает, что текст
        // для этого диалога не задан.
        if (!Settings.AiControl.AllowQaCommands) {
            message = "qa_commands_disabled";
            return false;
        }
        string text = Game.GetText(MsgStr::DialogTextKey(stringArg.hstr(), intArg));
        message = "text=<" + text + ">";
        return true;
    }
    if (type == "qa_get_text_pack") {
        // QA-чтение числовой строки общего пака Text через тот же TextPackKey, который используют игровые
        // скрипты. Команда проверяет фактически запечённую локализацию активного языка клиента.
        if (!Settings.AiControl.AllowQaCommands) {
            message = "qa_commands_disabled";
            return false;
        }
        if (intArg < 0) {
            message = "invalid_text_id";
            return false;
        }
        string text = Game.GetText(TextPackKey(TextPackName::Text, "" + intArg));
        message = "text=<" + text + ">";
        return true;
    }
    if (type == "qa_format_tags") {
        // QA-прогон сырой строки через Game.FormatTags (клиентское разрешение @text/@arg/@sex/…) с
        // возвратом результата. Нужен для сквозной проверки формы `@text Dialogs <dialogName> <key>@`.
        if (!Settings.AiControl.AllowQaCommands) {
            message = "qa_commands_disabled";
            return false;
        }
        message = "result=<" + Game.FormatTags(stringArg, "") + ">";
        return true;
    }
    if (type == "use_skill") {
        // Механика навыков: применить навык (stringArg = имя CritterProperty, напр. SkillFirstAid/
        // SkillLockpick/SkillSteal/SkillRepair/SkillScience/SkillDoctor) ровно к одной цели:
        // криттеру (targetId), предмету (itemId), сценерию (sceneryProtoId + hexX/hexY) либо,
        // если цель не задана, к собственному криттеру.
        if (!HasCurPlayer) {
            message = "not_connected";
            return false;
        }
        CritterProperty skill = CritterProperty::None;
        // имя навыка лежит в auxStr через intArg? Нет — используем stringArg как имя навыка.
        if (!Game.TryParseEnum(stringArg, skill)) {
            message = "unknown_skill:" + stringArg;
            return false;
        }
        bool hasCritterTarget = targetId != ZERO_IDENT;
        bool hasItemTarget = itemId != ZERO_IDENT;
        bool hasSceneryTarget = !sceneryProtoId.isEmpty();
        int targetModes = (hasCritterTarget ? 1 : 0) + (hasItemTarget ? 1 : 0) + (hasSceneryTarget ? 1 : 0);
        if (targetModes > 1 || (!hasSceneryTarget && (hexX != 0 || hexY != 0))) {
            message = "invalid_skill_target";
            return false;
        }
        hstring sceneryPid = sceneryProtoId.isEmpty() ? EMPTY_HSTRING : sceneryProtoId.hstr();
        ident skillTargetCr = targetId;
        if (targetModes == 0 && HasChosen) {
            skillTargetCr = Chosen.Id; // по умолчанию навык на себя (напр. первая помощь)
        }
        CurPlayer.ServerCall.UseSkill(skill, skillTargetCr, itemId, sceneryPid, mpos(hexX, hexY));
        message = "skill_used";
        return true;
    }
    if (type == "qa_give_item") {
        if (!Settings.AiControl.AllowQaCommands) {
            message = "qa_commands_disabled";
            return false;
        }
        if (!HasCurPlayer) {
            message = "not_connected";
            return false;
        }
        CurPlayer.ServerCall.AiControlQaGiveItem(stringArg.hstr(), intArg > 0 ? intArg : 1);
        message = "qa_item_given";
        return true;
    }
    if (type == "register") {
        // Драйвим тот же путь, что и экран регистрации, НО без GuiScreensExt::TryExit():
        // на корневом экране Login TryExit означает выход из клиента. OnConnected увидит
        // непустой RegProps и пошлёт RegisterNewPlayer.
        string name = stringArg.isEmpty() ? DefaultBotName() : stringArg;
        Game.SetCacheText("RegName__", name);
        Game.SetCacheText("RegPassword__", "1");
        PlayerRegistration::RegProps = BuildRegistrationProps();
        if (!Game.IsConnected() && !Game.IsConnecting()) {
            Game.Connect();
        }
        message = "registering:" + name;
        return true;
    }
    if (type == "login") {
        // Пустой набор reg-props => OnConnected пошлёт LoginExistingPlayer, а не регистрацию.
        string name = stringArg.isEmpty() ? DefaultBotName() : stringArg;
        Game.SetCacheText("RegName__", name);
        Game.SetCacheText("RegPassword__", "1");
        PlayerRegistration::ResetRegistrationRequest();
        if (!Game.IsConnected() && !Game.IsConnecting()) {
            Game.Connect();
        }
        message = "logging_in:" + name;
        return true;
    }

    // Дальше — команды управления персонажем; требуется управляемый персонаж.
    if (!HasChosen) {
        message = "no_chosen";
        return false;
    }

    if (type == "move_to_hex") {
        ChosenActions::SetAction({Tla::ChosenMove, hexX, hexY, 1, intArg, 0, 1}, append, false);
        message = "queued";
        return true;
    }
    if (type == "barter_transfer") {
        if (Chosen.TransferType != TransferTypes::CritBarter || !Gui::IsScreenActive(GuiScreen::Barter)) {
            message = "barter_not_active";
            return false;
        }

        int collectionType = -1;
        if (stringArg == "player_inventory") {
            collectionType = ClientDefines::ITEMS_BARTER;
        }
        else if (stringArg == "player_offer") {
            collectionType = ClientDefines::ITEMS_BARTER_OFFER;
        }
        else if (stringArg == "trader_inventory") {
            collectionType = ClientDefines::ITEMS_BARTER_OPPONENT;
        }
        else if (stringArg == "trader_offer") {
            collectionType = ClientDefines::ITEMS_BARTER_OPPONENT_OFFER;
        }
        else {
            message = "unknown_barter_source:" + stringArg;
            return false;
        }

        if (!ClientItems::BarterTransfer(itemId, collectionType, intArg)) {
            message = "barter_transfer_rejected";
            return false;
        }

        message = "barter_transferred";
        return true;
    }
    if (type == "barter_offer") {
        if (Chosen.TransferType != TransferTypes::CritBarter || !Gui::IsScreenActive(GuiScreen::Barter)) {
            message = "barter_not_active";
            return false;
        }

        if (!ClientItems::BarterOffer()) {
            message = "barter_offer_pending_or_empty";
            return false;
        }
        message = "barter_offered";
        return true;
    }
    if (type == "talk_to") {
        ChosenActions::SetAction({Tla::ChosenTalkNpc, targetId, 0, 0, 0, 0, 0}, append, false);
        message = "queued";
        return true;
    }
    if (type == "loot_critter") {
        ChosenActions::SetAction({Tla::ChosenPickCrit, targetId, 0, 0, 0, 0, 0}, append, false);
        message = "queued";
        return true;
    }
    if (type == "attack_entity") {
        if (!HasCurPlayer) {
            message = "not_connected";
            return false;
        }
        CurPlayer.ServerCall.Attack(targetId, intArg);
        message = "sent";
        return true;
    }
    if (type == "pick_item") {
        Item? item = Game.GetItem(itemId);
        if (item == null) {
            message = "item_missing";
            return false;
        }
        ChosenActions::SetAction({Tla::ChosenPickItem, item.ProtoId, item.Hex.x, item.Hex.y, item.Id, 0, 0}, append, false);
        message = "queued";
        return true;
    }
    if (type == "pick_hex") {
        Item? item = FindMapItemAtHex(hexX, hexY);
        if (item == null) {
            message = "no_item_at_hex";
            return false;
        }
        ChosenActions::SetAction({Tla::ChosenPickItem, item.ProtoId, item.Hex.x, item.Hex.y, item.Id, 0, 0}, append, false);
        message = "queued";
        return true;
    }
    if (type == "use_item") {
        Item? usedItem = Chosen.GetItem(itemId);
        if (usedItem == null) {
            message = "item_missing";
            return false;
        }

        if (targetId != ZERO_IDENT && auxId != ZERO_IDENT) {
            message = "invalid_item_target";
            return false;
        }

        int useParam = intArg;
        if (!stringArg.isEmpty()) {
            if (!TryParseTimerUseMode(stringArg, useParam)) {
                message = "invalid_use_mode:" + stringArg;
                return false;
            }
            if (targetId != ZERO_IDENT || auxId != ZERO_IDENT) {
                message = "invalid_timer_target";
                return false;
            }
            if (!Parameters::IsTimedUseItem(usedItem)) {
                message = "item_not_timed";
                return false;
            }
        }

        int mode = WeaponHelpers::MakeWeaponMode(WeaponHelpers::USE_USE, 0);
        if (targetId != ZERO_IDENT) {
            Critter? targetCr = Game.GetCritter(targetId);
            if (targetCr == null) {
                message = "target_missing";
                return false;
            }
            ChosenActions::SetAction({Tla::ChosenUseItem, itemId, 0, ClientDefines::TARGET_CRITTER, targetId, mode, useParam}, append, false);
        }
        else if (auxId != ZERO_IDENT) {
            Item? targetItem = Game.GetItem(auxId);
            if (targetItem == null) {
                message = "target_item_missing";
                return false;
            }
            ChosenActions::SetAction({Tla::ChosenUseItem, itemId, 0, ClientDefines::TARGET_ITEM, auxId, mode, useParam}, append, false);
        }
        else {
            ChosenActions::SetAction({Tla::ChosenUseItem, itemId, 0, ClientDefines::TARGET_SELF, 0, mode, useParam}, append, false);
        }
        message = "queued";
        return true;
    }
    if (type == "reload") {
        if (!HasCurPlayer) {
            message = "not_connected";
            return false;
        }
        CurPlayer.ServerCall.ReloadWeapon(itemId, auxId);
        message = "sent";
        return true;
    }
    if (type == "unload") {
        ChosenActions::SetAction({Tla::ChosenUnloadWeapon, itemId, 0, 0, 0, 0, 0}, append, false);
        message = "queued";
        return true;
    }
    if (type == "move_item") {
        if (!HasCurPlayer) {
            message = "not_connected";
            return false;
        }
        CurPlayer.ServerCall.MoveInvItem(itemId, CritterItemSlot(intArg));
        message = "sent";
        return true;
    }
    if (type == "drop_item") {
        if (!HasCurPlayer) {
            message = "not_connected";
            return false;
        }
        CurPlayer.ServerCall.DropInvItem(itemId, intArg);
        message = "sent";
        return true;
    }
    if (type == "operate_container") {
        if (!HasCurPlayer) {
            message = "not_connected";
            return false;
        }
        bool take = (intArg & 1) != 0;
        bool all = (intArg & 2) != 0;
        int count = intArg >> 2;
        CurPlayer.ServerCall.OperateContainer(take, all, itemId, count, int(Chosen.TransferType), Chosen.TransferContainerId, Chosen.TransferSession);
        message = "sent";
        return true;
    }
    if (type == "craft") {
        // Механика крафта (FixBoy): выполнить рецепт по id (intArg). Состояние Tla::FixboyButton запускает
        // изготовление: сервер проверит навыки/материалы/инструменты (CheckOnCraft + NeedResources/Tools),
        // спишет ресурсы и выдаст результат. Список рецептов запрашивается тем же RemoteCall со state=
        // Tla::FixboyList, craftId=0. Предусловия (навык/материалы) ставятся через qa_set_prop/qa_give_item.
        if (!HasCurPlayer) {
            message = "not_connected";
            return false;
        }
        CurPlayer.ServerCall.Rpc_CraftItem(Tla::FixboyButton, intArg, 0);
        message = "craft_sent";
        return true;
    }
    if (type == "toggle_sneak") {
        // Скрытность в TLA сейчас НЕ реализована: и обработчик Tla::ChosenSneak (ChosenActions.fos), и
        // RemoteCall UseSneak закомментированы в самой игре, поэтому InSneakMode никогда не меняется. Ставим
        // действие в очередь (как было), но честно сообщаем, что механика заглушена на стороне игры.
        ChosenActions::SetAction({Tla::ChosenSneak, 0, 0, 0, 0, 0, 0}, append, false);
        message = "sneak_not_implemented_in_game";
        return true;
    }

    message = "unsupported:" + type;
    return false;
}

Item? FindMapItemAtHex(int hexX, int hexY)
{
    for (int i = 0; i < VisibleMapItemIds.length(); i++) {
        Item? item = Game.GetItem(VisibleMapItemIds[i]);
        if (item != null && int(item.Hex.x) == hexX && int(item.Hex.y) == hexY) {
            return item;
        }
    }
    return null;
}

// --- Запросы окружения (env-path) ------------------------------------------------------------
// Клиентские geometry/path запросы по текущей реплицированной карте: достижимость, трассировка,
// препятствия. Результат публикуется событием environment_query_result по queryId. Адвайзори, но
// помогает агенту выбирать достижимые цели до отправки движения. Опции: "kind;name=value;...".

bool ExecuteEnvironmentQuery(int queryId, int fromX, int fromY, int toX, int toY, string queryOptions, string& message)
{
    string query = EnvironmentQueryKind(queryOptions);
    string error;

    if (!HasCurMap) {
        error = "map_missing";
        PushEnvironmentQueryResult(queryId, query, false, error, "null");
        message = error;
        return false;
    }

    mpos fromHex;
    if (!ResolveEnvironmentFromHex(fromX, fromY, fromHex, error)) {
        PushEnvironmentQueryResult(queryId, query, false, error, "null");
        message = error;
        return false;
    }

    if (query == "obstacles") {
        mpos centerHex = (toX < 0 || toY < 0) ? fromHex : mpos(toX, toY);
        if (!CurMap.IsHexValid(centerHex)) {
            error = "center_hex_invalid";
            PushEnvironmentQueryResult(queryId, query, false, error, "null");
            message = error;
            return false;
        }

        PushEnvironmentQueryResult(queryId, query, true, "ok", EnvironmentObstaclesQueryJson(centerHex, queryOptions));
        message = "queried";
        return true;
    }

    mpos toHex = mpos(toX, toY);
    if (!CurMap.IsHexValid(toHex)) {
        error = "target_hex_invalid";
        PushEnvironmentQueryResult(queryId, query, false, error, "null");
        message = error;
        return false;
    }

    if (query == "path") {
        PushEnvironmentQueryResult(queryId, query, true, "ok", EnvironmentPathQueryJson(fromHex, toHex, queryOptions));
        message = "queried";
        return true;
    }
    if (query == "trace") {
        PushEnvironmentQueryResult(queryId, query, true, "ok", EnvironmentTraceQueryJson(fromHex, toHex, queryOptions));
        message = "queried";
        return true;
    }

    error = "unknown_environment_query";
    PushEnvironmentQueryResult(queryId, query, false, error, "null");
    message = error;
    return false;
}

bool ResolveEnvironmentFromHex(int fromX, int fromY, mpos& fromHex, string& error)
{
    if (fromX >= 0 && fromY >= 0) {
        fromHex = mpos(fromX, fromY);
        if (!CurMap.IsHexValid(fromHex)) {
            error = "from_hex_invalid";
            return false;
        }
        return true;
    }

    if (!HasChosen) {
        error = "chosen_missing";
        return false;
    }

    fromHex = Chosen.Hex;
    return true;
}

void PushEnvironmentQueryResult(int queryId, string query, bool success, string message, string resultJson)
{
    PushEvent(Object({StringMember("type", "environment_query_result"),
                      IntMember("queryId", queryId),
                      StringMember("query", query),
                      BoolMember("success", success),
                      StringMember("message", message),
                      RawMember("result", resultJson)}));
}

string EnvironmentPathQueryJson(mpos fromHex, mpos toHex, string queryOptions)
{
    int cut = GetEnvironmentOptionInt(queryOptions, "cut", 0, 0, 1000);
    int directDistance = Game.GetDistance(fromHex, toHex);
    // Если стартуем из гекса управляемого персонажа — считаем путь с учётом его multihex.
    bool useCritterPath = HasChosen && Chosen.Hex == fromHex;
    int pathLength = 0;

    if (fromHex != toHex) {
        pathLength = useCritterPath ? CurMap.GetPathLength(Chosen, toHex, cut) : CurMap.GetPathLength(fromHex, toHex, cut);
    }

    bool reachable = fromHex == toHex || pathLength > 0;
    mdir[] path = mdir[]();
    int maxDirections = GetEnvironmentOptionInt(queryOptions, "maxDirections", 80, 0, 240);

    if (reachable && fromHex != toHex && GetEnvironmentOptionBool(queryOptions, "includeDirections", true)) {
        path = useCritterPath ? CurMap.GetPath(Chosen, toHex, cut) : CurMap.GetPath(fromHex, toHex, cut);
    }

    return Object({StringMember("query", "path"),
                   RawMember("from", HexJson(fromHex)),
                   RawMember("to", HexJson(toHex)),
                   IntMember("cut", cut),
                   BoolMember("critterPath", useCritterPath),
                   IntMember("directDistance", directDistance),
                   IntMember("pathLength", pathLength),
                   BoolMember("reachable", reachable),
                   BoolMember("fromMovable", CurMap.IsHexMovable(fromHex)),
                   BoolMember("toMovable", CurMap.IsHexMovable(toHex)),
                   RawMember("directions", DirectionsJson(path, maxDirections)),
                   RawMember("pathHexes", PathHexesJson(fromHex, path, maxDirections))});
}

string EnvironmentTraceQueryJson(mpos fromHex, mpos toHex, string queryOptions)
{
    int directDistance = Game.GetDistance(fromHex, toHex);
    int maxDistance = GetEnvironmentOptionInt(queryOptions, "maxDistance", directDistance, 0, 200);
    float angle = float(GetEnvironmentOptionInt(queryOptions, "angle", 0, -60, 60));
    mpos traceHex = toHex;
    CurMap.GetHexInPath(fromHex, traceHex, angle, maxDistance);
    bool reachedTarget = traceHex == toHex;

    return Object({StringMember("query", "trace"),
                   RawMember("from", HexJson(fromHex)),
                   RawMember("to", HexJson(toHex)),
                   RawMember("traceHex", HexJson(traceHex)),
                   IntMember("directDistance", directDistance),
                   IntMember("maxDistance", maxDistance),
                   BoolMember("reachedTarget", reachedTarget),
                   BoolMember("blocked", !reachedTarget),
                   BoolMember("traceHexMovable", CurMap.IsHexMovable(traceHex)),
                   BoolMember("traceHexShootable", CurMap.IsHexShootable(traceHex))});
}

string EnvironmentObstaclesQueryJson(mpos centerHex, string queryOptions)
{
    int radius = GetEnvironmentOptionInt(queryOptions, "radius", 6, 0, 30);
    int maxResults = GetEnvironmentOptionInt(queryOptions, "maxResults", 80, 1, 300);
    string[] entries = {};

    int minX = Math::Max(0, centerHex.x - radius);
    int maxX = Math::Min(int(CurMap.Size.width) - 1, centerHex.x + radius);
    int minY = Math::Max(0, centerHex.y - radius);
    int maxY = Math::Min(int(CurMap.Size.height) - 1, centerHex.y + radius);

    for (int y = minY; y <= maxY && int(entries.length()) < maxResults; y++) {
        for (int x = minX; x <= maxX && int(entries.length()) < maxResults; x++) {
            mpos hex = mpos(x, y);
            if (Game.GetDistance(centerHex, hex) > radius) {
                continue;
            }

            bool movable = CurMap.IsHexMovable(hex);
            bool shootable = CurMap.IsHexShootable(hex);
            Critter[] critters = CurMap.GetCrittersOnHex(hex, CritterFindType::Any);
            if (!movable || !shootable || critters.length() != 0) {
                entries.insertLast(Object({RawMember("hex", HexJson(hex)),
                                           BoolMember("movable", movable),
                                           BoolMember("shootable", shootable),
                                           IntMember("critters", int(critters.length()))}));
            }
        }
    }

    return Object({StringMember("query", "obstacles"),
                   RawMember("center", HexJson(centerHex)),
                   IntMember("radius", radius),
                   IntMember("count", int(entries.length())),
                   BoolMember("truncated", int(entries.length()) >= maxResults),
                   RawMember("obstacles", Array(entries))});
}

string HexJson(mpos hex)
{
    return Object({IntMember("x", int(hex.x)), IntMember("y", int(hex.y))});
}

string DirectionsJson(mdir[] path, int maxCount)
{
    string[] entries = {};
    int count = Math::Min(int(path.length()), maxCount);
    for (int i = 0; i < count; i++) {
        entries.insertLast("" + path[i].hex.value);
    }
    return Array(entries);
}

string PathHexesJson(mpos fromHex, mdir[] path, int maxCount)
{
    string[] entries = {};
    int count = Math::Min(int(path.length()), maxCount);
    mpos hex = fromHex;
    for (int i = 0; i < count; i++) {
        if (CurMap.MoveHexByDir(hex, path[i].hex, 1) <= 0) {
            break;
        }
        entries.insertLast(HexJson(hex));
    }
    return Array(entries);
}

string EnvironmentQueryKind(string queryOptions)
{
    string[] parts = queryOptions.split(";");
    return parts.length() == 0 ? "" : parts[0].trim();
}

string GetEnvironmentOption(string queryOptions, string name, string defaultValue)
{
    string[] parts = queryOptions.split(";");
    string prefix = name + "=";
    for (int i = 1; i < parts.length(); i++) {
        string part = parts[i].trim();
        if (part.length() >= prefix.length() && part.substr(0, prefix.length()) == prefix) {
            return part.substr(prefix.length());
        }
    }
    return defaultValue;
}

int GetEnvironmentOptionInt(string queryOptions, string name, int defaultValue, int minValue, int maxValue)
{
    int value = GetEnvironmentOption(queryOptions, name, "" + defaultValue).toInt(defaultValue);
    return Math::Max(minValue, Math::Min(maxValue, value));
}

bool GetEnvironmentOptionBool(string queryOptions, string name, bool defaultValue)
{
    string value = GetEnvironmentOption(queryOptions, name, defaultValue ? "1" : "0").lower();
    return value == "1" || value == "true" || value == "yes";
}

// Имя тест-персонажа по умолчанию — производное от индекса встроенного клиента. Должно проходить
// Parameters::CheckPlayerName: длина 4..12, ≥70% символов — буквы культуры (см. правило
// StrNetManySymbols), поэтому базируемся на буквенном префиксе, а не на "Bot_<N>".
string DefaultBotName()
{
    return "TestBot" + Game.GetEmbeddedClientIndex();
}

// Валидный набор reg-свойств для RegisterNewPlayer. Строим ТОЧНО серверный набор
// (PlayerRegistration::InitPlayerRegistration): SpecialBase + TagSkill1..3 + Traits + Age + Gender.
// Нельзя опираться на Game.RegProperties — это OwnerSync-свойство и до логина на клиенте пустое.
// SPECIAL распределяем в сумму Player.StartSpecialPoints (каждый стат 1..10), тег-скиллы = None
// (валидатор допускает отсутствие тегов), трейты не взяты.
dict<CritterProperty, int> BuildRegistrationProps()
{
    dict<CritterProperty, int> props = {};

    CritterProperty[] special = CritterPropertyGroup::SpecialBase;
    int count = int(special.length());
    if (count > 0) {
        int total = Settings.Player.StartSpecialPoints;
        int baseValue = total / count;
        int remainder = total - baseValue * count;
        for (int i = 0; i < count; i++) {
            int value = baseValue + (i < remainder ? 1 : 0);
            value = Math::Max(1, Math::Min(10, value));
            props[special[i]] = value;
        }
    }

    props[CritterProperty::TagSkill1] = int(CritterProperty::None);
    props[CritterProperty::TagSkill2] = int(CritterProperty::None);
    props[CritterProperty::TagSkill3] = int(CritterProperty::None);

    CritterProperty[] traits = CritterPropertyGroup::Traits;
    for (int i = 0; i < traits.length(); i++) {
        props[traits[i]] = 0;
    }

    props[CritterProperty::Age] = 25;
    props[CritterProperty::Gender] = 0;

    return props;
}

// --- Построение наблюдения -------------------------------------------------------------------

string BuildObservation()
{
    ObservationBuildSeq++;

    Gui::Screen? activeScreen = Gui::GetActiveScreen();
    string activeScreenName = activeScreen != null ? Game.EnumToString(activeScreen.Num, true) : "";

    return Object({IntMember("schemaVersion", 1),
                   IntMember("seq", ObservationBuildSeq),
                   IntMember("clientIndex", Game.GetEmbeddedClientIndex()),
                   BoolMember("connected", HasCurPlayer),
                   BoolMember("hasMap", HasCurMap),
                   BoolMember("hasChosen", HasChosen),
                   RawMember("account", AccountJson()),
                   RawMember("screen", ScreenJson(activeScreen, activeScreenName)),
                   RawMember("uiPrompt", UiPromptJson(activeScreen)),
                   RawMember("mouse", Object({IntMember("x", Game.MousePos.x), IntMember("y", Game.MousePos.y)})),
                   RawMember("chosen", ChosenJson()),
                   RawMember("map", HasCurMap ? MapJson(CurMap) : "null"),
                   RawMember("critters", CrittersJson()),
                   RawMember("mapItems", MapItemsJson()),
                   RawMember("inventory", InventoryJson()),
                   RawMember("barter", BarterJson()),
                   RawMember("quests", QuestsJson()),
                   RawMember("dialog", DialogJson()),
                   RawMember("availableActions", AvailableActionsJson())});
}

string AccountJson()
{
    if (!HasCurPlayer) {
        return "null";
    }
    return Object({BoolMember("connected", true)});
}

string ScreenJson(Gui::Screen? activeScreen, string activeScreenName)
{
    string[] names = {};
    Gui::Screen[] screens = Gui::GetActiveScreens();
    for (int i = 0; i < screens.length(); i++) {
        names.insertLast(StringValue(Game.EnumToString(screens[i].Num, true)));
    }

    return Object({StringMember("active", activeScreenName), BoolMember("modalActive", Gui::IsModalScreenActive()), RawMember("screens", Array(names))});
}

string UiPromptButtonJson(int index, string id, string text, string role, bool dangerous)
{
    return Object({IntMember("index", index),
                   StringMember("id", id),
                   StringMember("text", text),
                   StringMember("role", role),
                   BoolMember("enabled", true),
                   BoolMember("dangerous", dangerous)});
}

string UiPromptJson(Gui::Screen? activeScreen)
{
    if (activeScreen == null) {
        return Object({BoolMember("active", false)});
    }

    if (activeScreen.Num == GuiScreen::DialogBox) {
        auto dialogBox = cast<GuiScreens::DialogBox::DialogBox>(activeScreen);
        if (dialogBox.Answers < 1 || dialogBox.Answers > Dialogbox::MAX_DIALOG_BOX_ANSWERS || dialogBox.Session == 0) {
            return Object({BoolMember("active", false)});
        }

        string promptText = MsgStr::GetGameText(Dialogbox::GetDialogTextStr(dialogBox.DialogType));
        promptText = Game.FormatTags(promptText, dialogBox.Lexems);
        string[] buttons = {};
        for (int i = 0; i < dialogBox.Answers; i++) {
            string answerText = MsgStr::GetGameText(Dialogbox::GetDialogTextStr(dialogBox.DialogType) + i + 1);
            buttons.insertLast(UiPromptButtonJson(i,
                                                  "answer_" + i,
                                                  answerText,
                                                  Dialogbox::GetDialogBoxAnswerRole(dialogBox.DialogType, i),
                                                  Dialogbox::IsDialogBoxAnswerDangerous(dialogBox.DialogType, i)));
        }

        return Object({BoolMember("active", true),
                       StringMember("screen", "DialogBox"),
                       StringMember("kind", "dialog_box"),
                       StringMember("title", Game.EnumToString(dialogBox.DialogType, true)),
                       StringMember("text", promptText),
                       StringMember("dialogId", Game.EnumToString(dialogBox.DialogType, true)),
                       Int64Member("dialogBoxSession", int64(dialogBox.Session)),
                       RawMember("buttons", Array(buttons))});
    }

    if (activeScreen.Num == GuiScreen::Elevator) {
        auto elevator = cast<GuiScreens::Elevator::Elevator>(activeScreen);
        if (!elevator.Valid || int(elevator.Data.length()) < 14) {
            return Object({BoolMember("active", false)});
        }

        int answerCount = int(elevator.Data[13]);
        int elevatorType = elevator.Type & 0xFFFF;
        if (answerCount < 1 || answerCount > 16 || int(elevator.Data.length()) < 14 + answerCount * 4 ||
            answerCount != Elevator::GetElevatorExpectedLevelCount(elevatorType)) {
            return Object({BoolMember("active", false)});
        }

        string[] buttons = {};
        for (int i = 0; i < answerCount; i++) {
            int level = Elevator::GetElevatorDisplayLevel(elevatorType, i);
            buttons.insertLast(UiPromptButtonJson(i, "level_" + level, "" + level, "choice", false));
        }

        return Object({BoolMember("active", true),
                       StringMember("screen", "Elevator"),
                       StringMember("kind", "elevator"),
                       StringMember("title", "Elevator"),
                       StringMember("text", ""),
                       StringMember("currentMapProtoId", HasCurMap ? string(CurMap.ProtoId) : ""),
                       RawMember("buttons", Array(buttons))});
    }

    return Object({BoolMember("active", false)});
}

string ChosenJson()
{
    if (!HasChosen) {
        return "null";
    }

    Critter cr = Chosen;
    return Object({IdentMember("id", cr.Id),
                   StringMember("name", cr.Name),
                   IntMember("hexX", int(cr.Hex.x)),
                   IntMember("hexY", int(cr.Hex.y)),
                   IntMember("level", cr.Level),
                   IntMember("currentHp", cr.CurrentHp),
                   IntMember("maxHp", cr.MaxLife),
                   IntMember("experience", cr.Experience),
                   IntMember("currentAp", cr.CurrentAp / Tla::AP_DIVIDER),
                   IntMember("actionPoints", cr.ActionPoints),
                   BoolMember("isAlive", cr.IsAlive()),
                   BoolMember("inCombat", Time::IsTimeoutActive(cr.TimeoutBattle)),
                   BoolMember("inSneakMode", cr.InSneakMode)});
}

string MapJson(Map map)
{
    return Object({IdentMember("id", map.Id),
                   StringMember("protoId", string(map.ProtoId)),
                   IntMember("width", int(map.Size.width)),
                   IntMember("height", int(map.Size.height))});
}

string CrittersJson()
{
    string[] entries = {};
    if (HasCurMap) {
        int maxEntities = GetMaxObservedEntities();
        Critter[] critters = CurMap.GetCritters(CritterFindType::Any);
        for (int i = 0; i < critters.length() && int(entries.length()) < maxEntities; i++) {
            if (HasChosen && critters[i].Id == Chosen.Id) {
                continue;
            }
            entries.insertLast(CritterJson(critters[i]));
        }
    }
    return Array(entries);
}

string CritterJson(Critter cr)
{
    string dialogId = string(cr.DialogId);
    int talkDistance = cr.TalkDistance != 0 ? cr.TalkDistance : Settings.Dialog.TalkDistance;
    return Object({IdentMember("id", cr.Id),
                   StringMember("protoId", string(cr.ProtoId)),
                   StringMember("name", cr.Name),
                   IntMember("hexX", int(cr.Hex.x)),
                   IntMember("hexY", int(cr.Hex.y)),
                   BoolMember("isAlive", cr.IsAlive()),
                   BoolMember("inCombat", Time::IsTimeoutActive(cr.TimeoutBattle)),
                   BoolMember("isNoTalk", cr.IsNoTalk),
                   IntMember("talkDistance", talkDistance),
                   StringMember("dialogId", dialogId)});
}

string MapItemsJson()
{
    string[] entries = {};
    int maxEntities = GetMaxObservedEntities();
    for (int i = 0; i < VisibleMapItemIds.length() && int(entries.length()) < maxEntities; i++) {
        Item? item = Game.GetItem(VisibleMapItemIds[i]);
        if (item != null) {
            entries.insertLast(MapItemJson(item));
        }
    }
    return Array(entries);
}

void AddItemInteractionMembers(Item item, string[] & members)
{
    // В TLA двери и контейнеры пока представлены плоским Type/набором свойств, а не
    // отдельными компонентами. Поэтому сначала определяем наличие контракта и только
    // затем читаем относящиеся к нему состояния замка.
    bool hasContainer = item.Type == ItemType::Container;
    bool hasDoor = item.Type == ItemType::Door;
    bool hasLocker = hasContainer || hasDoor;
    members.insertLast(BoolMember("hasContainer", hasContainer));
    members.insertLast(BoolMember("hasDoor", hasDoor));
    members.insertLast(BoolMember("hasLocker", hasLocker));
    members.insertLast(BoolMember("canOpen", hasLocker && item.IsCanOpen));
    members.insertLast(BoolMember("opened", hasLocker && item.Opened));
    members.insertLast(BoolMember("lockerLocked", hasLocker && item.Locker_Locked));
    members.insertLast(BoolMember("lockerJammed", hasLocker && item.Locker_Jammed));
    members.insertLast(BoolMember("lockerBroken", hasLocker && item.Locker_Broken));
    members.insertLast(BoolMember("lockerNoOpen", hasLocker && item.Locker_NoOpen));
    members.insertLast(BoolMember("isGag", hasLocker && item.IsGag));
}

string MapItemJson(Item item)
{
    string[] members = {IdentMember("id", item.Id),
                        StringMember("protoId", string(item.ProtoId)),
                        IntMember("hexX", int(item.Hex.x)),
                        IntMember("hexY", int(item.Hex.y)),
                        IntMember("count", int(item.Count)),
                        BoolMember("stackable", item.Stackable),
                        IntMember("ownership", int(item.Ownership)),
                        IntMember("cost", item.Cost),
                        IntMember("weight", item.Weight),
                        BoolMember("canUse", item.IsCanUse),
                        BoolMember("canUseOnSmth", item.IsCanUseOnSmth),
                        BoolMember("canPickUp", item.IsCanPickUp),
                        RawMember("visualFeedback", ItemVisualFeedbackJson(item))};
    AddItemInteractionMembers(item, members);
    return Object(members);
}

string InventoryJson()
{
    if (!HasChosen) {
        return "[]";
    }

    string[] entries = {};
    int maxEntities = GetMaxObservedEntities();
    Item[] items = Chosen.GetItems();
    for (int i = 0; i < items.length() && int(entries.length()) < maxEntities; i++) {
        entries.insertLast(InventoryItemJson(items[i]));
    }
    return Array(entries);
}

string InventoryItemJson(Item item)
{
    string[] members = {IdentMember("id", item.Id),
                        StringMember("protoId", string(item.ProtoId)),
                        IntMember("count", int(item.Count)),
                        IntMember("slot", int(item.CritterSlot)),
                        BoolMember("stackable", item.Stackable),
                        IntMember("ownership", int(item.Ownership)),
                        IntMember("cost", item.Cost),
                        IntMember("weight", item.Weight),
                        BoolMember("canUse", item.IsCanUse),
                        BoolMember("canUseOnSmth", item.IsCanUseOnSmth),
                        BoolMember("canPickUp", item.IsCanPickUp),
                        RawMember("visualFeedback", ItemVisualFeedbackJson(item))};
    AddItemInteractionMembers(item, members);
    return Object(members);
}

string ItemVisualFeedbackJson(Item item)
{
    return Object({BoolMember("timerCapable", Parameters::IsTimedUseItem(item))});
}

string BarterItemsJson(Item[] items)
{
    string[] entries = {};
    int maxEntities = GetMaxObservedEntities();
    for (int i = 0; i < items.length() && int(entries.length()) < maxEntities; i++) {
        entries.insertLast(
            Object({IdentMember("id", items[i].Id), StringMember("protoId", string(items[i].ProtoId)), IntMember("count", int(items[i].Count))}));
    }
    return Array(entries);
}

// Снимок четырёх коллекций NPC-бартера позволяет MCP проверять перенос в оффер и обратно без
// хрупкого распознавания текста/иконок на скриншоте. Итоговую сделку всё равно валидирует сервер.
string BarterJson()
{
    if (!HasChosen || Chosen.TransferType != TransferTypes::CritBarter) {
        return Object({BoolMember("active", false)});
    }

    return Object({BoolMember("active", true),
                   IdentMember("traderId", Chosen.TransferContainerId),
                   Int64Member("session", int64(Chosen.TransferSession)),
                   IntMember("coefficient", ClientItems::BarterCoefficient),
                   BoolMember("masterTrader", ClientItems::BarterHasMasterTrader),
                   Int64Member("playerOfferTotal", ClientItems::GetBarterCollectionCost(ClientDefines::ITEMS_BARTER_OFFER)),
                   Int64Member("traderOfferTotal", ClientItems::GetBarterCollectionCost(ClientDefines::ITEMS_BARTER_OPPONENT_OFFER)),
                   RawMember("playerInventory", BarterItemsJson(ClientItems::GetCollection(ClientItems::Collection::Inventory))),
                   RawMember("playerOffer", BarterItemsJson(ClientItems::GetCollection(ClientItems::Collection::BarterOffer))),
                   RawMember("traderInventory", BarterItemsJson(ClientItems::GetCollection(ClientItems::Collection::Loot))),
                   RawMember("traderOffer", BarterItemsJson(ClientItems::GetCollection(ClientItems::Collection::BarterTraderOffer)))});
}

// Активные квесты управляемого персонажа. В TLA квесты — это отдельные uint8-свойства в группе
// Quests (значение = стадия прогресса, 0 = не начат), а не массив QuestProgress. Отдаём ненулевые.
string QuestsJson()
{
    if (!HasChosen) {
        return "[]";
    }

    string[] entries = {};
    Critter cr = Chosen;
    CritterProperty[] questProps = CritterPropertyGroup::Quests;
    for (int i = 0; i < questProps.length(); i++) {
        int value = cr.GetAsInt(questProps[i]);
        if (value != 0) {
            entries.insertLast(Object({StringMember("name", Game.EnumToString(questProps[i], true)), IntMember("value", value)}));
        }
    }
    return Array(entries);
}

string DialogJson()
{
    if (!DialogActive) {
        return Object({BoolMember("active", false)});
    }

    string[] answers = {};
    for (int i = 0; i < DialogAnswers.length(); i++) {
        answers.insertLast(StringValue(DialogAnswers[i]));
    }

    return Object({BoolMember("active", true),
                   StringMember("dialogId", string(DialogId)),
                   IdentMember("talkerId", DialogTalkerId),
                   StringMember("text", DialogText),
                   RawMember("answers", Array(answers))});
}

string AvailableActionsJson()
{
    // Минимальная сводка действий: подсказки строятся адаптером из critters/mapItems/dialog,
    // здесь же отдаём список поддерживаемых типов команд.
    string[] commands = {"register",
                         "login",
                         "move_to_hex",
                         "talk_to",
                         "loot_critter",
                         "attack_entity",
                         "pick_item",
                         "pick_hex",
                         "use_item",
                         "use_skill",
                         "reload",
                         "unload",
                         "move_item",
                         "drop_item",
                         "operate_container",
                         "toggle_sneak",
                         "dialog_answer",
                         "close_dialog",
                         "ui_answer",
                         "say",
                         "clear_actions",
                         "close_screen",
                         "show_screen",
                         "show_context_screen",
                         "hide_screen",
                         "save_screenshot",
                         "set_resolution",
                         "toggle_fullscreen",
                         "set_mouse_pos",
                         "mouse_click",
                         "key_press",
                         "barter_transfer",
                         "barter_offer",
                         "barter_return_dialog",
                         "craft",
                         "environment_query",
                         "qa_teleport_global",
                         "qa_teleport_hex",
                         "qa_teleport_map",
                         "qa_set_prop",
                         "qa_set_game_prop",
                         "qa_give_item",
                         "qa_get_prop",
                         "qa_get_text",
                         "qa_get_text_pack",
                         "qa_format_tags",
                         "qa_show_dialog_box"};
    string[] entries = {};
    for (int i = 0; i < commands.length(); i++) {
        entries.insertLast(StringValue(commands[i]));
    }
    return Object({RawMember("commands", Array(entries))});
}

// --- Параметры ------------------------------------------------------------------------------

int GetObservationInterval()
{
    return Settings.AiControl.ObservationInterval > 0 ? Settings.AiControl.ObservationInterval : DefaultObservationInterval;
}

int GetMaxObservedEntities()
{
    return Settings.AiControl.MaxObservedEntities > 0 ? Settings.AiControl.MaxObservedEntities : DefaultMaxObservedEntities;
}

// --- События / отправка ---------------------------------------------------------------------

void PushSimpleEvent(string type)
{
    PushEvent(Object({StringMember("type", type)}));
}

void PushEvent(string eventJson)
{
    if (Settings.AiControl.Enabled && Game.AiControlIsRunning()) {
        Game.AiControlPushEvent(eventJson);
    }
}

// --- JSON-хелперы ---------------------------------------------------------------------------

string Object(string[] members)
{
    string result = "{";
    for (int i = 0; i < members.length(); i++) {
        if (i != 0) {
            result += ",";
        }
        result += members[i];
    }
    result += "}";
    return result;
}

string Array(string[] entries)
{
    string result = "[";
    for (int i = 0; i < entries.length(); i++) {
        if (i != 0) {
            result += ",";
        }
        result += entries[i];
    }
    result += "]";
    return result;
}

string RawMember(string name, string value)
{
    return "\"" + EscapeJson(name) + "\":" + value;
}

string StringMember(string name, string value)
{
    return "\"" + EscapeJson(name) + "\":" + StringValue(value);
}

string StringValue(string value)
{
    return "\"" + EscapeJson(value) + "\"";
}

string IntMember(string name, int value)
{
    return "\"" + EscapeJson(name) + "\":" + value;
}

string Int64Member(string name, int64 value)
{
    return "\"" + EscapeJson(name) + "\":" + value;
}

string IdentMember(string name, ident value)
{
    return "\"" + EscapeJson(name) + "\":" + value.str;
}

string BoolMember(string name, bool value)
{
    return "\"" + EscapeJson(name) + "\":" + (value ? "true" : "false");
}

string EscapeJson(string value)
{
    value = value.replace("\\", "\\\\");
    value = value.replace("\"", "\\\"");
    value = value.replace("\n", "\\n");
    value = value.replace("\r", "\\r");
    value = value.replace("\t", "\\t");

    // Любые оставшиеся управляющие байты (0x00-0x1F) экранируем как \u00XX, иначе strict-парсер
    // json.loads в Python-адаптере отвергнет всю строку из-за одного управляющего байта в
    // авторском/локализованном тексте.
    bool hasControl = false;
    for (int i = 0; i < value.rawLength(); i++) {
        if (value.rawGet(i) < 0x20) {
            hasControl = true;
            break;
        }
    }
    if (!hasControl) {
        return value;
    }

    const string HexDigits = "0123456789abcdef";
    string result = "";
    for (int i = 0; i < value.rawLength(); i++) {
        uint8 ch = value.rawGet(i);
        if (ch < 0x20) {
            result += "\\u00";
            result += HexDigits.substr((ch >> 4) & 0xF, 1);
            result += HexDigits.substr(ch & 0xF, 1);
        }
        else {
            result.rawResize(result.rawLength() + 1);
            result.rawSet(result.rawLength() - 1, ch);
        }
    }
    return result;
}

#endif

#if SERVER

// QA-команды. Все гейтированы AiControl.AllowQaCommands (Common, default False) — на боевом
// сервере это no-op. Используются только тест-харнессом для детерминированных fixtures.

[[ServerRemoteCall]] [[Async]]
void AiControlQaShowDialogBox(Player player)
{
    if (!Settings.AiControl.AllowQaCommands) {
        return;
    }
    Critter? cr = player.GetControlledCritter();
    if (cr == null || !Sync::Lock(cr)) {
        return;
    }
    if (!cr.ControlledByPlayer || cr.IsDead()) {
        return;
    }

    nanotime tick = Game.FrameTime;
    if (cr.DialogBoxPending) {
        bool expired = cr.DialogBoxPendingUntil == ZERO_NANOTIME || tick >= cr.DialogBoxPendingUntil;
        if (!expired) {
            return;
        }
        Dialogbox::ClearPendingDialogBox(cr);
    }
    if (cr.LastDialogBoxShownTick != ZERO_NANOTIME && tick < cr.LastDialogBoxShownTick + Dialogbox::NEXT_DIALOG_CALL) {
        return;
    }

    // AskFollowGlobalGroupRuler имеет безопасный для fixture второй ответ: индекс 1 только
    // погашает pending-контракт, не меняя группу или другие игровые данные.
    Dialogbox::RunDialogBox(cr, DialogBoxType::AskFollowGlobalGroupRuler, 2, "|who:QA");
}

[[ServerRemoteCall]] [[Async]]
void AiControlQaTeleportGlobal(Player player)
{
    if (!Settings.AiControl.AllowQaCommands) {
        return;
    }
    Critter? cr = player.GetControlledCritter();
    if (cr == null) {
        return;
    }
    if (!Sync::LockCritterWithMap(cr)) {
        return;
    }
    cr.TransferToGlobal();
}

[[ServerRemoteCall]] [[Async]]
void AiControlQaTeleportHex(Player player, mpos hex)
{
    if (!Settings.AiControl.AllowQaCommands) {
        Game.Log("QA hex: disabled");
        return;
    }
    Critter? cr = player.GetControlledCritter();
    if (cr == null) {
        return;
    }
    if (!Sync::LockCritterWithMap(cr)) {
        return;
    }
    cr.TransferToHex(hex);
}

[[ServerRemoteCall]] [[Async]]
void AiControlQaTeleportMap(Player player, hstring locPid, hstring mapPid, mpos hex)
{
    if (!Settings.AiControl.AllowQaCommands) {
        return;
    }
    Critter? cr = player.GetControlledCritter();
    if (cr == null) {
        return;
    }
    // Ищем карту именно внутри запрошенной локации: одинаковые map proto могут существовать в
    // нескольких runtime-инстансах. Если локация ещё не загружена (или прошлый QA-инстанс был
    // уничтожен авто-сборкой), создаём её на тестовой глобал-позиции и отключаем AutoGarbage.
    // Для короткой формы заранее запоминаем существующую прямую карту: её pid может не быть pid'ом
    // локации, и в таком случае нельзя вызывать CreateLocation с ним.
    Map? directMap = locPid == mapPid ? Game.GetMap(mapPid) : null;
    Location? loc = Game.GetLocation(locPid);
    // Локация — серверная сущность; перед чтением её свойств (IsDestroyed/GetMapCount/GetMapByIndex)
    // её нужно залочить (Sync::Lock покрывает локацию и её карты).
    if (loc != null && !Sync::Lock(loc)) {
        loc = null;
    }
    if (loc != null && (loc.IsDestroyed || loc.GetMapCount() == 0)) {
        loc = null;
    }
    if (loc == null && directMap == null && !Game.CheckProtoLocation(locPid)) {
        Game.Log("AiControl QA teleport: location proto not found " + locPid);
        return;
    }
    if (loc == null && directMap == null) {
        int zl = Settings.GlobalMap.GlobalMapZoneLength;
        loc = Location::CreateLocation(locPid, ipos(zl * 10, zl * 10));
        if (loc != null && !Sync::Lock(loc)) {
            loc = null;
        }
        if (loc != null) {
            loc.AutoGarbage = false;
        }
    }

    Map? targetMap = null;
    if (loc != null && loc.GetMapCount() > 0) {
        for (int i = 0; i < loc.GetMapCount(); i++) {
            Map mapAtIndex = loc.GetMapByIndex(i);
            if (mapAtIndex.ProtoId == mapPid) {
                targetMap = mapAtIndex;
                break;
            }
        }
        // Короткая форма с одинаковыми pid означает вход на первую карту локации.
        if (targetMap == null && locPid == mapPid) {
            targetMap = loc.GetMapByIndex(0);
        }
    }
    // Для прямого map proto без одноимённой location сохраняем старый QA-сценарий.
    if (targetMap == null && locPid == mapPid) {
        targetMap = directMap;
    }
    if (targetMap == null) {
        Game.Log("AiControl QA teleport: map/location not found " + locPid + "/" + mapPid);
        return;
    }
    if (!Sync::Lock(cr, targetMap)) {
        Game.Log("AiControl QA teleport: lock failed for " + locPid + "/" + mapPid);
        return;
    }
    // Перенос читает/меняет И карту-источник (текущую карту криттера, напр. repl1 сразу после
    // регистрации), И целевую карту с их локациями. Sync::Lock заменяет весь набор блокировок: сначала
    // лочим обе карты (cr уже залочен — можно взять его карту), чтобы прочитать их локации, затем полное
    // покрытие cr+карты+локации — иначе EntitySyncException «Entity access without sync» внутри TransferToMap.
    Map? srcMap = cr.GetMap();
    if (srcMap != null && srcMap.Id != targetMap.Id) {
        if (!Sync::Lock(array<Entity> = {cr, targetMap, srcMap})) {
            Game.Log("AiControl QA teleport: lock failed for " + locPid + "/" + mapPid);
            return;
        }
        if (!Sync::Lock(array<Entity> = {cr, targetMap, targetMap.GetLocation(), srcMap, srcMap.GetLocation()})) {
            Game.Log("AiControl QA teleport: lock failed for " + locPid + "/" + mapPid);
            return;
        }
    }
    else if (!Sync::Lock(cr, targetMap, targetMap.GetLocation())) {
        Game.Log("AiControl QA teleport: lock failed for " + locPid + "/" + mapPid);
        return;
    }
    // hex (0,0) => используем стандартный вход карты "0" (валидный гекс входа).
    if (hex.x == 0 && hex.y == 0) {
        Entrance::CritterTransferToMapEntry(cr, targetMap.Id, "0".hstr());
    }
    else {
        cr.TransferToMap(targetMap, hex, HDIR_Random);
    }
}

[[ServerRemoteCall]] [[Async]]
void AiControlQaSetProp(Player player, CritterProperty prop, int value, int requestId)
{
    if (!Settings.AiControl.AllowQaCommands) {
        return;
    }
    Critter? cr = player.GetControlledCritter();
    if (cr == null) {
        return;
    }
    if (!Sync::Lock(cr)) {
        return;
    }
    cr.SetAsInt(prop, value);
    cr.PlayerClientCall.AiControlReceiveQaPropSet(prop, cr.GetAsInt(prop), requestId);
}

[[ServerRemoteCall]] [[Async]]
void AiControlQaGetProp(Player player, CritterProperty prop, int requestId)
{
    if (!Settings.AiControl.AllowQaCommands) {
        return;
    }
    Critter? cr = player.GetControlledCritter();
    if (cr == null) {
        return;
    }
    if (!Sync::Lock(cr)) {
        return;
    }
    cr.PlayerClientCall.AiControlReceiveQaProp(prop, cr.GetAsInt(prop), requestId);
}

[[ServerRemoteCall]] [[Async]]
void AiControlQaGiveItem(Player player, hstring pid, int count)
{
    if (!Settings.AiControl.AllowQaCommands) {
        return;
    }
    Critter? cr = player.GetControlledCritter();
    if (cr == null) {
        return;
    }
    if (!Sync::LockCritterWithMap(cr)) {
        return;
    }
    cr.AddItem(pid, count);
}

[[ServerRemoteCall]] [[Async]]
void AiControlQaSetGameProp(Player player, GameProperty prop, int value)
{
    if (!Settings.AiControl.AllowQaCommands) {
        return;
    }
    Critter? cr = player.GetControlledCritter();
    if (cr == null) {
        return;
    }
    if (!Sync::Lock(cr)) {
        return;
    }
    Game.SetAsInt(prop, value);
}

