// V13GuardLib — набор серверных проверок для охраны (Vault 13): не даёт проносить оружие и запретные вещи и ловит попытки минирования.
// Сторона SERVER (весь код под #if SERVER). Чистые helper-функции без подписок на события —
// вызываются охранными скриптами/диалогами: IsMined (детект установки взрывчатки/мины с учётом
// навыка и удачи минёра), SearchWeapon (оружие в руках, с белым списком), EquipmentInspection/SearchedForbidden (поиск запрещённых предметов в инвентаре).

namespace V13GuardLib
{

#if SERVER

// Проверка, на попытку установки взрывчатки или мины.
bool IsMined(Critter? sapper, Item item, Critter? miner, int minerMinSkill, hstring[] BadPid)
{
    if (miner == null) {
        return false;
    }

    if (sapper == null) {
        return false;
    }

    // Проверяем - видим ли мы минёра.
    if (!miner.IsSeenBy(sapper)) {
        return false;
    }

    // Заминировать нас не так-то просто, нужно быть действительно мастером и удачливым ловкачем. Ну и конечно рандом.
    if ((miner.AgilityBase + miner.LuckBase + Game.Random(1, 10)) / 3 < 7 || miner.SkillTraps < minerMinSkill) {
        for (int i = 0; i < BadPid.length(); i++) {
            if (item.ProtoId == BadPid[i]) {
                return true;
            }
        }
    }

    return false;
}

// Старая перегрузка IsMined оставлена закомментированной как breadcrumb (просто делегировала в основную версию).
