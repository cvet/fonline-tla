// Test_Say — привязка одноразового ввода к владельцу и защита от повторного ответа.
namespace Test_Say
{
#if SERVER
[[ModuleInit]]
void InitTestSay()
{
    Game.OnTestingInit.Subscribe(OnTestingInit);
}

[[Event]]
void OnTestingInit()
{
    Testing::RegisterTest("say", "request_owner_and_single_use", RequestOwnerAndSingleUse);
}

void RequestOwnerAndSingleUse(Testing::TestContext ctx)
{
    ident owner;
    owner.value = -1001;
    ident other;
    other.value = -1002;
    Say::Request request = Say::Request();
    Say::NextRequestId++;
    request.Id = Say::NextRequestId;
    request.PlayerId = owner;
    Say::Requests.insertLast(request);
    Testing::Expect(ctx, Say::TakeRequest(other, request.Id) == null, "Чужой игрок не получает запрос");
    Say::Request? accepted = Say::TakeRequest(owner, request.Id);
    Testing::Expect(ctx, accepted != null, "Запрос остался доступен владельцу");
    Testing::Expect(ctx, Say::TakeRequest(owner, request.Id) == null, "Повторный ответ отклоняется");

    Say::Requests.insertLast(request);
    Say::RemoveForPlayer(other);
    Testing::Expect(ctx, Say::TakeRequest(owner, request.Id) != null, "Отмена другого игрока не затрагивает владельца");
    Say::Requests.insertLast(request);
    Say::RemoveForPlayer(owner);
    Testing::Expect(ctx, Say::TakeRequest(owner, request.Id) == null, "Отмена владельца отзывает запрос");
}
#endif
}
