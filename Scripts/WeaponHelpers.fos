// WeaponHelpers — доступ к свойствам оружия по индексу применения (use 0/1/2) и упаковка режима стрельбы.
// Общий модуль без #if-гардов, работает на всех сторонах (SERVER/CLIENT/MAPPER): классификация оружия по навыку
//  (рукопашное/огнестрельное/дальнобойное), выборка урона, дистанции, стоимости AP, анимации, звука и эффекта для
//  выбранного use, а также кодирование пары use+aim в один байт weaponMode и константы видов применения и типов звука.
// Поля читаются из компонента Weapon: предикаты доступности режимов ложны для предмета без него, остальные функции требуют оружие.
namespace WeaponHelpers
{

const int USE_NONE = 15;

// Оружие
bool IsWeaponHthAttack(AbstractItem item, int use)
{
    return WeaponSkill(item, use) == CritterProperty::SkillUnarmed || WeaponSkill(item, use) == CritterProperty::SkillMeleeWeapons;
}

bool IsWeaponGunAttack(AbstractItem item, int use)
{
    return WeaponSkill(item, use) == CritterProperty::SkillSmallGuns || WeaponSkill(item, use) == CritterProperty::SkillBigGuns ||
           WeaponSkill(item, use) == CritterProperty::SkillEnergyWeapons;
}

bool IsWeaponRangedAttack(AbstractItem item, int use)
{
    return IsWeaponGunAttack(item, use) || WeaponSkill(item, use) == CritterProperty::SkillThrowing;
}

// Доступность режимов применения (use 0/1/2). Сюда приходит любой активный предмет: без компонента Weapon режимов нет.
bool IsWeaponPrimaryAvailable(AbstractItem item)
{
    return item.HasWeapon && item.Weapon.ActiveUses >= 1;
}

bool IsWeaponSecondaryAvailable(AbstractItem item)
{
    return item.HasWeapon && item.Weapon.ActiveUses >= 2;
}

bool IsWeaponThirdAvailable(AbstractItem item)
{
    return item.HasWeapon && item.Weapon.ActiveUses >= 3;
}

// Поля режима применения use; предмет обязан иметь компонент Weapon (вызывающий проверяет HasWeapon или доказывает его).
CritterProperty WeaponSkill(AbstractItem item, int use)
{
    return (use) == 0 ? item.Weapon.Skill_0 : ((use) == 1 ? item.Weapon.Skill_1 : ((use) == 2 ? item.Weapon.Skill_2 : CritterProperty::None));
}

DamageTypes WeaponDamageType(AbstractItem item, int use)
{
    return (use) == 0 ? item.Weapon.DmgType_0 : ((use) == 1 ? item.Weapon.DmgType_1 : ((use) == 2 ? item.Weapon.DmgType_2 : DamageTypes::None));
}

CritterActionAnim WeaponActionAnim(AbstractItem item, int use)
{
    return (use) == 0 ? item.Weapon.ActionAnim_0 : ((use) == 1 ? item.Weapon.ActionAnim_1 : ((use) == 2 ? item.Weapon.ActionAnim_2 : CritterActionAnim::None));
}

int WeaponDamageMin(AbstractItem item, int use)
{
    return (use) == 0 ? item.Weapon.DmgMin_0 : ((use) == 1 ? item.Weapon.DmgMin_1 : ((use) == 2 ? item.Weapon.DmgMin_2 : 0));
}

int WeaponDamageMax(AbstractItem item, int use)
{
    return (use) == 0 ? item.Weapon.DmgMax_0 : ((use) == 1 ? item.Weapon.DmgMax_1 : ((use) == 2 ? item.Weapon.DmgMax_2 : 0));
}

int WeaponMaxDistance(AbstractItem item, int use)
{
    return (use) == 0 ? item.Weapon.MaxDist_0 : ((use) == 1 ? item.Weapon.MaxDist_1 : ((use) == 2 ? item.Weapon.MaxDist_2 : 0));
}

hstring WeaponEffect(AbstractItem item, int use)
{
    return (use) == 0 ? item.Weapon.Effect_0 : ((use) == 1 ? item.Weapon.Effect_1 : ((use) == 2 ? item.Weapon.Effect_2 : EMPTY_HSTRING));
}

int WeaponRounds(AbstractItem item, int use)
{
    return (use) == 0 ? item.Weapon.Round_0 : ((use) == 1 ? item.Weapon.Round_1 : ((use) == 2 ? item.Weapon.Round_2 : 0));
}

int WeaponApCost(AbstractItem item, int use)
{
    return (use) == 0 ? item.Weapon.ApCost_0 : ((use) == 1 ? item.Weapon.ApCost_1 : ((use) == 2 ? item.Weapon.ApCost_2 : 0));
}

int WeaponSoundId(AbstractItem item, int use)
{
    return (use) == 0 ? item.Weapon.SoundId_0 : ((use) == 1 ? item.Weapon.SoundId_1 : ((use) == 2 ? item.Weapon.SoundId_2 : 0));
}

bool WeaponRemove(AbstractItem item, int use)
{
    return (use) == 0 ? item.Weapon.Remove_0 : ((use) == 1 ? item.Weapon.Remove_1 : ((use) == 2 ? item.Weapon.Remove_2 : false));
}

bool WeaponAim(AbstractItem item, int use)
{
    return (use) == 0 ? item.Weapon.Aim_0 : ((use) == 1 ? item.Weapon.Aim_1 : ((use) == 2 ? item.Weapon.Aim_2 : false));
}

hstring WeaponPicUse(AbstractItem item, int use)
{
    return (use) == 0 ? item.Weapon.PicUse_0 : ((use) == 1 ? item.Weapon.PicUse_1 : ((use) == 2 ? item.Weapon.PicUse_2 : EMPTY_HSTRING));
}

int WeaponModeUse(int weaponMode)
{
    return (weaponMode) & 0xF;
}

int WeaponModeAim(int weaponMode)
{
    return ((weaponMode) >> 4) & 0xF;
}

int MakeWeaponMode(int use, int aim)
{
    return (((aim) << 4) | ((use) & 0xF)) & 0xFF;
}

// Виды применения предмета (use)
const int USE_PRIMARY = 0;

const int USE_SECONDARY = 1;

const int USE_THIRD = 2;

const int USE_RELOAD = 3;

const int USE_USE = 4;

const int MAX_USES = 3;

// 683
// Типы звуков (первый символ тега определяет категорию звукового события)
// Обычный <Type Subtype SoundId SoundIdExt X X X X>
// Оружие  <Type Subtype SoundId SoundIdExt X X X [Random 1 or 2]>
const int SOUND_WEAPON = 'W';

const int SOUND_WEAPON_USE = 'A';

const int SOUND_WEAPON_FLY = 'F';

const int SOUND_WEAPON_MISS = 'H';

const int SOUND_WEAPON_EMPTY = 'O';

const int SOUND_WEAPON_RELOAD = 'R';

}
