// Test_Flags — тесты битовых хелперов Flags (HasFlag/SetFlag/UnsetFlag, int и uint16 перегрузки).
namespace Test_Flags
{

#if SERVER

[[ModuleInit]]
void InitTestFlags()
{
    Game.OnTestingInit.Subscribe(OnTestingInit);
}

[[Event]]
void OnTestingInit()
{
    Testing::RegisterTest("flags", "set_has_unset", SetHasUnset);
    Testing::RegisterTest("flags", "combined_masks", CombinedMasks);
    Testing::RegisterTest("flags", "uint16_overload", Uint16Overload);
}

void SetHasUnset(Testing::TestContext ctx)
{
    int x = 0;
    if (!Testing::Expect(ctx, !Flags::HasFlag(x, Flags::HF_KNOCKOUT), "Нулевое значение не содержит флагов")) {
        return;
    }

    Flags::SetFlag(x, Flags::HF_KNOCKOUT);
    if (!Testing::Expect(ctx, Flags::HasFlag(x, Flags::HF_KNOCKOUT), "После SetFlag флаг должен читаться")) {
        return;
    }

    // Повторная установка идемпотентна
    Flags::SetFlag(x, Flags::HF_KNOCKOUT);
    if (!Testing::ExpectEq(ctx, x, Flags::HF_KNOCKOUT, "Повторный SetFlag не должен менять значение")) {
        return;
    }

    Flags::UnsetFlag(x, Flags::HF_KNOCKOUT);
    if (!Testing::Expect(ctx, !Flags::HasFlag(x, Flags::HF_KNOCKOUT), "После UnsetFlag флаг должен исчезнуть")) {
        return;
    }

    Testing::ExpectEq(ctx, x, 0, "После снятия единственного флага значение снова ноль");
}

void CombinedMasks(Testing::TestContext ctx)
{
    int x = 0;
    Flags::SetFlag(x, Flags::HF_KNOCKDOWN);
    Flags::SetFlag(x, Flags::HF_BLINDED);
    Flags::SetFlag(x, Flags::HF_ON_FIRE);

    if (!Testing::Expect(ctx,
                         Flags::HasFlag(x, Flags::HF_KNOCKDOWN) && Flags::HasFlag(x, Flags::HF_BLINDED) && Flags::HasFlag(x, Flags::HF_ON_FIRE),
                         "Все установленные флаги должны читаться одновременно")) {
        return;
    }

    if (!Testing::Expect(ctx, !Flags::HasFlag(x, Flags::HF_DEATH), "Неустановленный флаг не должен читаться")) {
        return;
    }

    Flags::UnsetFlag(x, Flags::HF_BLINDED);
    Testing::Expect(ctx,
                    Flags::HasFlag(x, Flags::HF_KNOCKDOWN) && !Flags::HasFlag(x, Flags::HF_BLINDED) && Flags::HasFlag(x, Flags::HF_ON_FIRE),
                    "Снятие одного флага не должно задевать соседние");
}

void Uint16Overload(Testing::TestContext ctx)
{
    uint16 x = 0;
    Flags::SetFlag(x, Flags::HF_LOST_NEXT_TURN);
    if (!Testing::Expect(ctx, Flags::HasFlag(x, Flags::HF_LOST_NEXT_TURN), "uint16-перегрузка SetFlag должна работать")) {
        return;
    }

    Flags::UnsetFlag(x, Flags::HF_LOST_NEXT_TURN);
    Testing::ExpectEq(ctx, x, 0, "uint16-перегрузка UnsetFlag должна очищать значение");
}

#endif

}
