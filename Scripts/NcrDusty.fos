// NcrDusty — серверная логика квеста «Вечеринка у Дасти» в НКР.
// Настраивает NPC Дасти (разрешает бартер, запрещает кражу, задаёт дистанцию разговора)
//  и через глобальные счётчики отслеживает принесённые самогон/пиво (Rotgut/BeerGamma);
//  при наборе порога переводит статус вечеринки в «готова». SERVER; два таймера:
//  OneHour проверяет порог, OneWeek еженедельно сбрасывает счётчики и статус.

namespace NcrDusty
{

#if SERVER

// Счётчики и статусы квеста «Вечеринка у Дасти».

///@ Property Game Server int32 NcrDustyOneHourInvokeId Mutable Persistent
///@ Property Game Server int32 NcrDustyOneWeekInvokeId Mutable Persistent
///@ Property Game Server uint8 NCRDustyPartyStatusGlobal Mutable Persistent Max = 2
///@ Property Game Server uint8 NCRDustyRotgutCounter Mutable Persistent Max = 20
///@ Property Game Server uint8 NCRDustyBeerGammaCounter Mutable Persistent Max = 20

void DustyInit(Critter dusty, bool firstTime)
{
    dusty.IsNoBarter = false;
    dusty.IsNoSteal = true;
    dusty.TalkDistance = 5;
    dusty.OnFinish.Subscribe(DustyFinish);
    if (firstTime) {
        Game.NcrDustyOneHourInvokeId = Game.StartTimeEvent(Time::GameHours(1), OneHour); //SavedDeferredCall
        Game.NcrDustyOneWeekInvokeId = Game.StartTimeEvent(Time::GameDays(7), OneWeek);  //SavedDeferredCall
    }
}

[[Event]]
void DustyFinish(Critter dusty)
{
    Game.StopTimeEvent(Game.NcrDustyOneHourInvokeId);
    Game.NcrDustyOneHourInvokeId = 0;
    Game.StopTimeEvent(Game.NcrDustyOneWeekInvokeId);
    Game.NcrDustyOneWeekInvokeId = 0;
}

[[TimeEvent]]
void OneHour()
{
    // Как только принесено достаточно и самогона, и пива — вечеринка считается готовой (статус 2).
    if (Game.NCRDustyRotgutCounter >= 20 && Game.NCRDustyBeerGammaCounter >= 20) {
        Game.NCRDustyPartyStatusGlobal = 2;
    }

    Game.NcrDustyOneHourInvokeId = Game.StartTimeEvent(Time::GameHours(1), OneHour); //SavedDeferredCall
}

[[TimeEvent]]
void OneWeek()
{
    // Раз в неделю сбрасываем прогресс, чтобы вечеринку можно было устроить заново.
    Game.NCRDustyRotgutCounter = 0;
    Game.NCRDustyBeerGammaCounter = 0;
    Game.NCRDustyPartyStatusGlobal = 0;
    Game.NcrDustyOneWeekInvokeId = Game.StartTimeEvent(Time::GameDays(7), OneWeek); //SavedDeferredCall
}

#endif

}
