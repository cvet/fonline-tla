// Trigger — серверные обработчики статических триггеров карты (ItemTrigger) при входе криттера на предмет-сценку.
// Реакции: предупреждение и натравливание НПЦ по роли, снятие атаки, добивание и урон, открытие/закрытие дверей,
//  вызов лифтов (4 этажа и упрощённый вариант) и запуск диалога с ближайшим НПЦ нужной роли.
// Только SERVER (#if SERVER); опирается на Stdlib, NpcPlanes, EnemyStack, Elevator, Messaging и CritterState.
namespace Trigger
{

#if SERVER

const int AI_PLANE_ATTACK_PRIORITY_MARK = NpcPlanes::AI_PLANE_ATTACK_PRIORITY + 1;

bool TryGetNpcRole(StaticItem trigger, int& npcRole)
{
    return Tla::TryParseSceneryInt(trigger.SceneryParams[0], npcRole) && npcRole > 0;
}

bool IsDeathAnimation(int value)
{
    CritterActionAnim animation = CritterActionAnim(value);
    return animation == CritterActionAnim::DeadProneFront || animation == CritterActionAnim::DeadProneBack || animation == CritterActionAnim::DeadFront ||
           animation == CritterActionAnim::DeadBack || animation == CritterActionAnim::DeadBloodySingle || animation == CritterActionAnim::DeadBloodyBurst ||
           animation == CritterActionAnim::DeadBurst || animation == CritterActionAnim::DeadPulse || animation == CritterActionAnim::DeadPulseDust ||
           animation == CritterActionAnim::DeadLaser || animation == CritterActionAnim::DeadFused || animation == CritterActionAnim::DeadExplode ||
           animation == CritterActionAnim::DeadBurn || animation == CritterActionAnim::DeadBurnRun;
}

[[ItemTrigger]]
void Warn(Critter player, StaticItem trigger, bool entered, mdir dir)
{
    int npcRole = 0;
    if (!TryGetNpcRole(trigger, npcRole)) {
        return;
    }
    Stdlib::Warn(player, npcRole);
}

[[ItemTrigger]]
void Attack(Critter player, StaticItem trigger, bool entered, mdir dir)
{
    if (not player.ControlledByPlayer) {
        return;
    }

    int npcRole = 0;
    if (!TryGetNpcRole(trigger, npcRole)) {
        return;
    }
    Map? map = player.GetMap();
    if (map == null) {
        return;
    }

    Critter[] critters = map.GetCritters(CritterProperty::NpcRole, npcRole, CritterFindType::NonDeadNpc);
    for (int i = 0; i < critters.length(); i++) {
        NpcPlanes::AddAttackPlane(critters[i], AI_PLANE_ATTACK_PRIORITY_MARK, player);
    }
}

[[ItemTrigger]]
void AttackStop(Critter player, StaticItem trigger, bool entered, mdir dir)
{
    if (not player.ControlledByPlayer) {
        return;
    }

    int npcRole = 0;
    if (!TryGetNpcRole(trigger, npcRole)) {
        return;
    }
    Map? map = player.GetMap();
    if (map == null) {
        return;
    }

    Critter[] critters = map.GetCritters(CritterProperty::NpcRole, npcRole, CritterFindType::NonDeadNpc);
    for (int i = 0; i < critters.length(); i++) {
        Critter npc = critters[i];

        // проходимся по списку планов в поисках маркированного плана
        NpcPlanes::NpcPlane[] planes = {};
        int count = NpcPlanes::GetPlanes(npc, planes);
        for (int j = 0; j < count; j++) {
            if ((planes[j].Attack_TargId == player.Id) and (planes[j].Priority == AI_PLANE_ATTACK_PRIORITY_MARK)) {
                if (NpcPlanes::ErasePlane(npc, j)) {
                    EnemyStack::EraseEnemyFromStack(npc, player.Id);
                }
            }
        }
    }
}

void Kill(Critter player, StaticItem trigger, bool entered, mdir dir)
{
    int type = 0;
    if (!Tla::TryParseSceneryInt(trigger.SceneryParams[0], type) || !IsDeathAnimation(type)) {
        return;
    }

    Stdlib::Kill(player, CritterActionAnim(type));
}

void Damage(Critter player, StaticItem trigger, bool entered, mdir dir)
{
    int damage = 0;
    int type = 0;
    if (!Tla::TryParseSceneryInt(trigger.SceneryParams[0], damage) || !Tla::TryParseSceneryInt(trigger.SceneryParams[1], type) || damage <= 0 ||
        type < int(DamageTypes::Normal) || type > int(DamageTypes::Radiation)) {
        return;
    }

    Stdlib::Damage(player, damage, DamageTypes(type), dir);
}

void DoorOpenTrigger(Critter player, StaticItem trigger, bool entered, mdir dir)
{
    int entryNum = 0;
    if (!Tla::TryParseSceneryInt(trigger.SceneryParams[0], entryNum, true) || entryNum < 0) {
        return;
    }
    Stdlib::DoorControl(player, entryNum, true);
}

void DoorOpenImpl(Critter player, StaticItem trigger, bool entered, mdir dir)
{
    DoorOpenTrigger(player, trigger, entered, dir);
}

[[ItemTrigger]]
void DoorOpen(Critter player, StaticItem trigger, bool entered, mdir dir)
{
    DoorOpenImpl(player, trigger, entered, dir);
}

void DoorCloseTrigger(Critter player, StaticItem trigger, bool entered, mdir dir)
{
    int entryNum = 0;
    if (!Tla::TryParseSceneryInt(trigger.SceneryParams[0], entryNum, true) || entryNum < 0) {
        return;
    }
    Stdlib::DoorControl(player, entryNum, false);
}

[[ItemTrigger]]
void DoorClose(Critter player, StaticItem trigger, bool entered, mdir dir)
{
    DoorCloseTrigger(player, trigger, entered, dir);
}

// лифт, всего существуют 8 типов лифтов. Максимум - 4 этажа
// для четырехэтажного отдельный триггер
// 1ый параметр - номер гекса, на который попадет игрок
// остальные параметры - коды прототипов карт
[[ItemTrigger]]
void Elevator4(Critter player, StaticItem trigger, bool entered, mdir dir)
{
    Elevator::Elevator4(player, trigger, entered, dir);
}

// лифт, в котором меньше чем 4 этажа
// 1ый параметр - номер гекса, на который попадет игрок
// 2ой параметр - тип лифта (от 1 до 8. см. _defines.fos, секцию // Elevators)
// 3ий..5ый параметры - коды прототипов карт
[[ItemTrigger]]
void Elevator(Critter player, StaticItem trigger, bool entered, mdir dir)
{
    Elevator::Elevator(player, trigger, entered, dir);
}

// Диалог с НПЦ рядом с триггером,  с определенной ролью. 1 параметр - роль НПЦ.
[[ItemTrigger]]
void DialogNpc(Critter player, StaticItem trigger, bool entered, mdir dir)
{
    int npcRole = 0;
    if (!TryGetNpcRole(trigger, npcRole)) {
        return;
    }
    CritterState::Wait(player, 0);
    Stdlib::DialogNpc(player, npcRole);
}

#endif

}
