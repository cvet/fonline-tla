// ClientItems — клиентские коллекции предметов для интерфейса.
// Ключевое: получение коллекций (инвентарь/лут/бартер), исключение отданных/убранных предметов,
// перенос между коллекциями, отправка бартер-оффера на сервер; SERVER-часть принимает оффер под локами.
// Сторона: MIXED (CLIENT основной + SERVER RemoteCall). Связи: Gui, Barter, Sync, ClientDefines, Content.
namespace ClientItems
{

///@ RemoteCall Server ProcessBarterNpcOffer(ident[] saleItemsIds, int32[] saleItemsCount, ident[] buyItemsIds, int32[] buyItemsCount, uint32 expectedTransferSession)
///@ RemoteCall Server CloseTransfer(int32 expectedTransferType, ident expectedContainerId, uint32 expectedTransferSession)
///@ RemoteCall Server ResumeDialogFromBarter(ident traderId, uint32 expectedTransferSession)
///@ RemoteCall Client BarterOfferProcessed(uint32 expectedTransferSession)
///@ RemoteCall Client SetBarterPricing(uint32 expectedTransferSession, int32 barterCoefficient, bool hasMasterTrader)

// Нормализует ввод пятизначного окна Split и не пропускает нулевой/лишний count в действие.
int NormalizeSplitCount(int count, int itemCount)
{
    int maxCount = Math::Clamp(itemCount, 1, 99999);
    return Math::Clamp(count, 1, maxCount);
}

// Коллекция ITEMS_USE предназначена только для предметов, применяемых к другой цели.
bool IsUsableOnTarget(AbstractItem item)
{
    return item.IsCanUseOnSmth;
}

bool IsSameContainerTransfer(int transferType, ident containerId, uint transferSession, int expectedTransferType, ident expectedContainerId,
                             uint expectedTransferSession)
{
    return transferType == expectedTransferType && containerId == expectedContainerId && transferSession == expectedTransferSession;
}

#if CLIENT

enum Collection
{
    ChosenAll,
    Inventory,
    Loot,
    BarterOffer,
    BarterTraderOffer,
    RecievedItems
}

// Клиентские «теневые» коллекции: что пришло от сервера и что игрок уже отдал/убрал в UI
// (бартер-оффер обеих сторон и временно изъятые предметы). Используются для оптимистичного
// отображения до подтверждения сервером.
Item[] ReceivedItems = {};
Item[] BarterOfferItems = {};
Item[] BarterTraderOfferItems = {};
Item[] RemovedItems = {};
bool BarterOfferPending = false;
uint PendingBarterSession = 0;
int BarterCoefficient = Barter::MinBarterCoefficient;
bool BarterHasMasterTrader = false;
uint ActiveBarterSession = 0;
bool ContainerOperationPending = false;
int PendingContainerTransferType = int(TransferTypes::Close);
ident PendingContainerId = ZERO_IDENT;
uint PendingContainerSession = 0;

[[ModuleInit]]
void InitClientItems()
{
    Game.OnReceiveItems.Subscribe(OnReceiveItems);
}

// Перерисовывает все ItemView, которые используют клиентские теневые коллекции. Внутренний
// Collection не совпадает по номерам с UserDataExt, поэтому перечисляем UI-контракты явно.
void RefreshItemViews()
{
    Gui::RefreshItemViewsByUserDataExts({ClientDefines::ITEMS_CHOSEN_ALL,
                                         ClientDefines::ITEMS_INVENTORY,
                                         ClientDefines::ITEMS_USE,
                                         ClientDefines::ITEMS_BARTER,
                                         ClientDefines::ITEMS_BARTER_OFFER,
                                         ClientDefines::ITEMS_BARTER_OPPONENT,
                                         ClientDefines::ITEMS_BARTER_OPPONENT_OFFER,
                                         ClientDefines::ITEMS_PICKUP,
                                         ClientDefines::ITEMS_PICKUP_FROM});
}

void ClearContainerOperation()
{
    ContainerOperationPending = false;
    PendingContainerTransferType = int(TransferTypes::Close);
    PendingContainerId = ZERO_IDENT;
    PendingContainerSession = 0;
}

// В одной transfer-сессии держим не больше одной неподтверждённой контейнерной операции.
// Смена tuple отзывает старый pending, а authoritative SendItems очищает новый.
bool TryBeginContainerOperation(int expectedTransferType, ident expectedContainerId, uint expectedTransferSession)
{
    if (!HasChosen || !IsSameContainerTransfer(int(Chosen.TransferType),
                                               Chosen.TransferContainerId,
                                               Chosen.TransferSession,
                                               expectedTransferType,
                                               expectedContainerId,
                                               expectedTransferSession)) {
        return false;
    }

    if (ContainerOperationPending) {
        if (IsSameContainerTransfer(PendingContainerTransferType,
                                    PendingContainerId,
                                    PendingContainerSession,
                                    expectedTransferType,
                                    expectedContainerId,
                                    expectedTransferSession)) {
            return false;
        }
        ClearContainerOperation();
    }

    ContainerOperationPending = true;
    PendingContainerTransferType = expectedTransferType;
    PendingContainerId = expectedContainerId;
    PendingContainerSession = expectedTransferSession;
    return true;
}

// Получили предметы от сервера: сбрасываем теневые коллекции и по типу передачи открываем
// нужный экран (бартер или подбор/контейнер).
[[Event]]
void OnReceiveItems(Item[] items, any contextParam)
{
    int context = int(contextParam);
    if (context == 0) {
        ClearContainerOperation();
    }
    else if (context == 1 && ContainerOperationPending && HasChosen &&
             IsSameContainerTransfer(int(Chosen.TransferType),
                                     Chosen.TransferContainerId,
                                     Chosen.TransferSession,
                                     PendingContainerTransferType,
                                     PendingContainerId,
                                     PendingContainerSession)) {
        ClearContainerOperation();
    }
    if (!HasChosen) {
        ClearContainerOperation();
    }

    ReceivedItems.clear();
    BarterOfferItems.clear();
    BarterTraderOfferItems.clear();
    RemovedItems.clear();

    ReceivedItems = items.clone();
    RefreshItemViews();

    if (context != 0) {
        return;
    }

    if (!HasChosen) {
        BarterOfferPending = false;
        PendingBarterSession = 0;
        ActiveBarterSession = 0;
        Gui::HideScreen(GuiScreen::Barter);
        Gui::HideScreen(GuiScreen::PickUp);
        return;
    }

    Critter chosen = Chosen;

    TransferTypes transfer = chosen.TransferType;

    if (transfer != TransferTypes::Close) {
        if (transfer == TransferTypes::CritBarter) {
            if (ActiveBarterSession != chosen.TransferSession) {
                BarterOfferPending = false;
                PendingBarterSession = 0;
            }
            ActiveBarterSession = chosen.TransferSession;
            Gui::HideScreen(GuiScreen::PickUp);
            Gui::ShowScreen(GuiScreen::Barter, dict<string, any> = {{"CritterId", chosen.TransferContainerId}, {"TransferSession", chosen.TransferSession}});
        }
        else {
            BarterOfferPending = false;
            PendingBarterSession = 0;
            ActiveBarterSession = 0;
            Gui::HideScreen(GuiScreen::Barter);
            ident crId;
            ident itemId;

            if (transfer == TransferTypes::CritLoot || transfer == TransferTypes::CritSteal || transfer == TransferTypes::FarCrit) {
                crId = chosen.TransferContainerId;
            }
            else if (transfer == TransferTypes::HexContUp || transfer == TransferTypes::HexContDown || transfer == TransferTypes::SelfCont ||
                     transfer == TransferTypes::FarCont) {
                itemId = chosen.TransferContainerId;
            }

            Gui::ShowScreen(GuiScreen::PickUp,
                            dict<string, any> = {{"TargetCritterId", crId},
                                                 {"TargetItemId", itemId},
                                                 {"TransferType", int(transfer)},
                                                 {"TransferContainerId", chosen.TransferContainerId},
                                                 {"TransferSession", chosen.TransferSession}});
        }
    }
    else {
        BarterOfferPending = false;
        PendingBarterSession = 0;
        ActiveBarterSession = 0;
        Gui::HideScreen(GuiScreen::Barter);
        Gui::HideScreen(GuiScreen::PickUp);
    }
}

// Собирает коллекцию предметов для UI по её типу и вычитает уже отданное в бартер и временно
// убранное, чтобы интерфейс показывал актуальный остаток до подтверждения сервером.
Item[] GetCollection(Collection collection)
{
    Item[] items = {};
    Critter? chosen = HasChosen ? Chosen : null;

    if (collection == Collection::ChosenAll) {
        if (chosen != null) {
            items = chosen.GetItems();
        }
    }
    else if (collection == Collection::Inventory) {
        if (chosen != null) {
            items = chosen.GetItems(ItemProperty::CritterSlot, CritterItemSlot::Inventory);
        }
    }
    else if (collection == Collection::Loot) {
        items = ReceivedItems.clone();
        // breadcrumb миграции: альтернативный источник лута из инвентаря криттера-цели; не удалять.
        /*if (chosen != null && chosen.TransferContainerId != ZERO_IDENT) {
            Critter? targetCr = Game.GetCritter(chosen.TransferContainerId);
            if (targetCr != null) {
                items = targetCr.GetItems(ItemProperty::CritterSlot, CritterItemSlot::Inventory);
                TODO: Уточнить, зачем здесь предметы забираются из инвентаря
                криттера, ведь они невовремя обновляются. На сервере предмет изъят из инвентаря,
                на клиенте нет (если это не chosen)
            }
        }*/
    }
    else if (collection == Collection::BarterOffer) {
        items = BarterOfferItems;
    }
    else if (collection == Collection::BarterTraderOffer) {
        items = BarterTraderOfferItems;
    }
    else if (collection == Collection::RecievedItems) {
        items = ReceivedItems.clone();
    }

    if (collection != Collection::BarterOffer && collection != Collection::BarterTraderOffer) {
        ExcludeItems(items, collection != Collection::Loot ? BarterOfferItems : BarterTraderOfferItems);
    }

    ExcludeItems(items, RemovedItems);

    return items;
}

// Помечает count единиц предмета как временно убранные (теневая коллекция RemovedItems),
// чтобы UI скрыл их до подтверждения сервером.
void RemoveItem(Collection collection, Item item, int count)
{
    verify(count > 0, "Assertion failed");
    verify(count <= item.Count, "Assertion failed");

    RemovedItems.insertLast(item.Clone(count));
    RefreshItemViews();
}

// Заготовка переноса предмета в/из бартер-оффера (тело не реализовано).
void BarterItem(bool offer, Item& item, int count)
{
    // breadcrumb миграции: незавершённая ветка по флагу offer; не удалять
    // if( offer )
}

// Вычитает excludeItems из items по Id: полностью убирает предмет или уменьшает его количество
// клонированием, чтобы исходные предметы не мутировались.
void ExcludeItems(Item[] items, Item[] excludeItems)
{
    for (int i = 0; i < excludeItems.length(); i++) {
        Item excludeItem = excludeItems[i];
        for (int j = 0; j < items.length(); j++) {
            Item item = items[j];
            if (excludeItem.Id == item.Id) {
                if (excludeItem.Count >= item.Count) {
                    items.removeAt(j);
                }
                else {
                    items[j] = item.Clone(item.Count - excludeItem.Count);
                }

                break;
            }
        }
    }
}

// Сопоставляет числовой тип коллекции из UI (ClientDefines) с внутренним enum Collection.
Collection GetCollectionFromType(int collectionType)
{
    Collection collection = Collection::ChosenAll;

    switch (collectionType) {
    case ClientDefines::ITEMS_CHOSEN_ALL:
        collection = Collection::ChosenAll;
        break;
    case ClientDefines::ITEMS_INVENTORY:
        collection = Collection::Inventory;
        break;
    case ClientDefines::ITEMS_BARTER:
    case ClientDefines::ITEMS_PICKUP_FROM:
        collection = Collection::Inventory;
        break;
    case ClientDefines::ITEMS_PICKUP:
        collection = Collection::Loot;
        break;
    case ClientDefines::ITEMS_BARTER_OFFER:
        collection = Collection::BarterOffer;
        break;
    case ClientDefines::ITEMS_BARTER_OPPONENT_OFFER:
        collection = Collection::BarterTraderOffer;
        break;
    case ClientDefines::ITEMS_BARTER_OPPONENT:
        collection = Collection::Loot;
        break;
    }

    return collection;
}

// Точка входа для UI: пересобрать коллекцию по числовому типу.
Item[] RefreshItemsCollection(int collectionType)
{
    Collection collection = GetCollectionFromType(collectionType);
    return GetCollection(collection);
}

// Удаляет предмет по Id из теневой коллекции оффера.
void RemoveItemFromCollection(ident itemId, Collection collection)
{
    Item[] items = GetCollection(collection);
    for (int j = 0; j < items.length(); j++) {
        Item item = items[j];
        if (itemId == item.Id) {
            items.removeAt(j);
            break;
        }
    }
}

// Меняет количество предмета в коллекции, заменяя его клоном с новым count.
void ChangeCollectionItemCount(ident itemId, Collection collection, int count)
{
    Item[] items = GetCollection(collection);
    for (int j = 0; j < items.length(); j++) {
        if (itemId == items[j].Id) {
            Item item = items[j].Clone(count);
            items.removeAt(j);
            items.insertAt(j, item);
            break;
        }
    }
}

// Ищет предмет строго в актуальной коллекции. Используется операциями, которым нельзя повторно
// взять уже исключённый из источника предмет.
Item? FindCollectionItem(ident itemId, Collection collection)
{
    Item[] items = GetCollection(collection);
    for (int i = 0; i < items.length(); i++) {
        if (items[i].Id == itemId) {
            return items[i];
        }
    }

    return null;
}

// Ищет предмет для UI-превью. TargetItemId контейнера/карты может законно не входить в показанную
// коллекцию, поэтому сохраняем резервный поиск сущности в игре.
Item? GetCollectionItem(ident itemId, Collection collection)
{
    Item? item = FindCollectionItem(itemId, collection);
    return item != null ? item : Game.GetItem(itemId);
}

// Формирует из обеих сторон бартер-оффера параллельные массивы Id/количество и отправляет
// оффер на сервер удалённым вызовом.
bool BarterOffer(uint expectedTransferSession)
{
    if (BarterOfferPending || !HasChosen || Chosen.TransferType != TransferTypes::CritBarter || Chosen.TransferSession != expectedTransferSession ||
        ActiveBarterSession != expectedTransferSession) {
        return false;
    }

    ident[] saleItemsIds = {};
    int[] saleItemsCount = {};
    ident[] buyItemsIds = {};
    int[] buyItemsCount = {};

    Item[] itemsSale = GetCollection(Collection::BarterOffer);
    Item[] itemsBuy = GetCollection(Collection::BarterTraderOffer);

    for (int i = 0; i < itemsSale.length(); i++) {
        saleItemsIds.insertLast(itemsSale[i].Id);
        saleItemsCount.insertLast(itemsSale[i].Count);
    }

    for (int i = 0; i < itemsBuy.length(); i++) {
        buyItemsIds.insertLast(itemsBuy[i].Id);
        buyItemsCount.insertLast(itemsBuy[i].Count);
    }

    if (saleItemsIds.length() == 0) {
        return false;
    }

    BarterOfferPending = true;
    PendingBarterSession = expectedTransferSession;
    CurPlayer.ServerCall.ProcessBarterNpcOffer(saleItemsIds, saleItemsCount, buyItemsIds, buyItemsCount, expectedTransferSession);
    return true;
}

bool BarterOffer()
{
    return BarterOffer(ActiveBarterSession);
}

// Сервер закончил обработку оффера (успех или отказ) — разрешаем повторную отправку.
[[ClientRemoteCall]]
void BarterOfferProcessed(uint expectedTransferSession)
{
    if (BarterOfferPending && PendingBarterSession == expectedTransferSession) {
        BarterOfferPending = false;
        PendingBarterSession = 0;
    }
}

// Сервер передаёт тот же коэффициент и состояние Master Trader, которые использует при
// авторитетной проверке сделки. Поэтому суммы в окне совпадают с серверными до единицы.
[[ClientRemoteCall]]
void SetBarterPricing(uint expectedTransferSession, int barterCoefficient, bool hasMasterTrader)
{
    if (!HasChosen || Chosen.TransferType != TransferTypes::CritBarter || Chosen.TransferSession != expectedTransferSession) {
        return;
    }

    BarterCoefficient = Math::Clamp(barterCoefficient, Barter::MinBarterCoefficient, Barter::MaxBarterCoefficient);
    BarterHasMasterTrader = hasMasterTrader;
}

int64 GetBarterCollectionCost(int collectionType)
{
    bool playerSale = collectionType == ClientDefines::ITEMS_BARTER_OFFER;
    bool playerBuy = collectionType == ClientDefines::ITEMS_BARTER_OPPONENT_OFFER;
    Item[] items = RefreshItemsCollection(collectionType);
    int64 total = 0;

    for (int i = 0; i < items.length(); i++) {
        int64 unitCost = playerSale ? Barter::GetSaleUnitCost(items[i].Cost, BarterCoefficient) :
                                      (playerBuy ? Barter::GetBuyUnitCost(items[i].Cost, BarterCoefficient, BarterHasMasterTrader) : int64(items[i].Cost));
        int64 stackCost = Barter::GetStackCost(unitCost, items[i].Count, Barter::MaxBarterTotalCost);
        if (stackCost < 0 || total > Barter::MaxBarterTotalCost - stackCost) {
            return Barter::MaxBarterTotalCost + 1;
        }
        total += stackCost;
    }

    return total;
}

// Переносит предмет между инвентарём/лутом и соответствующим бартер-оффером: для переноса
// «в оффер» наращивает стек или добавляет клон, для «из оффера» уменьшает или убирает предмет.
bool BarterTransfer(ident item_id, int collectionTypeFrom, int item_count)
{
    if (item_count <= 0) {
        return false;
    }

    Collection collectionFrom;
    Collection collectionTo;
    switch (collectionTypeFrom) {
    case ClientDefines::ITEMS_BARTER:
        collectionTo = Collection::BarterOffer;
        collectionFrom = Collection::Inventory;
        break;
    case ClientDefines::ITEMS_BARTER_OFFER:
        collectionTo = Collection::Inventory;
        collectionFrom = Collection::BarterOffer;
        break;
    case ClientDefines::ITEMS_BARTER_OPPONENT:
        collectionTo = Collection::BarterTraderOffer;
        collectionFrom = Collection::Loot;
        break;
    case ClientDefines::ITEMS_BARTER_OPPONENT_OFFER:
        collectionTo = Collection::Loot;
        collectionFrom = Collection::BarterTraderOffer;
        break;
    default:
        return false;
    }

    Item? item = FindCollectionItem(item_id, collectionFrom);

    if (item == null) {
        return false;
    }

    if (item_count > item.Count) {
        return false;
    }

    // Предметы без контрактной стоимости нельзя превращать в бартерную валюту. Сервер повторяет
    // эту проверку через GetSaleUnitCost/GetStackCost для недоверенного оффера.
    if (collectionTypeFrom == ClientDefines::ITEMS_BARTER && Barter::GetSaleUnitCost(item.Cost, BarterCoefficient) == 0) {
        return false;
    }

    Item? itemTo = null;
    Item[] itemsTo = GetCollection(collectionTo);

    for (int i = 0; i < itemsTo.length(); i++) {
        // Оффер передаёт серверу entity Id, поэтому разные стеки одного прототипа нельзя
        // склеивать: у них могут отличаться свойства, а суммарный count не принадлежит одному Id.
        if (itemsTo[i].Id == item.Id) {
            itemTo = itemsTo[i];
            break;
        }
    }

    if (collectionTypeFrom == ClientDefines::ITEMS_BARTER || collectionTypeFrom == ClientDefines::ITEMS_BARTER_OPPONENT) {
        int offerCount = itemTo != null ? itemTo.Count : 0;
        if (!Barter::CanIncreaseOfferCount(item.Count, offerCount, item_count, item.Stackable)) {
            return false;
        }
        if (itemTo != null) {
            ChangeCollectionItemCount(itemTo.Id, collectionTo, itemTo.Count + item_count);
        }
        else {
            itemsTo.insertLast(item.Clone(item_count));
        }
    }
    else {
        if (item.Count - item_count == 0 || !item.Stackable) {
            RemoveItemFromCollection(item.Id, collectionFrom);
        }
        else {
            ChangeCollectionItemCount(item_id, collectionFrom, item.Count - item_count);
        }
    }

    RefreshItemViews();
    return true;
}

#endif

#if SERVER

// Закрывает transfer-контекст только если клиент закрывает именно то окно, которое ещё активно
// на сервере. Проверка типа и контейнера не даёт запоздалому OnHide закрыть уже новое окно.
[[ServerRemoteCall]] [[Async]]
void CloseTransfer(Player player, int expectedTransferType, ident expectedContainerId, uint expectedTransferSession)
{
    Critter? cr = player.GetControlledCritter();
    if (cr == null || !Sync::Lock(cr)) {
        return;
    }

    if (int(cr.TransferType) != expectedTransferType || cr.TransferContainerId != expectedContainerId || cr.TransferSession != expectedTransferSession) {
        return;
    }

    Item[]? items = null;
    cr.TransferType = TransferTypes::Close;
    cr.TransferContainerId = ZERO_IDENT;
    cr.SendItems(items);
}

// Кнопка «Диалог» атомарно завершает текущий бартер с ожидаемым НПЦ и снова начинает
// разговор. Отдельный CloseTransfer здесь не нужен: иначе два async-RPC могли бы обогнать
// друг друга и закрыть уже восстановленный диалог/следующее окно.
[[ServerRemoteCall]] [[Async]]
void ResumeDialogFromBarter(Player player, ident traderId, uint expectedTransferSession)
{
    Critter? cr = player.GetControlledCritter();
    if (cr == null || !Sync::Lock(cr)) {
        return;
    }

    if (cr.TransferType != TransferTypes::CritBarter || cr.TransferContainerId != traderId || cr.TransferSession != expectedTransferSession) {
        return;
    }

    Critter? trader = Game.GetCritter(traderId);
    if (trader == null || !Sync::Lock(cr, trader)) {
        if (Sync::Lock(cr) && cr.TransferType == TransferTypes::CritBarter && cr.TransferContainerId == traderId &&
            cr.TransferSession == expectedTransferSession) {
            Barter::SendBarterClose(cr);
        }
        return;
    }

    if (cr.TransferType != TransferTypes::CritBarter || cr.TransferContainerId != traderId || cr.TransferSession != expectedTransferSession) {
        return;
    }

    Barter::SendBarterClose(cr);
    if (cr.IsAlive() && trader.IsAlive() && !trader.ControlledByPlayer && !trader.IsNoTalk) {
        Dialogs::RunDialog(cr, trader, false);
    }
}

// Серверный приём бартер-оффера: берёт локи на криттера, торговца и их карты, затем передаёт
// обработку в Barter. Без полного набора локов выходит, не трогая состояние.
[[ServerRemoteCall]] [[Async]]
void ProcessBarterNpcOffer(Player player, ident[] saleItemsIds, int[] saleItemsCount, ident[] buyItemsIds, int[] buyItemsCount, uint expectedTransferSession)
{
    Critter? cr = player.GetControlledCritter();
    if (cr == null) {
        player.ClientCall.BarterOfferProcessed(expectedTransferSession);
        return;
    }

    if (!Sync::Lock(cr)) {
        player.ClientCall.BarterOfferProcessed(expectedTransferSession);
        return;
    }

    if (cr.TransferType != TransferTypes::CritBarter || cr.TransferContainerId == ZERO_IDENT || cr.TransferSession != expectedTransferSession) {
        player.ClientCall.BarterOfferProcessed(expectedTransferSession);
        return;
    }

    ident traderId = cr.TransferContainerId;
    Critter? trader = Game.GetCritter(traderId);
    if (trader == null) {
        Barter::SendBarterClose(cr);
        player.ClientCall.BarterOfferProcessed(expectedTransferSession);
        return;
    }

    while (true) {
        if (!Sync::Lock(cr, trader)) {
            if (Sync::Lock(cr) && cr.TransferType == TransferTypes::CritBarter && cr.TransferContainerId == traderId &&
                cr.TransferSession == expectedTransferSession) {
                Barter::SendBarterClose(cr);
            }
            player.ClientCall.BarterOfferProcessed(expectedTransferSession);
            return;
        }

        if (cr.TransferType != TransferTypes::CritBarter || cr.TransferContainerId != traderId || cr.TransferSession != expectedTransferSession) {
            player.ClientCall.BarterOfferProcessed(expectedTransferSession);
            return;
        }

        Map? crMap = cr.GetMap();
        Map? traderMap = trader.GetMap();
        ident crMapId = cr.MapId;
        ident traderMapId = trader.MapId;
        Entity[] entities = {cr, trader};

        if (crMap != null) {
            entities.insertLast(crMap);
        }

        if (traderMap != null && (crMap == null || traderMap.Id != crMap.Id)) {
            entities.insertLast(traderMap);
        }

        if (!Sync::Lock(entities)) {
            if (Sync::Lock(cr) && cr.TransferType == TransferTypes::CritBarter && cr.TransferContainerId == traderId &&
                cr.TransferSession == expectedTransferSession) {
                Barter::SendBarterClose(cr);
            }
            player.ClientCall.BarterOfferProcessed(expectedTransferSession);
            return;
        }

        if (cr.TransferType != TransferTypes::CritBarter || cr.TransferContainerId != traderId || cr.TransferSession != expectedTransferSession) {
            player.ClientCall.BarterOfferProcessed(expectedTransferSession);
            return;
        }

        if (cr.MapId != crMapId || trader.MapId != traderMapId) {
            continue;
        }

        Barter::ProcessBarterNpcOffer(cr, trader, saleItemsIds, saleItemsCount, buyItemsIds, buyItemsCount, expectedTransferSession);
        player.ClientCall.BarterOfferProcessed(expectedTransferSession);
        return;
    }
}

#endif

}
