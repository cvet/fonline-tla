// FOGUI V2
// {
//   "$type": "Screen",
//   "IsModal": true,
//   "IsMultiinstance": false,
//   "IsCloseOnMiss": false,
//   "AvailableCursors": "{}",
//   "IsCanMove": false,
//   "IsMoveIgnoreBorders": false,
//   "BackgroundImage": "art/intrface/black_pixel.png",
//   "BackgroundImageLayout": "Stretch",
//   "CropContent": true,
//   "IsVerticalScroll": false,
//   "IsHorizontalScroll": false,
//   "Expanded": true,
//   "Selected": true,
//   "Active": true,
//   "Name": "Credits",
//   "Position": "0, 0",
//   "Size": "1, 1",
//   "Anchor": "None",
//   "Dock": "None",
//   "IsDraggable": false,
//   "IsNotHittable": false,
//   "CheckTransparentOnHit": false,
//   "GlobalScope": null,
//   "ClassFields":
{
    {
        nanotime CreditsTick;
        timespan CreditsDeltaTick = Time::Milliseconds(35);

        void RefreshCreditsLayout()
        {
            auto creditsText = GuiScreensExt::NeedText(FindText("CreditsText"));
            creditsText.SetText(MsgStr::GetGameText(MsgStr::StrGameCredits));
            verify(!creditsText.Text.isEmpty(), "Credits text must not be empty");

            string speedText = MsgStr::GetGameText(MsgStr::StrGameCreditsSpeed);
            int speed = 0;
            if (speedText.tryToInt(speed) && speed > 0) {
                CreditsDeltaTick = Time::Milliseconds(speed);
            }

            int tw = 0, th = 0, lines = 0;
            Game.GetTextInfo(creditsText.Text,
                             isize(Settings.View.ScreenWidth, 1000),
                             TextFormat(FontType(int(creditsText.TextFont)), FontFlag(creditsText.TextFlags), 0),
                             isize(tw, th),
                             lines);
            if (th <= 0) {
                th = 1000;
            }
            creditsText.SetSize(Settings.View.ScreenWidth, th);
            // Первая строка сразу входит в кадр; дальше весь блок прокручивается вверх.
            creditsText.SetPosition(0, Settings.View.ScreenHeight - 60);
        }
    }
}
//   "OnInit":
{
    {
        {
        }
    }
}
//   "OnShow":
{
    {
        {
            SetSize(Settings.View.ScreenWidth, Settings.View.ScreenHeight);
            Settings.Gui.HideCursor = true;
            RefreshCreditsLayout();
            CreditsTick = ZERO_NANOTIME;
        }
    }
}
//   "OnHide":
{
    {
        {
            Settings.Gui.HideCursor = false;
        }
    }
}
//   "OnAppear": null,
//   "OnDisappear": null,
//   "OnDraw":
{
    {
        {
            if (CreditsTick > Game.FrameTime) {
                return;
            }
            CreditsTick = Game.FrameTime + CreditsDeltaTick;

            auto creditsText = GuiScreensExt::NeedText(FindText("CreditsText"));
            creditsText.SetPosition(creditsText.Pos.x, creditsText.Pos.y - 1);
        }
    }
}
