// ConsoleCommands — консольные команды персонажа и администрирования.
// CLIENT передаёт строку серверу; SERVER проверяет доступ и выполняет изменения.
// Права задаются серверными настройками, изменяемого глобального состояния нет.
namespace ConsoleCommands
{

///@ Setting Server bool ConsoleCommands.AllowEveryone
///@ Setting Server string ConsoleCommands.AdminNames
///@ RemoteCall Server ExecuteConsoleCommand(string command)

// Пробелы, табуляция и запятые разделяют аргументы старых консольных команд.
string[] ParseArguments(string command)
{
    string[] result = {};
    string token;
    for (int i = 0; i < command.length(); i++) {
        string ch = command[i];
        if (ch == " " || ch == "\t" || ch == ",") {
            if (!token.isEmpty()) {
                result.insertLast(token);
                token = "";
            }
        }
        else {
            token += ch;
        }
    }
    if (!token.isEmpty()) {
        result.insertLast(token);
    }
    return result;
}

#if SERVER

bool HasAccess(Player player)
{
    if (Settings.ConsoleCommands.AllowEveryone) {
        return true;
    }
    string[] names = Settings.ConsoleCommands.AdminNames.split(";");
    for (int i = 0; i < names.length(); i++) {
        if (!names[i].trim().isEmpty() && names[i].trim() == player.Name) {
            return true;
        }
    }
    return false;
}

[[ServerRemoteCall]]
void ExecuteConsoleCommand(Player player, string command)
{
    if (command.length() > 512) {
        Messaging::Info(player, "Command is too long.");
        return;
    }
    string[] args = ParseArguments(command);
    if (args.length() == 0) {
        return;
    }
    Critter? cr = player.GetControlledCritter();
    if (cr == null) {
        Messaging::Info(player, "No controlled character.");
        return;
    }
    if (args[0] == "myinfo" && args.length() == 1) {
        Messaging::Info(player,
                        "Name: " + cr.Name + "; IdCritter: " + cr.Id + "; MapId: " + cr.MapId + "; Hex: " + cr.Hex.x + ", " + cr.Hex.y +
                            "; Admin commands: " + HasAccess(player));
        return;
    }
    if (args[0] != "additemself" && args[0] != "prop") {
        Messaging::Info(player, "Commands: ~myinfo; ~additemself prototype count; ~prop critterId property value");
        return;
    }
    if (!HasAccess(player)) {
        Messaging::Info(player, "Administrator access required.");
        return;
    }
    if (args[0] == "additemself") {
        int count = 0;
        if (args.length() != 3 || !args[2].tryToInt(count) || count < 1 || count > 1000000) {
            Messaging::Info(player, "Usage: ~additemself bottle_caps 100 (count: 1..1000000)");
            return;
        }
        hstring pid = args[1].hstr();
        if (!Game.CheckProtoItem(pid)) {
            Messaging::Info(player, "Unknown item prototype: " + args[1]);
            return;
        }
        ProtoItem proto = Game.GetProtoItem(pid);
        if (!proto.Stackable && count > 100) {
            Messaging::Info(player, "At most 100 non-stackable items per command.");
            return;
        }
        ItemStacks::AddItem(cr, pid, count);
        Messaging::Info(player, "Added " + count + " x " + args[1]);
    }
    else {
        int64 id = 0;
        CritterProperty prop = CritterProperty::None;
        if (args.length() != 4 || !args[1].tryToInt64(id) || id <= 0) {
            Messaging::Info(player, "Usage: ~prop critterId property value");
            return;
        }
        if (!Game.TryParseEnum(args[2], prop) || prop == CritterProperty::None) {
            Messaging::Info(player, "Unknown critter property: " + args[2]);
            return;
        }
        ident critterId;
        critterId.value = id;
        Critter? target = Game.GetCritter(critterId);
        if (target == null) {
            Messaging::Info(player, "Critter not found: " + args[1]);
            return;
        }
        try {
            target.SetAsAny(prop, any(args[3]));
        }
        catch {
            Messaging::Info(player, "Cannot set property: " + GetExceptionInfo());
            return;
        }
        Messaging::Info(player, "Set " + args[1] + "." + args[2] + " = " + string(target.GetAsAny(prop)));
    }
    Game.Log("Console command by " + player.Name + ": " + command);
}

#endif

}
