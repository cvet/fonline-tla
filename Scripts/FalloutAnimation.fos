// FalloutAnimation — игровые правила FRM-анимаций: суффиксы, опорные смещения и составные действия.
// CLIENT/MAPPER: собирает независимые последовательности через общие операции кадров движка.
// Маппинг доступен SERVER для тестов; звуковой подбор Animation использует те же индексы.
// Связи: Animation, AnimHelpers, GameEnums, Time.
namespace FalloutAnimation
{

// Преобразование общих state/action в Fallout-специфичные индексы (fStateAnim/fActionAnim и Ex-варианты).
// Возвращает false, если действие не имеет Fallout-маппинга.
bool MapAnimation(hstring modelName, CritterStateAnim stateAnim, CritterActionAnim actionAnim, int& fStateAnim, int& fActionAnim, int& fStateAnimEx,
                  int& fActionAnimEx, uint& flags)
{
    // По-прежнему интересуют только биты оружия
    stateAnim = CritterStateAnim(stateAnim & AnimHelpers::STATE_ANIM_WEAPON_MASK);

    // Оружие -> Fallout-индекс state
    switch (stateAnim) {
    case CritterStateAnim::Unarmed:
        fStateAnim = FalloutAnims1::Unarmed;
        break;
    case CritterStateAnim::Knife:
        fStateAnim = FalloutAnims1::Knife;
        break;
    case CritterStateAnim::Club:
        fStateAnim = FalloutAnims1::Club;
        break;
    case CritterStateAnim::Hammer:
        fStateAnim = FalloutAnims1::Hammer;
        break;
    case CritterStateAnim::Spear:
        fStateAnim = FalloutAnims1::Spear;
        break;
    case CritterStateAnim::Pistol:
        fStateAnim = FalloutAnims1::Pistol;
        break;
    case CritterStateAnim::SMG:
        fStateAnim = FalloutAnims1::Uzi;
        break;
    case CritterStateAnim::Shootgun:
        fStateAnim = FalloutAnims1::Shootgun;
        break;
    case CritterStateAnim::HeavyRifle:
        fStateAnim = FalloutAnims1::Rifle;
        break;
    case CritterStateAnim::Minigun:
        fStateAnim = FalloutAnims1::Minigun;
        break;
    case CritterStateAnim::RocketLauncher:
        fStateAnim = FalloutAnims1::RocketLauncher;
        break;
    case CritterStateAnim::Flamer:
        fStateAnim = FalloutAnims1::Rifle;
        break;
    case CritterStateAnim::Rifle:
        fStateAnim = FalloutAnims1::Rifle;
        break;
    case CritterStateAnim::Sword:
        fStateAnim = FalloutAnims1::Knife;
        break;
    case CritterStateAnim::LongSword:
        fStateAnim = FalloutAnims1::Knife;
        break;
    case CritterStateAnim::Axe:
        fStateAnim = FalloutAnims1::Club;
        break;
    case CritterStateAnim::Bow:
        fStateAnim = FalloutAnims1::Unarmed;
        break;
    default:
        fStateAnim = FalloutAnims1::Unarmed;
        break;
    }

    // Действие -> Fallout-индекс action
    switch (actionAnim) {
    case CritterActionAnim::Idle:
        fActionAnim = FalloutAnims2::Stay;
        flags |= AnimHelpers::ANIM_FLAG_FIRST_FRAME;
        break;
    case CritterActionAnim::IdleStunned:
        fActionAnim = FalloutAnims2::Stay;
        flags |= AnimHelpers::ANIM_FLAG_FIRST_FRAME;
        break;
    case CritterActionAnim::Walk:
        fActionAnim = FalloutAnims2::Walk;
        break;
    case CritterActionAnim::Limp:
        fActionAnim = FalloutAnims2::Walk;
        break;
    case CritterActionAnim::Run:
        fActionAnim = FalloutAnims2Unarmed::Run;
        fStateAnim = FalloutAnims1::Unarmed;
        break;
    case CritterActionAnim::PanicRun:
        fActionAnim = FalloutAnims2Unarmed::Run;
        fStateAnim = FalloutAnims1::Unarmed;
        break;
    case CritterActionAnim::ShowWeapon:
        fActionAnim = FalloutAnims2::Show;
        break;
    case CritterActionAnim::HideWeapon:
        fActionAnim = FalloutAnims2::Hide;
        break;
    case CritterActionAnim::PrepareWeapon:
        fActionAnim = FalloutAnims2::PrepareWeapon;
        break;
    case CritterActionAnim::TurnOffWeapon:
        fActionAnim = FalloutAnims2::TurnoffWeapon;
        break;
    case CritterActionAnim::Fidget:
        fActionAnim = FalloutAnims2::Stay;
        break;
    // нет Fallout-маппинга для Climbing — оставлено как breadcrumb до реализации
    // case CritterActionAnim::Climbing:
    // fActionAnim = ;
    // break;
    case CritterActionAnim::PickUp:
        fActionAnim = 11;
        fStateAnim = FalloutAnims1::Unarmed;
        break;
    case CritterActionAnim::Use:
        fActionAnim = 12;
        fStateAnim = FalloutAnims1::Unarmed;
        break;
    case CritterActionAnim::SwitchItems:
        fActionAnim = FalloutAnims2Unarmed::Use;
        fStateAnim = FalloutAnims1::Unarmed;
        break;
    case CritterActionAnim::Loot:
        fActionAnim = FalloutAnims2Unarmed::Pickup;
        fStateAnim = FalloutAnims1::Unarmed;
        break;
    case CritterActionAnim::Steal:
        fActionAnim = FalloutAnims2Unarmed::Use;
        fStateAnim = FalloutAnims1::Unarmed;
        break;
    case CritterActionAnim::Push:
        fActionAnim = FalloutAnims2Unarmed::Punch;
        fStateAnim = FalloutAnims1::Unarmed;
        break;
    case CritterActionAnim::IdleCombat:
        fActionAnim = FalloutAnims2::Stay;
        flags |= AnimHelpers::ANIM_FLAG_FIRST_FRAME;
        break;
    case CritterActionAnim::PunchRight:
        fActionAnim = FalloutAnims2Unarmed::Punch;
        fStateAnim = FalloutAnims1::Unarmed;
        break;
    case CritterActionAnim::KickHi:
        fActionAnim = FalloutAnims2Unarmed::Kick;
        fStateAnim = FalloutAnims1::Unarmed;
        break;
    case CritterActionAnim::Thrust1H:
        fActionAnim = FalloutAnims2::Thrust;
        break;
    case CritterActionAnim::Thrust2H:
        fActionAnim = FalloutAnims2::Thrust;
        break;
    case CritterActionAnim::Swing1H:
        fActionAnim = FalloutAnims2::Swing;
        break;
    case CritterActionAnim::Swing2H:
        fActionAnim = FalloutAnims2::Swing;
        break;
    case CritterActionAnim::Single:
        fActionAnim = FalloutAnims2::Shoot;
        break;
    case CritterActionAnim::Burst:
        fActionAnim = FalloutAnims2::Burst;
        break;
    case CritterActionAnim::Sweep:
        fActionAnim = FalloutAnims2::Burst;
        break;
    case CritterActionAnim::Flame:
        fActionAnim = FalloutAnims2::Flame;
        break;
    case CritterActionAnim::Butt:
        fActionAnim = FalloutAnims2Unarmed::Punch;
        fStateAnim = FalloutAnims1::Unarmed;
        break;
    case CritterActionAnim::Throw:
        if (fStateAnim == FalloutAnims1::Unarmed) {
            fActionAnim = FalloutAnims2Unarmed::ThrowEmpty;
        }
        else {
            fActionAnim = FalloutAnims2::ThrowWeapon;
        }

        break;
    case CritterActionAnim::DodgeFront:
        if (fStateAnim == FalloutAnims1::Unarmed) {
            fActionAnim = FalloutAnims2Unarmed::DodgeEmpty;
        }
        else {
            fActionAnim = FalloutAnims2::DodgeWeapon;
        }

        break;
    case CritterActionAnim::DodgeBack:
        if (fStateAnim == FalloutAnims1::Unarmed) {
            fActionAnim = FalloutAnims2Unarmed::DodgeEmpty;
        }
        else {
            fActionAnim = FalloutAnims2::DodgeWeapon;
        }

        break;
    case CritterActionAnim::DamageFront:
        fActionAnim = FalloutAnims2::DamageFront;
        break;
    case CritterActionAnim::DamageBack:
        fActionAnim = FalloutAnims2::DamageBack;
        break;
    case CritterActionAnim::DamageMulFront:
        fActionAnim = FalloutAnims2::DamageFront;
        break;
    case CritterActionAnim::DamageMulBack:
        fActionAnim = FalloutAnims2::DamageBack;
        break;
    case CritterActionAnim::KnockFront:
        fActionAnim = FalloutAnims2Unarmed::KnockFront;
        fStateAnim = FalloutAnims1::Dead;
        break;
    case CritterActionAnim::KnockBack:
        fActionAnim = FalloutAnims2Unarmed::KnockBack;
        fStateAnim = FalloutAnims1::Dead;
        break;
    case CritterActionAnim::StandupFront:
        fActionAnim = FalloutAnims2Unarmed::StandupFront;
        fStateAnim = FalloutAnims1::Knockout;
        break;
    case CritterActionAnim::StandupBack:
        fActionAnim = FalloutAnims2Unarmed::StandupBack;
        fStateAnim = FalloutAnims1::Knockout;
        break;
    case CritterActionAnim::DeadProneFront:
        fActionAnim = FalloutAnims2Dead::DeadFront2;
        fStateAnim = FalloutAnims1::Dead;
        break;
    case CritterActionAnim::DeadProneBack:
        fActionAnim = FalloutAnims2Dead::DeadBack2;
        fStateAnim = FalloutAnims1::Dead;
        break;
    case CritterActionAnim::DeadBloodySingle:
        fActionAnim = FalloutAnims2Dead::DeadBloodySingle;
        fStateAnim = FalloutAnims1::Dead;
        break;
    case CritterActionAnim::DeadBloodyBurst:
        fActionAnim = FalloutAnims2Dead::DeadBloodyBurst;
        fStateAnim = FalloutAnims1::Dead;
        break;
    case CritterActionAnim::DeadBurst:
        fActionAnim = FalloutAnims2Dead::DeadBurst;
        fStateAnim = FalloutAnims1::Dead;
        break;
    case CritterActionAnim::DeadPulse:
        fActionAnim = FalloutAnims2Dead::DeadPulse;
        fStateAnim = FalloutAnims1::Dead;
        break;
    case CritterActionAnim::DeadPulseDust:
        fActionAnim = FalloutAnims2Dead::DeadPulseDust;
        fStateAnim = FalloutAnims1::Dead;
        break;
    case CritterActionAnim::DeadLaser:
        fActionAnim = FalloutAnims2Dead::DeadLaser;
        fStateAnim = FalloutAnims1::Dead;
        break;
    case CritterActionAnim::DeadFused:
        fActionAnim = FalloutAnims2Dead::DeadFused;
        fStateAnim = FalloutAnims1::Dead;
        break;
    case CritterActionAnim::DeadExplode:
        fActionAnim = FalloutAnims2Dead::DeadExplode;
        fStateAnim = FalloutAnims1::Dead;
        break;

    case CritterActionAnim::IdleProneFront:
        fActionAnim = FalloutAnims2Unarmed::KnockFront;
        fStateAnim = FalloutAnims1::Dead;
        flags |= AnimHelpers::ANIM_FLAG_LAST_FRAME;
        break;
    case CritterActionAnim::IdleProneBack:
        fActionAnim = FalloutAnims2Unarmed::KnockBack;
        fStateAnim = FalloutAnims1::Dead;
        flags |= AnimHelpers::ANIM_FLAG_LAST_FRAME;
        break;

    case CritterActionAnim::DeadBurn:
        fActionAnim = FalloutAnims2Dead::DeadBurn;
        fStateAnim = FalloutAnims1::Dead;
        break; // альтернатива: FalloutAnims2Dead::DeadBurn2
    case CritterActionAnim::DeadBurnRun:
        fActionAnim = FalloutAnims2Dead::DeadBurnRun;
        fStateAnim = FalloutAnims1::Dead;
        fActionAnimEx = FalloutAnims2Dead::DeadBurn;
        fStateAnimEx = FalloutAnims1::Dead;
        break;

    case CritterActionAnim::DeadFront:
        fStateAnim = FalloutAnims1::Dead;
        fStateAnimEx = FalloutAnims1::Dead;
        fActionAnim = FalloutAnims2Unarmed::KnockFront;
        fActionAnimEx = FalloutAnims2Dead::DeadFront2;
        break;
    case CritterActionAnim::DeadBack:
        fStateAnim = FalloutAnims1::Dead;
        fStateAnimEx = FalloutAnims1::Dead;
        fActionAnim = FalloutAnims2Unarmed::KnockBack;
        fActionAnimEx = FalloutAnims2Dead::DeadBack2;
        break;
    case CritterActionAnim::NoRecoil:
    case CritterActionAnim::Reload:
    case CritterActionAnim::Repair:
        fStateAnimEx = fStateAnim;
        fActionAnim = FalloutAnims2::PrepareWeapon;
        fActionAnimEx = FalloutAnims2::TurnoffWeapon;
        break;

    // Действия без Fallout-маппинга (попадают в default -> false); список оставлен как breadcrumb:
    // CritterActionAnim::BeginCombat
    // CritterActionAnim::EndCombat
    // CritterActionAnim::PunchLeft
    // CritterActionAnim::PunchCombo
    // CritterActionAnim::KickLo
    // CritterActionAnim::KickCombo
    // CritterActionAnim::WalkDamageFront
    // CritterActionAnim::WalkDamageBack
    // CritterActionAnim::LimpDamageFront
    // CritterActionAnim::LimpDamageBack
    // CritterActionAnim::RunDamageFront
    // CritterActionAnim::RunDamageBack
    // CritterActionAnim::LaydownFront
    // CritterActionAnim::LaydownBack
    // CritterActionAnim::DamageProneFront
    // CritterActionAnim::DamageProneBack
    // CritterActionAnim::DamageMulProneFront
    // CritterActionAnim::DamageMulProneBack
    // CritterActionAnim::TwitchProneFront
    // CritterActionAnim::TwitchProneBack
    default:
        return false;
    }

    return true;
}

#if CLIENT || MAPPER

uint LoadRaw(hstring modelName, int state, int action)
{
    const string suffixes = "_abcdefghijklmnopqrstuvwxyz0123456789";
    verify(state > 0 && state < int(suffixes.length()) && action > 0 && action < int(suffixes.length()), "Некорректный индекс Fallout-анимации");
    string model = modelName;
    int extension = model.findLast(".");
    verify(extension >= 2, "У модели Fallout отсутствует анимационный суффикс");
    string stem = model.substr(0, extension - 2) + suffixes[state] + suffixes[action];
    uint sprite = Game.IsResourcePresent(stem + ".fofrm") ? Game.LoadMapSprite(stem + ".fofrm") : 0;
    return sprite != 0 ? sprite : (Game.IsResourcePresent(stem + ".frm") ? Game.LoadMapSprite(stem + ".frm") : 0);
}

ipos TotalMotion(uint sprite, mdir dir)
{
    ipos motion;
    for (int frame = 0; frame < Game.GetSpriteFrameCount(sprite); frame++) {
        motion += Game.GetSpriteFrameMotion(sprite, frame, dir);
    }
    return motion;
}

// Опорного файла может не быть у конкретного типа: тогда его поправка отсутствует.
void AddReference(hstring model, int state, int action, bool drawOffset, bool motion, ipos[] & shifts)
{
    uint reference = LoadPart(model, state, action);
    if (reference == 0) {
        return;
    }
    for (int d = 0; d < shifts.length(); d++) {
        mdir dir = mdir(hdir(d));
        if (drawOffset) {
            shifts[d] += Game.GetSpriteFrameOffset(reference, 0, dir);
        }
        if (motion) {
            shifts[d] += TotalMotion(reference, dir);
        }
    }
    Game.FreeSprite(reference);
}

uint LoadPart(hstring model, int state, int action)
{
    uint raw = LoadRaw(model, state, action);
    if (raw == 0) {
        return 0;
    }
    int dirs = Game.GetSpriteDirectionCount(raw);
    ipos[] shifts = {};
    shifts.resize(dirs);

    if (state == FalloutAnims1::Unarmed) {
        if (action == FalloutAnims2::Stay || action == FalloutAnims2::Walk || action == FalloutAnims2Unarmed::Run) {
            return raw;
        }
        AddReference(model, FalloutAnims1::Unarmed, FalloutAnims2::Stay, true, false, shifts);
    }
    else if (state >= FalloutAnims1::Knife && state <= FalloutAnims1::RocketLauncher) {
        if (action == FalloutAnims2::Walk) {
            return raw;
        }
        if (action == FalloutAnims2::Show) {
            AddReference(model, FalloutAnims1::Unarmed, FalloutAnims2::Stay, true, false, shifts);
        }
        else if (action == FalloutAnims2::Stay) {
            AddReference(model, FalloutAnims1::Unarmed, FalloutAnims2::Stay, true, false, shifts);
            AddReference(model, state, FalloutAnims2::Show, false, true, shifts);
        }
        else if (action == FalloutAnims2::Shoot || action == FalloutAnims2::Burst || action == FalloutAnims2::Flame) {
            AddReference(model, state, FalloutAnims2::PrepareWeapon, true, true, shifts);
        }
        else if (action == FalloutAnims2::TurnoffWeapon) {
            AddReference(model, state, state == FalloutAnims1::Minigun ? FalloutAnims2::Burst : FalloutAnims2::Shoot, true, true, shifts);
        }
        else {
            AddReference(model, state, FalloutAnims2::Stay, true, false, shifts);
        }
    }
    else if (state == FalloutAnims1::Dead) {
        if (action == FalloutAnims2Dead::DeadFront2 || action == FalloutAnims2Dead::DeadBack2) {
            int reference = action == FalloutAnims2Dead::DeadFront2 ? int(FalloutAnims2Unarmed::KnockFront) : int(FalloutAnims2Unarmed::KnockBack);
            AddReference(model, FalloutAnims1::Dead, reference, true, true, shifts);
        }
        else {
            AddReference(model, FalloutAnims1::Unarmed, FalloutAnims2::Stay, true, false, shifts);
        }
    }
    else if (state == FalloutAnims1::Knockout) {
        int reference = action == FalloutAnims2Unarmed::StandupBack ? int(FalloutAnims2Unarmed::KnockBack) : int(FalloutAnims2Unarmed::KnockFront);
        AddReference(model, FalloutAnims1::Dead, reference, true, true, shifts);
    }

    int frameCount = Game.GetSpriteFrameCount(raw);
    uint[] sources = {};
    int[] frames = {};
    ipos[] offsets = {}, motions = {};
    for (int d = 0; d < dirs; d++) {
        mdir dir = mdir(hdir(d));
        for (int frame = 0; frame < frameCount; frame++) {
            sources.insertLast(raw);
            frames.insertLast(frame);
            offsets.insertLast(Game.GetSpriteFrameOffset(raw, frame, dir) + shifts[d]);
            motions.insertLast(Game.GetSpriteFrameMotion(raw, frame, dir));
        }
    }
    uint result = Game.CreateSpriteSequence(sources, frames, offsets, motions, frameCount, Game.GetSpriteDuration(raw));
    Game.FreeSprite(raw);
    return result;
}

uint SelectFrames(uint source, uint flags)
{
    if (flags == 0 && (Game.GetSpriteFrameCount(source) > 1 || Game.GetSpriteDirectionCount(source) > 1)) {
        return source;
    }
    bool first = (flags & AnimHelpers::ANIM_FLAG_FIRST_FRAME) != 0;
    int selected = first ? 0 : Game.GetSpriteFrameCount(source) - 1;
    uint[] sources = {};
    int[] frames = {};
    ipos[] offsets = {}, motions = {};
    for (int d = 0; d < Game.GetSpriteDirectionCount(source); d++) {
        mdir dir = mdir(hdir(d));
        sources.insertLast(source);
        frames.insertLast(selected);
        offsets.insertLast(Game.GetSpriteFrameOffset(source, selected, dir));
        motions.insertLast(first ? Game.GetSpriteFrameMotion(source, 0, dir) : TotalMotion(source, dir));
    }
    uint result = Game.CreateSpriteSequence(sources, frames, offsets, motions, 1, Game.GetSpriteDuration(source));
    Game.FreeSprite(source);
    return result;
}

// Вторая часть уже привязана к концу первой своим опорным смещением; убираем повторный перенос по обеим осям.
uint Join(uint first, uint second)
{
    int firstCount = Game.GetSpriteFrameCount(first);
    int secondCount = Game.GetSpriteFrameCount(second);
    uint[] sources = {};
    int[] frames = {};
    ipos[] offsets = {}, motions = {};
    for (int d = 0; d < Game.GetSpriteDirectionCount(first); d++) {
        mdir dir = mdir(hdir(d));
        ipos firstMotion = TotalMotion(first, dir);
        for (int frame = 0; frame < firstCount + secondCount; frame++) {
            uint source = frame < firstCount ? first : second;
            int index = frame < firstCount ? frame : frame - firstCount;
            sources.insertLast(source);
            frames.insertLast(index);
            offsets.insertLast(Game.GetSpriteFrameOffset(source, index, dir));
            ipos motion = Game.GetSpriteFrameMotion(source, index, dir);
            if (frame == firstCount) {
                motion -= firstMotion;
            }
            motions.insertLast(motion);
        }
    }
    uint result =
        Game.CreateSpriteSequence(sources, frames, offsets, motions, firstCount + secondCount, Game.GetSpriteDuration(first) + Game.GetSpriteDuration(second));
    Game.FreeSprite(first);
    Game.FreeSprite(second);
    return result;
}

uint Resolve(hstring model, CritterStateAnim stateAnim, CritterActionAnim actionAnim)
{
    int state = 0, action = 0, extraState = 0, extraAction = 0;
    uint flags = 0;
    if (!MapAnimation(model, stateAnim, actionAnim, state, action, extraState, extraAction, flags)) {
        return 0;
    }
    uint first = LoadPart(model, state, action);
    if (first == 0) {
        return 0;
    }
    if (extraState != 0 && extraAction != 0) {
        uint second = LoadPart(model, extraState, extraAction);
        if (second == 0) {
            Game.FreeSprite(first);
            return 0;
        }
        return Join(first, second);
    }
    return SelectFrames(first, flags);
}

#endif

}
