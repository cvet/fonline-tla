// NcrKess — серверная логика NPC Кесса из НКР: временное «превращение» полицейского в рейнджера.
// Диалоговый результат SetKessArmourChange запускает цепочку игровых таймеров: через 3 часа
// Кесс меняет модель брони на рейнджерскую (KessRanger) и выкрикивает реплику, а ещё через 5 часов
// возвращается к модели полицейского (KessPoliceman). Стадия хранится в Persistent-свойстве
// NCRKessStageGlobal, чтобы событие не повторялось; вся ветка под #if SERVER.
namespace NcrKess
{

#if SERVER

///@ Property Game Server uint8 NCRKessStageGlobal Mutable Persistent

const hstring CRTYPE_RANGER = "art/critters/hmcmbtaa.frm".hstr();
const hstring CRTYPE_POLICE = "art/critters/nmcoppaa.frm".hstr();
const int STR_NUM_IM_RANGER = 1; // номер строки "я рейнджер" в диалоге кесса

[[DialogResult]]
void SetKessArmourChange(Critter player, Critter npc, any val)
{
    // в течение ближайших игровых суток Кесс не дает квест на прохождение медкомиссии
    // по истечению игровых суток Кесс меняет модельку брони

    // Кесс уже готовится к приему в рейнджеры
    if (Game.NCRKessStageGlobal > 0) {
        return;
    }

    // создаем событие "кесса в рейнджеры!"
    Game.StartTimeEvent(Time::GameHours(3), KessRanger, npc.Id);

    Game.NCRKessStageGlobal = 1;
}

[[TimeEvent]] [[Async]]
void KessRanger(any value)
{
    Critter? kess = Game.GetCritter(value);
    if (kess == null || !Sync::LockCritterWithMap(kess)) {
        return;
    }

    // Кесс уже рейнджер
    if (Game.NCRKessStageGlobal == 2) {
        return;
    }

    // создаем событие "кесса обратно в полицейского"
    // произойдет оно через 5 игровых часов
    Game.StartTimeEvent(Time::GameHours(5), KessPoliceman, value);

    // kess.ChangeCrType( CRTYPE_RANGER );
    kess.ModelNameBase = CRTYPE_RANGER;
    // kess.SetStat(ST_BASE_CRTYPE,CRTYPE_RANGER); устарело
    Messaging::SayShoutOnHead(kess, TextPackKey(TextPackName::Text, "" + (STR_NUM_IM_RANGER)));
    // kess.Say(SAY_SHOUT_ON_HEAD,"Ха! Я рейнджер!");

    Game.NCRKessStageGlobal = 2;
}

[[TimeEvent]] [[Async]]
void KessPoliceman(any value)
{
    Critter? kess = Game.GetCritter(value);
    if (kess == null || !Sync::LockCritterWithMap(kess)) {
        return;
    }

    // Кесс уже полицейский
    if (Game.NCRKessStageGlobal == 0) {
        return;
    }

    // kess.ChangeCrType( CRTYPE_POLICE );
    // kess.SetStat(ST_BASE_CRTYPE,CRTYPE_POLICE); устарело
    kess.ModelNameBase = CRTYPE_POLICE;

    Game.NCRKessStageGlobal = 0;
}

#endif

}
