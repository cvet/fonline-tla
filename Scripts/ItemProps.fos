// ItemProps — централизованные Property-декларации игрового предмета (Item).
// Чистый контракт данных: задаёт набор свойств предмета (вес/объём, броня (компонент Armor),
// препараты (Drug), оружие и режимы применения (Weapon), патроны (Ammo), транспорт (Car), износ, ключи,
// отмычки, переходы карты и т. п.) для движка и геймплейного кода; компоненты
// дверей, контейнеров и замков объявлены в Lockers.
// COMMON: большинство свойств доступны и на сервере, и на клиенте; часть помечена
// Server (только серверная сторона). Код модуля отсутствует — обращение к свойствам
// идёт напрямую как item.<Имя>, к полям компонента — item.<Компонент>.<Поле> после
// проверки item.Has<Компонент>.
namespace ItemProps
{

// Перенесено из Tla.fos; обращение к свойствам — напрямую как item.<Имя>.

///@ Property Item Common int32 Weight
///@ Property Item Common int32 Volume
///@ Property Item Common bool GroundLevel
///@ Property Item Common bool IsShowAnim Mutable PublicSync Persistent // Todo: восстановить работу IsShowAnim/IsShowAnimExt
