// Scenery — серверная логика взаимодействия со статическими объектами сцены: выходы с карты, двери, диалоги и переходы.
// Сторона SERVER. Подписывается на Game.OnStaticItemWalk (OnMapExit): при наступании игрока на грид-выход
//  переносит его на связанную карту (открывая локацию в списке известных) либо выкидывает на глобальную карту.
// ItemStatic-обработчики Dialog/DoorControl/TransferToMap срабатывают при действиях игрока над сценери.
namespace Scenery
{

bool DecodeDoorControlParams(hstring[] params, int& entryNum, bool& toOpen)
{
    int openValue = -1;
    if (params.length() < 2 || !Tla::TryParseSceneryInt(params[0], entryNum, true) || !Tla::TryParseSceneryInt(params[1], openValue) ||
        (openValue != 0 && openValue != 1)) {
        return false;
    }

    toOpen = openValue == 1;
    return true;
}

#if SERVER

[[ModuleInit]]
void InitScenery()
{
    Game.OnStaticItemWalk.Subscribe(OnMapExit);
}

[[Event]]
void OnMapExit(StaticItem item, Critter cr, bool isIn, mdir moveDir)
{
    if (!isIn) {
        return;
    }

    if (item.Type != ItemType::Grid) {
        return;
    }

    if (!cr.ControlledByPlayer) {
        return;
    }

    // Не даём выйти во время боя или уже идущего перехода между картами
    if (Time::IsTimeoutActive(cr.TimeoutBattle) || Time::IsTimeoutActive(cr.TimeoutTransfer)) {
        return;
    }

    hstring mapProto = item.Grid_ToMap;
    if (mapProto != EMPTY_HSTRING) {
        Map? currentMap = cr.GetMap();
        if (currentMap == null) {
            return;
        }

        Map? map = currentMap.GetLocation().GetMap(mapProto);
        if (map == null) {
            throw("Invalid exit map.", cr, mapProto);
        }

        // Открываем локацию в списке известных игроку, если она не скрытая и ещё не отмечена
        if (!map.GetLocation().Hidden) {
            auto knownLocations = cr.KnownLocations.clone();
            if (knownLocations.find(map.GetLocation().Id) == -1) {
                knownLocations.insertLast(map.GetLocation().Id);
                cr.KnownLocations = knownLocations;
            }
        }

        Entrance::CritterTransferToMapEntry(cr, map.Id, item.Grid_ToMapEntry);
    }
    else {
        cr.TransferToGlobal();
    }
}

[[ItemStatic]]
bool Dialog(Critter player, StaticItem scenery, Item? item, any skill) // с ревизии 691 skill — это CritterProperty )
{
    // Запускаем диалог только при обычном взаимодействии со сценери (без применённого скилла и без итема)
    if (skill == CritterProperty::SpecialSkillPickOnGround && item == null) {
        hstring dialogId = Tla::NormalizeSceneryContentId(scenery.SceneryParams[0], "Content::Dialog::");
        if (dialogId == EMPTY_HSTRING) {
            return false;
        }
        Dialogs::RunDialog(player, dialogId, false);
        return true;
    }

    return false;
}

[[ItemStatic]]
bool DoorControl(Critter player, StaticItem scenery, Item item, any skill)
{
    auto params = scenery.SceneryParams;
    int entryNum = -1;
    bool toOpen = false;
    if (!DecodeDoorControlParams(params, entryNum, toOpen)) {
        throw("Invalid DoorControl scenery parameters", player, scenery);
    }

    Stdlib::DoorControl(player, entryNum, toOpen);
    return true;
}

[[ItemStatic]]
bool TransferToMap(Critter player, StaticItem scenery, Item item, any skill)
{
    auto params = scenery.SceneryParams;
    hstring locPid = params[0];
    int mapIndex = params[1].uhash;
    int entry = params[2].uhash;
    return Stdlib::TransferToMap(player, locPid, mapIndex, entry);
}

#endif

}
