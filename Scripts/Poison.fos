// Poison — серверная система отравления криттеров (перенос механики Fallout 2).
// Держит уровень яда (PoisoningLevel), периодически наносит урон и шлёт игроку сообщения
// через таймерное событие Poison; AffectPoison/DropPoison наносят и снимают отравление
// (яд, антидот). Работает только на стороне SERVER (#if SERVER).
namespace Poison
{

#if SERVER

// Оригинальная система отравления из Fallout 2

const int POISON_BASE_DURATION_SECONDS = 505;
const int POISON_DURATION_SUB = 5;

const int STR_POISON_GAIN = 12810;
const int STR_POISON_PROCESS = 12811;
const int STR_POISON_REDUCE = 12812;
const int STR_POISON_FREE = 12813;

void AffectPoison(Critter cr, int value)
{
    if (cr.IsDead()) {
        return;
    }

    bool isActive = cr.CountTimeEvent(Poison) != 0;
    int levelVal = cr.PoisoningLevel;
    int resistVal = cr.DamageResistance[DamageTypes::Poison];

    if (value > 0) {
        value -= value * resistVal / 100;
    }
    else if (levelVal == 0) {
        return;
    }

    cr.PoisoningLevel = Math::Clamp(levelVal + value, 0, 2000);
    levelVal = cr.PoisoningLevel;

    int strNum = 0;
    if (levelVal == 0) {
        strNum = STR_POISON_FREE;
    }
    else if (value > 0) {
        strNum = STR_POISON_GAIN;
    }
    else if (value < 0) {
        strNum = STR_POISON_REDUCE;
    }

    if (strNum != 0) {
        Messaging::Info(cr, TextPackKey(TextPackName::Game, "" + (strNum)));
    }

    if (levelVal > 0) {
        if (!cr.IsPoisoned) {
            cr.IsPoisoned = true;
        }

        if (levelVal > 100) {
            int hp = levelVal - 100;
            cr.CurrentHp -= hp;
            if (cr.CurrentHp <= 0) {
                CritterState::ToDead(cr, Game.Random(0, 1) == 0 ? CritterActionAnim::DeadFront : CritterActionAnim::DeadBack, null);
            }

            cr.PoisoningLevel = 100;
        }
    }
    else {
        if (cr.IsPoisoned) {
            cr.IsPoisoned = false;
        }
    }

    if (isActive) {
        // Ускоряем событие, если стал доступен новый уровень яда
        if (levelVal == 0) {
            cr.StopTimeEvent(Poison);
        }
        else {
            //int oldDuration = durations[0];
            auto newDuration = GetPoisonDuration(cr);
            //if (newDuration < oldDuration) {
            //    cr.ChangeTimeEvent(indexes[0], newDuration, 0);
            //}
            cr.StopTimeEvent(Poison);
            cr.StartTimeEvent(newDuration, Poison);
        }
    }
    else {
        // Запускаем новое событие
        cr.StartTimeEvent(GetPoisonDuration(cr), Poison);
    }
}

void DropPoison(Critter cr)
{
    cr.StopTimeEvent(Poison);
    cr.PoisoningLevel = 0;
    if (cr.IsPoisoned) {
        cr.IsPoisoned = false;
    }
}

[[TimeEvent]] [[Async]]
void Poison(Critter cr, TimeEventContext event)
{
    if (!Sync::LockCritterWithMap(cr)) {
        return;
    }

    if (cr.IsDead()) {
        timespan delayTicks = Time::Seconds(100);
        if (delayTicks != ZERO_TIMESPAN) {
            event.Repeat(delayTicks);
        }

        return;
    }

    int levelVal = cr.PoisoningLevel;
    if (levelVal > 0) {
        Messaging::Info(cr, TextPackKey(TextPackName::Game, "" + (STR_POISON_PROCESS)));
        cr.PoisoningLevel = Math::Clamp(levelVal - 2, 0, 2000);
        cr.CurrentHp -= 1;
        if (cr.CurrentHp <= 0) {
            CritterState::ToDead(cr, Game.Random(0, 1) == 0 ? CritterActionAnim::DeadFront : CritterActionAnim::DeadBack, null);
        }
    }

    if (cr.PoisoningLevel == 0) {
        Messaging::Info(cr, TextPackKey(TextPackName::Game, "" + (STR_POISON_FREE)));
        if (cr.IsPoisoned) {
            cr.IsPoisoned = false;
        }

        return;
    }

    timespan delayTicks = GetPoisonDuration(cr);
    if (delayTicks != ZERO_TIMESPAN) {
        event.Repeat(delayTicks);
    }
}

timespan GetPoisonDuration(Critter cr)
{
    auto duration = POISON_BASE_DURATION_SECONDS;
    int levelVal = cr.PoisoningLevel;
    if (levelVal == 0) {
        return ZERO_TIMESPAN;
    }

    duration -= levelVal * POISON_DURATION_SUB;
    if (duration <= 0) {
        duration = 1;
    }

    return Time::Seconds(duration);
}

/* Реверс-инжиниринг механики отравления Fallout 2 (автор Atom)

   Один "tick" = 0.1 секунды (единица измерения времени в fallout),

   Каждый раз при изменении уровня яда на N (N может быть >0 или <0) происходит следующее:

   AdjustPoison(int N) // оригинальная версия fallout
   {
   if (N <= 0)
   {
    poison_level+=N;
    if (poison_level<0) poison_level=0;
   }

   if (N>0) poison_level += N * (100 - poison_resistance) / 100;

   if (poison_level > 0)
   {
    delete time event "check poison", if there is one;
    add new time event "check poison" Max(5050-50*poison_level,0) ticks from now;
   }
   }

   Событие "check poison" делает следующее:
   {
   AdjustPoison(-2);
   injure_critter(1); // это "нештатный" урон
   }

   -------------
   Примечание: fallout часто добавляет события со временем = 0, но их можно разрешить сразу. Так всегда происходит при poison_level>100, поэтому
   AdjustPoison легко переписать так:

   AdjustPoison(int N)  // упрощённая версия fallout
   {
   if (N <= 0)
   {
    poison_level+=N;
    if (poison_level<0) poison_level=0;
   }

   if (N>0) then poison_level += N * (100 - poison_resistance) / 100;

   if (poison_level > 0)
   {
    if (poison_level > 100)
    {
      injure_critter(poison_level - 100);
      poison_level=100;
    }

    delete time event "check poison", if there is one;
    add new time event "check poison" Max(5050-50*poison_level,0) ticks from now;
   }
   }

   Примечание: теперь о следующей проблеме - даже если событие "check poison" запланировано через 1 секунду, изменение (например, снятие) яда
   удалит это событие и поставит новое. Но лучше брать min(старое время, новое время). Кроме того, ещё один баг (а может, и не баг?): если событие
   уже поставлено, и кто-то пьёт антидот, обнуляя poison_level, событие не удаляется. Поэтому:

   AdjustPoison(int N)  // исправленная и отлаженная версия fallout
   {
   if (N <= 0)
   {
    poison_level+=N;
    if (poison_level<0) poison_level=0;
    if (poison_level==0) delete time event "check poison", if there is one; // эта строка спорная
   }

   if (N>0) then poison_level += N * (100 - poison_resistance) / 100;



   if (poison_level > 0)
   {
    if (poison_level > 100)
    {
      injure_critter(poison_level - 100);
      poison_level=100;
    }

    int time = 5050-50*poison_level;
    if (there is an "check poison" event)
    {
      int oldtime = old_event_time
      if (time<oldtime)
      {
        delete time event "check poison", if there is one;
        add new time event "check poison" (5050-50*poison_level) ticks from now;
      }
    }
    else
      add new time event "check poison" (5050-50*poison_level) ticks from now;
   }
   else
    delete time event "check poison", if there is one;
   }

   {12810}{}{You have been poisoned!}
   {12811}{}{You take damage from poison.}
   {12812}{}{You feel a little better.}
   {12813}{}{You feel better.}
 */

#endif

}
