// Test_Caravan — регрессии отбора игроков в подготовленную группу каравана.
// Проверяет чистую часть механики независимо от async-захвата проводника, карты и участников.
namespace Test_Caravan
{

#if SERVER

[[ModuleInit]]
void InitTestCaravan()
{
    Game.OnTestingInit.Subscribe(OnTestingInit);
}

[[Event]]
void OnTestingInit()
{
    Testing::RegisterTest("caravan", "prepared_member_policy", PreparedMemberPolicy);
}

void PreparedMemberPolicy(Testing::TestContext ctx)
{
    Testing::Expect(ctx,
                    Caravan::CanJoinPreparedCaravan(false, true, Caravan::LEADER_SEARCH_RADIUS),
                    "Живой игрок на карте проводника должен приниматься на границе радиуса");
    Testing::Expect(ctx, !Caravan::CanJoinPreparedCaravan(true, true, 0), "Мёртвый игрок не должен попадать в группу");
    Testing::Expect(ctx, !Caravan::CanJoinPreparedCaravan(false, false, 0), "Игрок с другой карты не должен попадать в группу по совпавшим координатам");
    Testing::Expect(ctx,
                    !Caravan::CanJoinPreparedCaravan(false, true, Caravan::LEADER_SEARCH_RADIUS + 1),
                    "Игрок за пределами радиуса проводника не должен попадать в группу");
}

#endif

}
