// Test_Scenery — чистые тесты декодирования параметров статических объектов сцены.
namespace Test_Scenery
{

#if SERVER

[[ModuleInit]]
void InitTestScenery()
{
    Game.OnTestingInit.Subscribe(OnTestingInit);
}

[[Event]]
void OnTestingInit()
{
    Testing::RegisterTest("scenery", "door_control_params", DoorControlParams);
    Testing::RegisterTest("scenery", "dialog_content_id", DialogContentId);
}

void DoorControlParams(Testing::TestContext ctx)
{
    int entryNum = -1;
    bool toOpen = false;
    if (!Testing::Expect(ctx, Scenery::DecodeDoorControlParams({"@17".hstr(), "1".hstr()}, entryNum, toOpen), "Legacy entry и флаг двери декодируются")) {
        return;
    }
    if (!Testing::ExpectEq(ctx, entryNum, 17, "Legacy entry теряет только префикс @")) {
        return;
    }
    if (!Testing::Expect(ctx, toOpen, "Флаг 1 открывает дверь")) {
        return;
    }

    Testing::Expect(ctx, !Scenery::DecodeDoorControlParams({"@17".hstr(), "2".hstr()}, entryNum, toOpen), "Неизвестный флаг двери отклоняется");
}

void DialogContentId(Testing::TestContext ctx)
{
    if (!Testing::Expect(ctx,
                         Tla::NormalizeSceneryContentId("Content::Dialog::sf_shi_comp".hstr(), "Content::Dialog::") == Content::Dialog::sf_shi_comp,
                         "Авторский префикс диалога снимается")) {
        return;
    }
    if (!Testing::Expect(ctx,
                         Tla::NormalizeSceneryContentId("klam_bboard".hstr(), "Content::Dialog::") == Content::Dialog::klam_bboard,
                         "Bare dialog id сохраняется")) {
        return;
    }

    Testing::Expect(ctx, Tla::NormalizeSceneryContentId("0".hstr(), "Content::Dialog::") == EMPTY_HSTRING, "Нулевой dialog sentinel отключает взаимодействие");
}

#endif

}
