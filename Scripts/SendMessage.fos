// SendMessage — рассылка игровых событий OnMessage между криттерами на сервере.
// Сторона SERVER: помогает определить набор получателей (кто видит криттера,
//  кого видит криттер, вся карта) и разослать им событие Critter.OnMessage,
//  предварительно отсекая самого отправителя и уничтоженные цели.
namespace SendMessage
{

#if SERVER

///@ Event Server Critter OnMessage(Critter sender, int32 msg, any value)

// Отослать сообщение всем, кто видит криттера
void ToWhoSeesMe(Critter cr, int msg, any value)
{
    DispatchMessage(cr, msg, value, cr.GetCritters(CritterSeeType::WhoSeeMe, CritterFindType::NonDeadNpc));
}

// Отослать сообщение всем, кого видит криттер
void ToWhoISee(Critter cr, int msg, any value)
{
    DispatchMessage(cr, msg, value, cr.GetCritters(CritterSeeType::WhoISee, CritterFindType::NonDeadNpc));
}

// Отослать всем на карте
void ToAllOnMap(Critter cr, int msg, any value)
{
    Map? map = cr.GetMap();
    if (map != null) {
        DispatchMessage(cr, msg, value, map.GetCritters(CritterFindType::NonDeadNpc));
    }
}

void DispatchMessage(Critter cr, int msg, any value, Critter[] receivers)
{
    for (int i = 0; i < receivers.length(); i++) {
        if (!cr.IsDestroyed && !receivers[i].IsDestroyed && cr.Id != receivers[i].Id) {
            receivers[i].OnMessage.Fire(cr, msg, value);
        }
    }
}

#endif

}
