// PlayerRegistration — регистрация нового и вход существующего игрока.
// SERVER: разрешает PlayerId по имени через БД-коллекцию "PlayerNames", задаёт набор свойств
//  регистрации (SPECIAL, tag-скиллы, трейты, возраст, пол), валидирует присланные значения,
//  создаёт криттера и логинит через LoginPlayerToNewRecord/LoginPlayerToExistentRecord.
// CLIENT: по событиям соединения (OnConnected и др.) шлёт RemoteCall RegisterNewPlayer/LoginExistingPlayer.
namespace PlayerRegistration
{

///@ Property Game Common CritterProperty[] RegProperties Mutable OwnerSync Persistent
///@ Property Critter Common bool IsGenerated Mutable OwnerSync Persistent
///@ RemoteCall Server LoginExistingPlayer(string name)
///@ RemoteCall Server RegisterNewPlayer(string name, CritterProperty=>int32 props)

#if SERVER

const hstring PlayerNamesCollectionName = "PlayerNames".hstr();
const int LoginSyncMaxAttempts = 16;

void AddLoginSyncEntity(Entity[] & entities, Entity entity)
{
    for (int i = 0; i < entities.length(); i++) {
        if (entities[i] is entity) {
            return;
        }
    }

    entities.insertLast(entity);
}

ident ResolveStoredMainCritterId(ident playerId)
{
    dict<string, string> playerData = Game.DbGetPlayerData(playerId);
    if (!playerData.exists("MainCritterId")) {
        return ZERO_IDENT;
    }

    ident crId = ZERO_IDENT;
    crId.value = playerData["MainCritterId"].toInt64();
    return crId;
}

bool SameLivePlayer(Player? expected, Player? actual)
{
    return (expected == null && actual == null) || (expected != null && actual is expected);
}

[[Async]]
void DisconnectIfAliveSynced(Player player)
{
    if (player.IsDestroyed || !Sync::Lock(player)) {
        return;
    }

    player.Disconnect();
}

// Оставляет во внешнем remote-call контексте полный граф, который LoginPlayerToExistentRecord
// использует после вложенного OnPlayerLogin: оба Player, криттер, его карта и локация.
[[Async]]
bool LockExistingLoginGraph(Player requestPlayer, Player? livePlayer, Critter cr)
{
    Entity[] fixedCover = {requestPlayer};
    if (livePlayer != null) {
        AddLoginSyncEntity(fixedCover, livePlayer);
    }

    if (!Sync::LockCritterWithMapAndLocation(cr, fixedCover)) {
        return false;
    }

    Entity[] initialInfoCover = Sync::Snapshot();
    if (!GlobalMapLocations::LockKnownLocations(cr, initialInfoCover)) {
        return false;
    }

    initialInfoCover = Sync::Snapshot();
    return GlobalmapGroup::LockInitialInfoGroup(cr, initialInfoCover);
}

// При неудаче подготовки возвращаем загруженный этим запросом экземпляр в состояние unloaded.
// Документ существующего персонажа сохраняется; следующий login загрузит его заново.
[[Async]]
void CleanupLoadedLoginCritter(Critter? loadedCritter)
{
    if (loadedCritter == null || loadedCritter.IsDestroyed) {
        return;
    }

    Critter cr = loadedCritter;
    Entity[] cover = Sync::SurvivingSnapshot();
    if (!Sync::LockCritterWithMapAndLocation(cr, cover)) {
        return;
    }

    Critter? registeredCritter = Game.GetCritter(cr.Id);
    if (registeredCritter !is cr || cr.GetPlayer() != null) {
        return;
    }

    Game.UnloadCritter(cr);
}

[[Async]]
bool FailPreparedExistingLogin(Critter? loadedCritter)
{
    CleanupLoadedLoginCritter(loadedCritter);
    return false;
}

// Новый криттер ещё не связан с Player record. Любой отказ до LoginPlayerToNewRecord должен
// удалить и live-сущность, и созданный persistent-документ, иначе в базе останется orphan.
[[Async]]
bool RollbackUnregisteredCritter(Critter cr, ident crId)
{
    if (!cr.IsDestroyed) {
        if (!Sync::LockCritterWithMapAndLocation(cr)) {
            Game.Log("Unable to lock an unregistered critter for rollback " + crId);
            return false;
        }

        if (cr.GetPlayer() != null) {
            return false;
        }

        Game.UnloadCritter(cr);
    }

    if (Game.GetCritter(crId) != null) {
        return false;
    }

    Game.DestroyUnloadedCritter(crId);
    return true;
}

// Подготавливает граф до входа в движковую функцию. Загруженный криттер размещается уже после
// возврата LoadCritter, поэтому OnCritterInit больше не меняет топологию в отдельном SyncContext.
[[Async]]
bool PrepareExistingLogin(Player requestPlayer, ident playerId, Critter? & loadedByRequest)
{
    loadedByRequest = null;

    for (int attempt = 0; attempt < LoginSyncMaxAttempts; attempt++) {
        Player? livePlayer = Game.GetPlayer(playerId);
        Entity[] baseCover = {requestPlayer};
        if (livePlayer != null) {
            AddLoginSyncEntity(baseCover, livePlayer);
        }

        if (!Sync::Lock(baseCover)) {
            return FailPreparedExistingLogin(loadedByRequest);
        }

        Player? currentLivePlayer = Game.GetPlayer(playerId);
        if (!SameLivePlayer(livePlayer, currentLivePlayer)) {
            continue;
        }

        ident mainCritterId = livePlayer != null ? livePlayer.MainCritterId : ResolveStoredMainCritterId(playerId);
        if (mainCritterId == ZERO_IDENT) {
            return FailPreparedExistingLogin(loadedByRequest);
        }

        Critter? cr = livePlayer != null ? livePlayer.GetControlledCritter() : null;
        if (cr != null && cr.Id != mainCritterId) {
            return FailPreparedExistingLogin(loadedByRequest);
        }

        if (cr == null) {
            cr = Game.GetCritter(mainCritterId);
        }

        bool loadedCritter = false;
        if (cr == null) {
            try {
                cr = Game.LoadCritter(mainCritterId, true);
                loadedCritter = true;
                loadedByRequest = cr;
            }
            catch {
                // Допустим только race с другим запросом, уже зарегистрировавшим тот же id.
                cr = Game.GetCritter(mainCritterId);
                if (cr == null) {
                    throw("LoadCritter failed without a concurrently registered critter", mainCritterId);
                }
            }
        }

        if (cr == null) {
            return FailPreparedExistingLogin(loadedByRequest);
        }

        Critter mainCritter = cr;
        Entity[] loadedCover = baseCover.clone();
        AddLoginSyncEntity(loadedCover, mainCritter);
        if (!Sync::Lock(loadedCover)) {
            return FailPreparedExistingLogin(loadedByRequest);
        }

        if (loadedCritter && !Main::PlacePlayerAfterInitialization(mainCritter)) {
            return FailPreparedExistingLogin(loadedByRequest);
        }

        if (!LockExistingLoginGraph(requestPlayer, livePlayer, mainCritter)) {
            continue;
        }

        currentLivePlayer = Game.GetPlayer(playerId);
        if (!SameLivePlayer(livePlayer, currentLivePlayer)) {
            continue;
        }
        if (livePlayer != null) {
            if (livePlayer.MainCritterId != mainCritterId) {
                continue;
            }

            Critter? controlledCritter = livePlayer.GetControlledCritter();
            if (controlledCritter != null && controlledCritter !is mainCritter) {
                continue;
            }
        }

        return true;
    }

    return FailPreparedExistingLogin(loadedByRequest);
}

Player? GetPlayerByName(string playerName)
{
    ident playerId = ResolvePlayerIdByName(playerName);
    return playerId != ZERO_IDENT ? Game.GetPlayer(playerId) : null;
}

ident ResolvePlayerIdByName(string playerName)
{
    if (!Game.DbHasRecord(PlayerNamesCollectionName, playerName)) {
        return ZERO_IDENT;
    }

    dict<string, string> linkEntry = Game.DbGetRecord(PlayerNamesCollectionName, playerName);
    if (!linkEntry.exists("PlayerId")) {
        return ZERO_IDENT;
    }

    ident playerId = ZERO_IDENT;
    playerId.value = linkEntry["PlayerId"].toInt64();
    return playerId;
}

bool IsPlayerNameClaimed(string playerName)
{
    return Game.DbHasRecord(PlayerNamesCollectionName, playerName);
}

void CreatePlayerNameReservation(string playerName, ident crId)
{
    Game.DbInsertRecord(PlayerNamesCollectionName, playerName, {{"_Name", playerName}, {"CritterId", "" + crId.value}});
}

bool CommitPlayerNameReservation(string playerName, ident crId, ident playerId)
{
    if (!Game.DbHasRecord(PlayerNamesCollectionName, playerName)) {
        return false;
    }

    dict<string, string> linkEntry = Game.DbGetRecord(PlayerNamesCollectionName, playerName);
    if (linkEntry.exists("PlayerId")) {
        ident storedPlayerId = ZERO_IDENT;
        storedPlayerId.value = linkEntry["PlayerId"].toInt64();
        return storedPlayerId == playerId;
    }
    if (!linkEntry.exists("CritterId")) {
        return false;
    }

    ident storedCritterId = ZERO_IDENT;
    storedCritterId.value = linkEntry["CritterId"].toInt64();
    if (storedCritterId != crId) {
        return false;
    }

    Game.DbUpdateRecordInt64(PlayerNamesCollectionName, playerName, "PlayerId", playerId.value);
    return true;
}

void RemovePlayerNameReservation(string playerName, ident crId)
{
    if (!Game.DbHasRecord(PlayerNamesCollectionName, playerName)) {
        return;
    }

    dict<string, string> linkEntry = Game.DbGetRecord(PlayerNamesCollectionName, playerName);
    if (!linkEntry.exists("CritterId")) {
        return;
    }

    ident storedCritterId = ZERO_IDENT;
    storedCritterId.value = linkEntry["CritterId"].toInt64();
    if (storedCritterId == crId) {
        Game.DbRemoveRecord(PlayerNamesCollectionName, playerName);
    }
}

[[Async]]
void RollbackNewPlayerRegistration(string playerName, Critter cr, ident crId)
{
    if (!RollbackUnregisteredCritter(cr, crId)) {
        Game.Log("Player name reservation retained because critter rollback failed " + crId);
        return;
    }

    RemovePlayerNameReservation(playerName, crId);
}

// Публикует PlayerId внутри OnPlayerLogin. Если этот обработчик или следующий подписчик
// откажет во входе, движок ещё откатит Player record, а внешний registration-вызов удалит резерв.
[[Event]] [[Async]]
EventResult CommitReservedPlayerNameOnLogin(Player player, Player? unloginedPlayer)
{
    if (!Sync::Lock(player)) {
        return EventResult::StopChain;
    }

    string playerName = player.Name;
    if (!Game.DbHasRecord(PlayerNamesCollectionName, playerName)) {
        return EventResult::ContinueChain;
    }

    dict<string, string> linkEntry = Game.DbGetRecord(PlayerNamesCollectionName, playerName);
    if (linkEntry.exists("PlayerId") || !linkEntry.exists("CritterId")) {
        return EventResult::ContinueChain;
    }

    ident crId = ZERO_IDENT;
    crId.value = linkEntry["CritterId"].toInt64();
    if (crId != player.MainCritterId || !CommitPlayerNameReservation(playerName, crId, player.Id)) {
        Game.Log("Player name reservation does not match the registering player");
        return EventResult::StopChain;
    }

    return EventResult::ContinueChain;
}

[[ModuleInit]]
void InitPlayerRegistration()
{
    Game.OnPlayerLogin.Subscribe(CommitReservedPlayerNameOnLogin);

    // RegProperties — Persistent-массив; очищаем перед заполнением, иначе на каждом старте сервера накапливаются дубли
    Game.RegProperties = {};
    AddRegistrationProperty(CritterProperty::StrengthBase);
    AddRegistrationProperty(CritterProperty::PerceptionBase);
    AddRegistrationProperty(CritterProperty::EnduranceBase);
    AddRegistrationProperty(CritterProperty::CharismaBase);
    AddRegistrationProperty(CritterProperty::IntellectBase);
    AddRegistrationProperty(CritterProperty::AgilityBase);
    AddRegistrationProperty(CritterProperty::LuckBase);
    AddRegistrationProperty(CritterProperty::TagSkill1);
    AddRegistrationProperty(CritterProperty::TagSkill2);
    AddRegistrationProperty(CritterProperty::TagSkill3);
    for (int i = 0; i < CritterPropertyGroup::Traits.length(); i++) {
        AddRegistrationProperty(CritterPropertyGroup::Traits[i]);
    }

    AddRegistrationProperty(CritterProperty::Age);
    AddRegistrationProperty(CritterProperty::Gender);
}

void AddRegistrationProperty(CritterProperty prop)
{
    auto properies = Game.RegProperties;
    properies.insertLast(prop);
    Game.RegProperties = properies;
}

[[ServerRemoteCall]] [[Async]]
void LoginExistingPlayer(Player player, string name)
{
    ident playerId = ResolvePlayerIdByName(name);
    if (playerId == ZERO_IDENT) {
        Messaging::Info(player, TextPackKey(TextPackName::Game, "" + (MsgStr::STR_NET_WRONG_LOGIN)));
        player.Disconnect();
        return;
    }

    Critter? loadedByRequest = null;
    if (!PrepareExistingLogin(player, playerId, loadedByRequest)) {
        Game.Log("Player login rejected because the entity sync graph could not be stabilized");
        DisconnectIfAliveSynced(player);
        return;
    }

    player.SetName(name);
    try {
        Game.LoginPlayerToExistentRecord(player, playerId);
    }
    catch {
        CleanupLoadedLoginCritter(loadedByRequest);
        throw("Existing player login failed after sync preparation", playerId);
    }
}

bool ValidateRegistrationProps(Player player, string name, dict<CritterProperty, int> props)
{
    int nameError = Parameters::CheckPlayerName(name);
    if (nameError != 0) {
        Messaging::Info(player, TextPackKey(TextPackName::Game, "" + (nameError)));
        Game.Log("Player registration rejected due to invalid name");
        return false;
    }

    for (int i = 0; i < Game.RegProperties.length(); i++) {
        if (!props.exists(Game.RegProperties[i])) {
            Messaging::Info(player, TextPackKey(TextPackName::Game, "" + (MsgStr::StrNetWrongSpecial)));
            Game.Log("Player registration rejected due to missing registration prop");
            return false;
        }
    }

    for (int i = 0; i < props.length(); i++) {
        if (Game.RegProperties.find(props.getKey(i)) == -1) {
            Messaging::Info(player, TextPackKey(TextPackName::Game, "" + (MsgStr::StrNetWrongSpecial)));
            Game.Log("Player registration rejected due to unexpected registration prop");
            return false;
        }
    }

    int special = 0;
    for (int i = 0; i < CritterPropertyGroup::SpecialBase.length(); i++) {
        CritterProperty prop = CritterPropertyGroup::SpecialBase[i];
        int value = props.get(prop, 0);

        if (value < 1 || value > 10) {
            Messaging::Info(player, TextPackKey(TextPackName::Game, "" + (MsgStr::StrNetWrongSpecial)));
            Game.Log("Player registration rejected due to invalid SPECIAL values");
            return false;
        }

        special += value;
    }

    if (special != Settings.Player.StartSpecialPoints) {
        Messaging::Info(player, TextPackKey(TextPackName::Game, "" + (MsgStr::StrNetWrongSpecial)));
        Game.Log("Player registration rejected due to invalid SPECIAL sum");
        return false;
    }

    if ((props.get(CritterProperty::TagSkill1, CritterProperty::None) != CritterProperty::None &&
         CritterPropertyGroup::Skills.find(CritterProperty(props.get(CritterProperty::TagSkill1, CritterProperty::None))) == -1) ||
        (props.get(CritterProperty::TagSkill2, CritterProperty::None) != CritterProperty::None &&
         CritterPropertyGroup::Skills.find(CritterProperty(props.get(CritterProperty::TagSkill2, CritterProperty::None))) == -1) ||
        (props.get(CritterProperty::TagSkill3, CritterProperty::None) != CritterProperty::None &&
         CritterPropertyGroup::Skills.find(CritterProperty(props.get(CritterProperty::TagSkill3, CritterProperty::None))) == -1)) {
        Messaging::Info(player, TextPackKey(TextPackName::Game, "" + (MsgStr::StrNetWrongTagskill)));
        Game.Log("Player registration rejected due to invalid tag skills");
        return false;
    }

    return true;
}

[[ServerRemoteCall]] [[Async]]
void RegisterNewPlayer(Player player, string name, dict<CritterProperty, int> props)
{
    if (!ValidateRegistrationProps(player, name, props)) {
        player.Disconnect();
        return;
    }

    if (IsPlayerNameClaimed(name)) {
        Messaging::Info(player, TextPackKey(TextPackName::Game, "" + (MsgStr::STR_NET_ACCOUNT_ALREADY)));
        player.Disconnect();
        return;
    }

    dict<CritterProperty, any> critterProps = {};
    for (int i = 0; i < props.length(); i++) {
        critterProps[props.getKey(i)] = any(props.getValue(i));
    }

    Map? startMap = Replication::GetStartReplicatorMap();
    if (startMap == null) {
        Game.Log("Player registration rejected due to missing start replication map");
        player.Disconnect();
        return;
    }

    if (!Sync::Lock(player, startMap)) {
        DisconnectIfAliveSynced(player);
        return;
    }

    Location startLocation = startMap.GetLocation();
    if (!Sync::Lock(player, startMap, startLocation)) {
        DisconnectIfAliveSynced(player);
        return;
    }

    // Все регистрации проходят через одну стартовую карту. Резерв имени ниже создаётся под этим
    // Game.Sync до следующей замены покрытия: второй запрос увидит запись после разблокировки карты,
    // даже если оба запроса прошли раннюю проверку.
    if (IsPlayerNameClaimed(name)) {
        Messaging::Info(player, TextPackKey(TextPackName::Game, "" + (MsgStr::STR_NET_ACCOUNT_ALREADY)));
        player.Disconnect();
        return;
    }

    player.SetName(name);
    Critter cr = Game.CreateCritter(Content::Critter::Player, true, critterProps);
    ident crId = cr.Id;

    try {
        CreatePlayerNameReservation(name, crId);
    }
    catch {
        RollbackUnregisteredCritter(cr, crId);
        if (IsPlayerNameClaimed(name)) {
            Messaging::Info(player, TextPackKey(TextPackName::Game, "" + (MsgStr::STR_NET_ACCOUNT_ALREADY)));
            player.Disconnect();
            return;
        }

        throw("Unable to reserve a new player name", crId);
    }

    if (!Sync::Lock(array<Entity> = {player, cr, startMap, startLocation})) {
        DisconnectIfAliveSynced(player);
        RollbackNewPlayerRegistration(name, cr, crId);
        return;
    }

    // Криттер игрока должен быть явно Persistent: при офлайн-выгрузке снятие с карты
    // отменяет только неявный флаг Persistent и иначе удаляет его документ из базы.
    cr.MakePersistent(true);

    if (!Main::PlacePlayerAfterInitialization(cr)) {
        Game.Log("Player registration placement failed");
        DisconnectIfAliveSynced(player);
        RollbackNewPlayerRegistration(name, cr, crId);
        return;
    }

    Entity[] newLoginCover = {player};
    if (!Sync::LockCritterWithMapAndLocation(cr, newLoginCover)) {
        DisconnectIfAliveSynced(player);
        RollbackNewPlayerRegistration(name, cr, crId);
        return;
    }

    Entity[] initialInfoCover = Sync::Snapshot();
    if (!GlobalMapLocations::LockKnownLocations(cr, initialInfoCover)) {
        DisconnectIfAliveSynced(player);
        RollbackNewPlayerRegistration(name, cr, crId);
        return;
    }

    initialInfoCover = Sync::Snapshot();
    if (!GlobalmapGroup::LockInitialInfoGroup(cr, initialInfoCover)) {
        DisconnectIfAliveSynced(player);
        RollbackNewPlayerRegistration(name, cr, crId);
        return;
    }

    // MainCritterId нужно задать до LoginPlayerToNewRecord — движок отвергает пустой документ
    // игрока при вставке, а сериализуются только Persistent-свойства. Побочный эффект: движок
    // сам привязывает криттера при логине, поэтому вызов SwitchCritter не требуется.
    player.MainCritterId = cr.Id;
    cr.DisplayName = name;
    cr.IsGenerated = true;

    try {
        Game.LoginPlayerToNewRecord(player);
    }
    catch {
        RollbackNewPlayerRegistration(name, cr, crId);
        throw("New player login failed after critter creation", crId);
    }

    Game.Log("Player registered and entered the game");
}

string GetPlayerName(ident crId)
{
    Critter? cr = Game.GetCritter(crId);
    if (cr != null && cr.ControlledByPlayer) {
        return cr.Name;
    }

    return "";
}

#endif

#if CLIENT

[[ModuleInit]]
void InitPlayerRegistration()
{
    Game.OnConnected.Subscribe(OnConnected);
    Game.OnLoginSuccess.Subscribe(OnLoginSuccess);
    Game.OnConnectingFailed.Subscribe(OnConnectingFailed);
    Game.OnDisconnected.Subscribe(OnDisconnected);
}

dict<CritterProperty, int> RegProps = {};

void ResetRegistrationRequest()
{
    RegProps = {};
}

void CallRegisterPlayer(string name, string pass, dict<CritterProperty, int> props)
{
    // Складываем данные регистрации в кэш — OnConnected прочитает их после установки соединения
    Game.SetCacheText("RegName__", name);
    Game.SetCacheText("RegPassword__", pass);
    RegProps = props.clone();
    GuiScreensExt::TryExit();

    if (!Game.IsConnected() && !Game.IsConnecting()) {
        Game.Connect();
    }
}

[[Event]]
void OnConnected()
{
    string name = Game.GetCacheText("RegName__");

    if (name == "") {
        return;
    }

    if (RegProps.length() > 0) {
        CurPlayer.ServerCall.RegisterNewPlayer(name, RegProps.clone());
    }
    else {
        CurPlayer.ServerCall.LoginExistingPlayer(name);
    }
}

[[Event]]
void OnLoginSuccess()
{
    ResetRegistrationRequest();
}

[[Event]]
void OnConnectingFailed()
{
    ResetRegistrationRequest();
}

[[Event]]
void OnDisconnected()
{
    ResetRegistrationRequest();
}

#endif

}
