{
    {
        // Версия реплики, из которой открыто окно
        uint64 SayRevision;
        uint64 RequestId = 0;
        string Title;
        string InitialText;
        //Признак: не выводить введенный текст в лог
        bool DontShowMessage;
    }
}
//   "OnInit": null,
//   "OnShow":
{
    {
        {
            RequestId = 0;
            Title = ::MsgStr::GetGameText(::MsgStr::StrSayTitle);
            InitialText = "";
            if (params.exists("RequestId")) {
                RequestId = params["RequestId"];
                Title = params["Title"];
                InitialText = params["Input"];
            }
            DontShowMessage = RequestId != 0;
            SayRevision = 0;
            if (params.length() != 0) {
                SayRevision = params["SayRevision"];
            }
        }
    }
}
//   "OnHide":
{
    {
        {
            if (RequestId != 0) {
                CurPlayer.ServerCall.AnswerSayRequest(RequestId, "", true);
                RequestId = 0;
            }
        }
    }
}
