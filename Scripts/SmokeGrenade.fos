// SmokeGrenade — серверная логика дымовых гранат и горчичного газа: облака, штрафы к меткости и урон.
// Разворачивает расширяющееся кольцо дыма/газа по таймеру (SmokeBlast/DoSmokeBlast), ставит и через
//  отложенный таймер удаляет предметы дыма, считает штраф к попаданию для стрелка/цели в облаке
//  (GetSmokePenalty). Горчичный газ при проходе через хекс травит игроков (Poison) и ранит NPC (Combat)
//  через подписку MustardGasWalk. Сторона исполнения — только SERVER.
namespace SmokeGrenade
{

#if SERVER

///@ Property Item Server ident SmokeGrenadeOwnerId Mutable Persistent

const int MAX_STEP = 5;
int SmokeToHitPenalty(Critter attacker)
{
    return attacker.ControlledByPlayer ? 80 : 40;
}
int GasToHitPenalty(Critter attacker)
{
    return attacker.ControlledByPlayer ? 50 : 25;
}
bool RandomRoll(int v1, int v2)
{
    return Game.Random(v1, v2) == 1;
}

int GetSmokePenalty(Map? map, Critter? attacker, Critter? target)
{
    if (map != null) {
        if (attacker != null && map.GetItemOnHex(attacker.Hex, Content::Item::smoke) != null) {
            return SmokeToHitPenalty(attacker);
        }

        if (target != null && map.GetItemOnHex(target.Hex, Content::Item::smoke) != null) {
            return attacker != null ? SmokeToHitPenalty(attacker) : 0;
        }

        if (attacker != null && map.GetItemOnHex(attacker.Hex, Content::Item::mustard_gas) != null) {
            return GasToHitPenalty(attacker);
        }

        if (target != null && map.GetItemOnHex(target.Hex, Content::Item::mustard_gas) != null) {
            return attacker != null ? GasToHitPenalty(attacker) : 0;
        }
    }

    return 0;
}

void SmokeBlast(Map map, mpos hex, hstring smokePid, ident ownerId)
{
    any[] values = {map.Id, hex.x, hex.y, 0, smokePid, ownerId};
    Game.StartTimeEvent(ZERO_TIMESPAN, DoSmokeBlast, values);
}

[[TimeEvent]] [[Async]]
void DoSmokeBlast(any[] values)
{
    if (values.length() < 6) {
        return;
    }

    Map? map = Game.GetMap(ident(values[0]));
    if (map == null) {
        return;
    }

    mpos hex = mpos(values[1], values[2]);
    int step = values[3];
    hstring pid = values[4];
    ident ownerId = values[5];

    Critter? owner = ownerId != ZERO_IDENT ? Game.GetCritter(ownerId) : null;
    Entity[] cover = {map};
    if (owner != null) {
        Sync::AddUniqueEntity(cover, owner);
    }
    if (!Sync::Lock(cover)) {
        return;
    }

    // Чем ниже навык метания у владельца, тем меньше шагов проживёт облако: штраф урезает радиус разлёта.
    int penaltyLowSkill = 0;
    if (owner != null) {
        penaltyLowSkill = 4 - int(Math::Clamp(owner.SkillThrowing, 0, 100) / 25);
    }

    if (step > (MAX_STEP - penaltyLowSkill)) {
        return;
    }

    ident[] smokeIds = {};
    Effects::PlaySound(map, "gas.wav", hex, 25);
    AddSmoke(map, hex, (step == 0 || (step < 2 && RandomRoll(1, 2))), pid, ownerId, smokeIds);

    // Каждый шаг таймера достраивает очередное шестиугольное кольцо дыма вокруг эпицентра;
    // ближние к внешнему краю хексы ставятся с вероятностью, чтобы облако выглядело рваным.
    for (int curStep = 1; curStep < step; curStep++) {
        hex = mpos(values[1], values[2]);
        map.MoveHexByDir(hex, 4, curStep);
        for (int i = 0; i < 6; i++) {
            for (int j = 0; j < curStep; j++) {
                map.MoveHexByDir(hex, i, 1);
                AddSmoke(map, hex, (curStep + 2 > step) || ((curStep + 3 > step) && RandomRoll(1, 2)) || RandomRoll(1, 3), pid, ownerId, smokeIds);
            }
        }
    }

    if (smokeIds.length() > 0) {
        any[] smokeIdsToDel = {};
        for (int i = 0; i < smokeIds.length(); i++) {
            smokeIdsToDel.insertLast(smokeIds[i]);
        }

        Game.StartTimeEvent(GameTime::GameSeconds(Game.Random(4, 6) * (12 - step) * (5 - penaltyLowSkill) / 5),
                            DeleteSmokes,
                            smokeIdsToDel); //SavedDeferredCall
    }

    values[3] = int(values[3]) + 1;

    Game.StartTimeEvent(GameTime::GameSeconds(1), DoSmokeBlast, values);
}

[[TimeEvent]] [[Async]]
void DeleteSmokes(any[] values)
{
    for (int i = 0; i < values.length(); i++) {
        if (values[i] == 0) {
            continue;
        }

        Item? item = Game.GetItem(values[i]);
        if (item == null || !Sync::LockItemWithParent(item)) {
            continue;
        }

        Game.DestroyItem(item);
    }
}

void SmokeInit(Item item, bool firstTime)
{
    if (!firstTime) {
        Game.DestroyItem(item);
    }
    else {
        item.NoBlock = true;
        item.ShootThru = true;
        if (item.ProtoId == Content::Item::mustard_gas) {
            item.OnCritterWalk.Subscribe(MustardGasWalk);
        }

        // Отключённая подписка на завершение предмета: оставлена как след прежней логики очистки дыма.
        // item.OnFinish.Subscribe(_SmokeFinish);
    }
}

[[Event]]
void MustardGasWalk(Item mine, Critter cr, bool entered, mdir dir)
{
    if (entered) {
        if (cr.ControlledByPlayer && !cr.IsNoPvp) {
            Poison::AffectPoison(cr, Game.Random(3, 5));
        }
        else {
            if (!cr.IsInvulnerable) {
                Combat::InjureCritter(cr, Game.Random(1, 2), DamageTypes::Normal, 0, mine.SmokeGrenadeOwnerId);
            }
        }
    }
}

void AddSmoke(Map? map, mpos hex, bool place, hstring pid, ident ownerId, ident[] ids)
{
    if (map != null && place && (map.IsHexMovable(hex) || map.GetCritterOnHex(hex) != null)) {
        Item item = map.AddItem(hex, pid, 1);
        item.SmokeGrenadeOwnerId = ownerId;
        ids.insertLast(item.Id);
        item.SetupScript(SmokeInit);
    }
}

void SmokeBlast(Critter cr, hstring pid)
{
    SmokeBlast(cr.GetMap(), cr.Hex, pid, cr.Id);
}

#endif

}
