// Test_MapPreview — подготовка карт для клиентской проверки городского просмотра и квестовой камеры.
// SERVER: при AiControl.AllowQaCommands создаём локации во время генерации тестового мира,
// чтобы команды подготовки не загружали целую локацию внутри игрового кадра.
namespace Test_MapPreview
{

#if SERVER

[[ModuleInit]]
void InitTestMapPreview()
{
    Game.OnGenerateWorld.Subscribe(PreparePreviewFixtures, EventPriority::Lowest);
}

[[Event]]
void PreparePreviewFixtures()
{
    if (!Settings.AiControl.AllowQaCommands) {
        return;
    }
    hstring[] protos = {Content::Location::arroyo, Content::Location::hubologists_lab, Content::Location::replication_hell};
    ipos[] positions = {ipos(175, 125), ipos(532, 1435), ipos(777, 466)};
    for (int i = 0; i < protos.length(); i++) {
        if (Game.GetLocation(protos[i]) == null) {
            Location loc = Location::CreateLocation(protos[i], positions[i]);
            loc.AutoGarbage = false;
        }
    }
}

#endif

}
