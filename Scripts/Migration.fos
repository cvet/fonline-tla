// Migration — правила миграции сериализованных данных при загрузке сохранёнок/контента.
// Содержит только MigrationRule-декларации движка: удаление и переименования свойств Critter и Item
// Правила сохраняют совместимость старых сохранений с актуальной схемой.
// SERVER: применяется движком на стороне сервера при разборе сериализованных свойств.
namespace Migration
{

#if SERVER

// Idle живого криттера выбирается в Animation::GetIdleActionAnim; сохранённое значение больше не используется.
///@ MigrationRule Property Critter Remove ActionAnimAlive
///@ MigrationRule Property Critter Remove AliveActionAnim

// Переименования свойств криттеров и предметов (старое имя -> новое имя).

///@ MigrationRule Property Critter Rename ActionAnimKnockout KnockoutActionAnim
///@ MigrationRule Property Critter Rename ActionAnimDead DeadActionAnim
///@ MigrationRule Property Critter Rename IsNoFlatten DeadDrawNoFlatten
///@ MigrationRule Property Item Rename Lexems TextArgs
///@ MigrationRule Property Critter Rename Lexems TextArgs

// Компонент Grid: плоские свойства перехода переехали в поля Grid.*. Grid_Type — данные только
// статических прототипов; значения перенесены в контент как Grid.Type (енум GridType), старое имя удаляется.
///@ MigrationRule Property Item Rename Grid_ToMap Grid.ToMap
///@ MigrationRule Property Item Rename Grid_ToMapEntry Grid.ToMapEntry
///@ MigrationRule Property Item Rename Grid_ToMapDir Grid.ToMapDir
///@ MigrationRule Property Item Remove Grid_Type

// Семейство замков: плоские свойства контейнеров, дверей, замков и отмычек переехали в поля компонентов
// Container, Door, Locker и Lockpick. IsLockpick заменён маркером Lockpick: писателей и авторских значений нет.
///@ MigrationRule Property Item Rename Container_Volume Container.Volume
///@ MigrationRule Property Item Rename Container_Changeble Container.Changeble
///@ MigrationRule Property Item Rename Container_CannotPickUp Container.CannotPickUp
///@ MigrationRule Property Item Rename Container_MagicHandsGrnd Container.MagicHandsGrnd
///@ MigrationRule Property Item Rename Door_NoBlockMove Door.NoBlockMove
///@ MigrationRule Property Item Rename Door_NoBlockShoot Door.NoBlockShoot
///@ MigrationRule Property Item Rename Door_NoBlockLight Door.NoBlockLight
///@ MigrationRule Property Item Rename Door_IsMultyHex Door.IsMultyHex
///@ MigrationRule Property Item Rename Door_MultyHexLine1 Door.MultyHexLine1
///@ MigrationRule Property Item Rename Door_MultyHexLine2 Door.MultyHexLine2
///@ MigrationRule Property Item Rename Door_BlockerIds Door.BlockerIds
///@ MigrationRule Property Item Rename Locker_Locked Locker.Locked
///@ MigrationRule Property Item Rename Locker_Jammed Locker.Jammed
///@ MigrationRule Property Item Rename Locker_Broken Locker.Broken
///@ MigrationRule Property Item Rename Locker_NoOpen Locker.NoOpen
///@ MigrationRule Property Item Rename Locker_IsElectro Locker.IsElectro
///@ MigrationRule Property Item Rename Lockpick_Points Lockpick.Points
///@ MigrationRule Property Item Rename Lockpick_IsElectro Lockpick.IsElectro
///@ MigrationRule Property Item Remove IsLockpick

// Компонент Car: плоские свойства транспорта (Car_*) и серверные флаги CarIs* переехали в поля Car.*.
///@ MigrationRule Property Item Rename Car_Speed Car.Speed
///@ MigrationRule Property Item Rename Car_Passability Car.Passability
///@ MigrationRule Property Item Rename Car_DeteriorationRate Car.DeteriorationRate
///@ MigrationRule Property Item Rename Car_CrittersCapacity Car.CrittersCapacity
///@ MigrationRule Property Item Rename Car_TankVolume Car.TankVolume
///@ MigrationRule Property Item Rename Car_MaxDeterioration Car.MaxDeterioration
///@ MigrationRule Property Item Rename Car_FuelConsumption Car.FuelConsumption
///@ MigrationRule Property Item Rename Car_Entrance Car.Entrance
///@ MigrationRule Property Item Rename Car_MovementType Car.MovementType
///@ MigrationRule Property Item Rename CarIsBioEngine Car.IsBioEngine
///@ MigrationRule Property Item Rename CarIsNoLockpick Car.IsNoLockpick

// Компоненты Armor и Ammo: плоские свойства брони (Armor_*) и боеприпасов (Ammo_*) переехали в поля Armor.* и Ammo.*;
// у маркера Drug полей нет.
///@ MigrationRule Property Item Rename Armor_CrTypeMale Armor.CrTypeMale
///@ MigrationRule Property Item Rename Armor_CrTypeFemale Armor.CrTypeFemale
///@ MigrationRule Property Item Rename Armor_AC Armor.AC
///@ MigrationRule Property Item Rename Armor_Perk Armor.Perk
///@ MigrationRule Property Item Rename Armor_DRNormal Armor.DRNormal
///@ MigrationRule Property Item Rename Armor_DRLaser Armor.DRLaser
///@ MigrationRule Property Item Rename Armor_DRFire Armor.DRFire
///@ MigrationRule Property Item Rename Armor_DRPlasma Armor.DRPlasma
///@ MigrationRule Property Item Rename Armor_DRElectr Armor.DRElectr
///@ MigrationRule Property Item Rename Armor_DREmp Armor.DREmp
///@ MigrationRule Property Item Rename Armor_DRExplode Armor.DRExplode
///@ MigrationRule Property Item Rename Armor_DTNormal Armor.DTNormal
///@ MigrationRule Property Item Rename Armor_DTLaser Armor.DTLaser
///@ MigrationRule Property Item Rename Armor_DTFire Armor.DTFire
///@ MigrationRule Property Item Rename Armor_DTPlasma Armor.DTPlasma
///@ MigrationRule Property Item Rename Armor_DTElectr Armor.DTElectr
///@ MigrationRule Property Item Rename Armor_DTEmp Armor.DTEmp
///@ MigrationRule Property Item Rename Armor_DTExplode Armor.DTExplode
///@ MigrationRule Property Item Rename Ammo_Caliber Ammo.Caliber
///@ MigrationRule Property Item Rename Ammo_AcMod Ammo.AcMod
///@ MigrationRule Property Item Rename Ammo_DrMod Ammo.DrMod
///@ MigrationRule Property Item Rename Ammo_DmgMult Ammo.DmgMult
///@ MigrationRule Property Item Rename Ammo_DmgDiv Ammo.DmgDiv

// Компонент Weapon: плоские свойства оружия (Weapon_*) переехали в поля Weapon.*; AmmoPid, AmmoCount, Mode и IsBigGun остаются плоскими.
///@ MigrationRule Property Item Rename Weapon_IsUnarmed Weapon.IsUnarmed
///@ MigrationRule Property Item Rename Weapon_UnarmedTree Weapon.UnarmedTree
///@ MigrationRule Property Item Rename Weapon_UnarmedPriority Weapon.UnarmedPriority
///@ MigrationRule Property Item Rename Weapon_UnarmedMinAgility Weapon.UnarmedMinAgility
///@ MigrationRule Property Item Rename Weapon_UnarmedMinUnarmed Weapon.UnarmedMinUnarmed
///@ MigrationRule Property Item Rename Weapon_UnarmedMinLevel Weapon.UnarmedMinLevel
///@ MigrationRule Property Item Rename Weapon_MaxAmmoCount Weapon.MaxAmmoCount
///@ MigrationRule Property Item Rename Weapon_Caliber Weapon.Caliber
///@ MigrationRule Property Item Rename Weapon_DefaultAmmoPid Weapon.DefaultAmmoPid
///@ MigrationRule Property Item Rename Weapon_StateAnim Weapon.StateAnim
///@ MigrationRule Property Item Rename Weapon_MinStrength Weapon.MinStrength
///@ MigrationRule Property Item Rename Weapon_Perk Weapon.Perk
///@ MigrationRule Property Item Rename Weapon_IsTwoHanded Weapon.IsTwoHanded
///@ MigrationRule Property Item Rename Weapon_ActiveUses Weapon.ActiveUses
///@ MigrationRule Property Item Rename Weapon_Skill_0 Weapon.Skill_0
///@ MigrationRule Property Item Rename Weapon_Skill_1 Weapon.Skill_1
///@ MigrationRule Property Item Rename Weapon_Skill_2 Weapon.Skill_2
///@ MigrationRule Property Item Rename Weapon_PicUse_0 Weapon.PicUse_0
///@ MigrationRule Property Item Rename Weapon_PicUse_1 Weapon.PicUse_1
///@ MigrationRule Property Item Rename Weapon_PicUse_2 Weapon.PicUse_2
///@ MigrationRule Property Item Rename Weapon_MaxDist_0 Weapon.MaxDist_0
///@ MigrationRule Property Item Rename Weapon_MaxDist_1 Weapon.MaxDist_1
///@ MigrationRule Property Item Rename Weapon_MaxDist_2 Weapon.MaxDist_2
///@ MigrationRule Property Item Rename Weapon_Round_0 Weapon.Round_0
///@ MigrationRule Property Item Rename Weapon_Round_1 Weapon.Round_1
///@ MigrationRule Property Item Rename Weapon_Round_2 Weapon.Round_2
///@ MigrationRule Property Item Rename Weapon_ApCost_0 Weapon.ApCost_0
///@ MigrationRule Property Item Rename Weapon_ApCost_1 Weapon.ApCost_1
///@ MigrationRule Property Item Rename Weapon_ApCost_2 Weapon.ApCost_2
///@ MigrationRule Property Item Rename Weapon_Aim_0 Weapon.Aim_0
///@ MigrationRule Property Item Rename Weapon_Aim_1 Weapon.Aim_1
///@ MigrationRule Property Item Rename Weapon_Aim_2 Weapon.Aim_2
///@ MigrationRule Property Item Rename Weapon_SoundId_0 Weapon.SoundId_0
///@ MigrationRule Property Item Rename Weapon_SoundId_1 Weapon.SoundId_1
///@ MigrationRule Property Item Rename Weapon_SoundId_2 Weapon.SoundId_2
///@ MigrationRule Property Item Rename Weapon_DmgType_0 Weapon.DmgType_0
///@ MigrationRule Property Item Rename Weapon_DmgType_1 Weapon.DmgType_1
///@ MigrationRule Property Item Rename Weapon_DmgType_2 Weapon.DmgType_2
