///@ MigrationRule Property Item Rename Weapon_DmgMin_1 Weapon.DmgMin_1
///@ MigrationRule Property Item Rename Weapon_DmgMin_2 Weapon.DmgMin_2
///@ MigrationRule Property Item Rename Weapon_DmgMax_0 Weapon.DmgMax_0
///@ MigrationRule Property Item Rename Weapon_DmgMax_1 Weapon.DmgMax_1
///@ MigrationRule Property Item Rename Weapon_DmgMax_2 Weapon.DmgMax_2
///@ MigrationRule Property Item Rename Weapon_Remove_0 Weapon.Remove_0
///@ MigrationRule Property Item Rename Weapon_Remove_1 Weapon.Remove_1
///@ MigrationRule Property Item Rename Weapon_Remove_2 Weapon.Remove_2
///@ MigrationRule Property Item Rename Weapon_Effect_0 Weapon.Effect_0
///@ MigrationRule Property Item Rename Weapon_Effect_1 Weapon.Effect_1
///@ MigrationRule Property Item Rename Weapon_Effect_2 Weapon.Effect_2
///@ MigrationRule Property Item Rename Weapon_ReloadAp Weapon.ReloadAp
///@ MigrationRule Property Item Rename Weapon_UnarmedCriticalBonus Weapon.UnarmedCriticalBonus
