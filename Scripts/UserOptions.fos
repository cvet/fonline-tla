// UserOptions — выбор игрока в окне опций и его сохранение в локальный конфиг клиента (LocalSettings.focfg).
// Настройки движка во время игры неизменяемы: что меняется на лету (язык, разрешение, полноэкранный режим, поверх
// окон, громкость), применяет и хранит свой владелец в движке, и сохраняется его текущее значение. Прокси движку
// применить нечем до переподключения, поэтому выбор хранится здесь и действует со следующего запуска.
// Сохраняется конфиг с ключами вида Группа.Имя — движок применяет только такие.
// CLIENT. Глобальное состояние: выбранные параметры прокси; при старте клиента они равны настройкам.
namespace UserOptions
{

#if CLIENT

int ProxyType = 0;
string ProxyHost = "";
int ProxyPort = 0;
string ProxyUser = "";
string ProxyPass = "";

[[ModuleInit]]
void InitUserOptions()
{
    ProxyType = Settings.ClientNetwork.ProxyType;
    ProxyHost = Settings.ClientNetwork.ProxyHost;
    ProxyPort = Settings.ClientNetwork.ProxyPort;
    ProxyUser = Settings.ClientNetwork.ProxyUser;
    ProxyPass = Settings.ClientNetwork.ProxyPass;
}

int GetProxyType()
{
    return ProxyType;
}

void SetProxyType(int value)
{
    ProxyType = value;
}

string GetProxyHost()
{
    return ProxyHost;
}

void SetProxyHost(string value)
{
    ProxyHost = value;
}

int GetProxyPort()
{
    return ProxyPort;
}

void SetProxyPort(int value)
{
    ProxyPort = value;
}

string GetProxyUser()
{
    return ProxyUser;
}

void SetProxyUser(string value)
{
    ProxyUser = value;
}

string GetProxyPass()
{
    return ProxyPass;
}

void SetProxyPass(string value)
{
    ProxyPass = value;
}

// Записывает текущий выбор в локальный конфиг; движок применит его при следующем запуске клиента.
void Save()
{
    dict<string, string> options = {{"Client.Language", CurrentLanguage},
                                    {"View.ScreenWidth", "" + ScreenSize.width},
                                    {"View.ScreenHeight", "" + ScreenSize.height},
                                    {"Render.Fullscreen", "" + Game.IsFullscreen()},
                                    {"Render.AlwaysOnTop", "" + Game.IsAlwaysOnTop()},
                                    {"Audio.MusicVolume", "" + Game.GetMusicVolume()},
                                    {"Audio.SoundVolume", "" + Game.GetSoundVolume()},
                                    {"Movement.AlwaysRun", "" + Settings.Movement.AlwaysRun},
                                    //{ "DefaultCombatMode", "" + Settings.DefaultCombatMode },
                                    {"ClientNetwork.ProxyType", "" + ProxyType},
                                    {"ClientNetwork.ProxyHost", ProxyHost},
                                    {"ClientNetwork.ProxyPort", "" + ProxyPort},
                                    {"ClientNetwork.ProxyUser", ProxyUser},
                                    {"ClientNetwork.ProxyPass", ProxyPass}};
    Game.SetUserConfig(options);
}

#endif

}
