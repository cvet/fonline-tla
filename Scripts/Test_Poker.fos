// Test_Poker — регрессии чистой карточной логики покерного ИИ.
// Проверяет выбор сбрасываемой карты для стрейт-дро независимо от порядка сдачи.
namespace Test_Poker
{

#if SERVER

[[ModuleInit]]
void InitTestPoker()
{
    Game.OnTestingInit.Subscribe(OnTestingInit);
}

[[Event]]
void OnTestingInit()
{
    Testing::RegisterTest("poker", "near_straight_replace", NearStraightReplace);
}

void NearStraightReplace(Testing::TestContext ctx)
{
    Testing::ExpectEq(ctx, Poker::FindNearStraightReplaceCard({9, 4, 6, 5, 7}), 0, "ИИ должен сбрасывать выброс перед четырьмя последовательными рангами");
    Testing::ExpectEq(ctx, Poker::FindNearStraightReplaceCard({5, 7, 9, 4, 6}), 2, "Перестановка той же руки должна выбрать ту же карту, а не ту же позицию");
    Testing::ExpectEq(ctx, Poker::FindNearStraightReplaceCard({0, 6, 8, 9, 10}), 0, "Внутренний пробел стрейта должен распознаваться");
    Testing::ExpectEq(ctx, Poker::FindNearStraightReplaceCard({1, 2, 3, 4, 6}), 4, "Открытый стрейт-дро с двумя выходами должен иметь приоритет");
    Testing::ExpectEq(ctx, Poker::FindNearStraightReplaceCard({8, 9, 10, 11, 0}), 4, "Верхний стрейт-дро до туза должен распознаваться без выхода за диапазон");
    Testing::ExpectEq(ctx, Poker::FindNearStraightReplaceCard({0, 2, 5, 8, 12}), -1, "Разрозненная рука не должна считаться стрейт-дро");
    Testing::ExpectEq(ctx, Poker::FindNearStraightReplaceCard({2, 2, 3, 4, 8}), -1, "Повторяющиеся удерживаемые ранги не образуют стрейт-дро");
    Testing::ExpectEq(ctx, Poker::FindNearStraightReplaceCard({1, 2, 3, 4}), -1, "Неполная рука должна отклоняться");
}

#endif

}
