// TextFormatting — формирование строковых аргументов текста в виде "имя:значение".
// Хелперы TextArg(...) склеивают пары имя/значение для подстановочных тегов текста;
//  свойства TextArgs объявлены на Item и Critter как Common (обе стороны), синхронизируемые и сохраняемые.
namespace TextFormatting
{

///@ Property Item Common string TextArgs Mutable PublicSync Persistent
///@ Property Critter Common string TextArgs Mutable PublicSync Persistent

string TextArg(string name, string value)
{
    return name + ":" + value;
}

string TextArg(string name, int value)
{
    return TextArg(name, "" + value);
}

}
