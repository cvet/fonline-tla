// Test_Parameters — тесты выбора обычного и таймерного применения предметов.
namespace Test_Parameters
{

#if SERVER

[[ModuleInit]]
void InitTestParameters()
{
    Game.OnTestingInit.Subscribe(OnTestingInit);
}

[[Event]]
void OnTestingInit()
{
    Testing::RegisterTest("parameters", "timed_item_contract", TimedItemContract);
}

void TimedItemContract(Testing::TestContext ctx)
{
    ProtoItem dynamite = Game.GetProtoItem(Content::Item::dynamite);
    if (!Testing::Expect(ctx, Parameters::IsTimedUseItem(dynamite), "Динамит должен открывать окно таймера")) {
        return;
    }

    ProtoItem plasticExplosives = Game.GetProtoItem(Content::Item::plastic_explosives);
    if (!Testing::Expect(ctx, plasticExplosives.IsCanUse, "Пластид должен оставаться применяемым предметом")) {
        return;
    }

    if (!Testing::Expect(ctx, !Parameters::IsTimedUseItem(plasticExplosives), "Пластид с детонатором не должен открывать таймер")) {
        return;
    }

    ProtoItem scienceBook = Game.GetProtoItem(Content::Item::big_book_of_science);
    Testing::Expect(ctx, !Parameters::IsTimedUseItem(scienceBook), "Обычный применяемый предмет не должен открывать таймер");
}

#endif

}
