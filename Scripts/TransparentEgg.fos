// TransparentEgg — прозрачность перекрывающих персонажа стен и декораций.
// CLIENT: перед отрисовкой карты привязывает основное яйцо к текущему спрайту выбранного персонажа.
namespace TransparentEgg
{

#if CLIENT

[[ModuleInit]]
void InitTransparentEgg()
{
    Game.OnRenderMap_BeforeTiles.Subscribe(OnRenderMapBeforeTiles);
}

[[Event]]
void OnRenderMapBeforeTiles(Map map, irect drawArea)
{
    // Нативный метод учитывает анимацию, смещение спрайта и принадлежность персонажа карте.
    // При отсутствии персонажа он очищает яйцо, чтобы на карте не осталось прозрачного пятна.
    map.SetTransparentEgg(TransparentEggSlot::Primary, HasChosen ? Chosen : null);
}

#endif

}
