// CritterFidget — случайные анимации простоя видимых криттеров, только на клиенте.
// Таймер принадлежит криттеру; движение, бой и другие анимации имеют приоритет.
namespace CritterFidget
{

///@ Setting Client int32 Critter.CritterFidgetTime

#if CLIENT

[[ModuleInit]]
void InitCritterFidget()
{
    verify(Settings.Critter.CritterFidgetTime > 0 && Settings.Critter.CritterFidgetTime <= 1073741823, "Invalid critter fidget interval");
    Game.OnCritterIn.Subscribe(OnCritterIn);
    Game.OnCritterOut.Subscribe(OnCritterOut);
}

timespan NextDelay()
{
    return Time::Milliseconds(Game.Random(Settings.Critter.CritterFidgetTime, Settings.Critter.CritterFidgetTime * 2));
}

[[Event]]
void OnCritterIn(Critter cr)
{
    // Повторное появление начинает новый случайный интервал, без дублирования таймера.
    cr.StopTimeEvent(ProcessFidget);
    cr.StartTimeEvent(NextDelay(), ProcessFidget);
}

[[Event]]
void OnCritterOut(Critter cr)
{
    cr.StopTimeEvent(ProcessFidget);
}

[[TimeEvent]]
void ProcessFidget(Critter cr, TimeEventContext event)
{
    event.Repeat(NextDelay());

    if (!HasCurMap || cr.MapId != CurMap.Id || !cr.IsAlive() || cr.IsMoving() || cr.IsAnimPlaying() || !ChosenActions::IsFree(cr) ||
        Time::IsTimeoutActive(cr.TimeoutBattle)) {
        return;
    }

    cr.Animate(CritterStateAnim::None, CritterActionAnim::Fidget);
}

#endif

}
