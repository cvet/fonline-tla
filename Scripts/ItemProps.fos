///@ Property Item Common uint8 AnimHide1
///@ Property Item Common uint8 AnimShow0
///@ Property Item Common uint8 AnimShow1
///@ Property Item Common uint8 AnimStay0
///@ Property Item Common uint8 AnimStay1
// FixedFrame на карте: 0 — обычное поведение, 1..N — кадр загруженного ресурса анимации.
