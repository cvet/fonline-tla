// Test_Merc — чистые регрессии политики отложенного увольнения мерков.
// Проверяет защиту нового контракта от просроченного ReleaseMerc независимо от async-захватов.
namespace Test_Merc
{

#if SERVER

[[ModuleInit]]
void InitTestMerc()
{
    Game.OnTestingInit.Subscribe(OnTestingInit);
}

[[Event]]
void OnTestingInit()
{
    Testing::RegisterTest("merc", "stale_release_guard", StaleReleaseGuard);
}

void StaleReleaseGuard(Testing::TestContext ctx)
{
    if (!Testing::Expect(ctx, Merc::CanReleaseMerc(false), "Свободного мерка можно вернуть домой")) {
        return;
    }

    Testing::Expect(ctx, !Merc::CanReleaseMerc(true), "Просроченный таймер не должен увольнять повторно нанятого мерка");
}

#endif

}
