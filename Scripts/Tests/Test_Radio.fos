// Test_Radio — тесты нормализации номера радиоканала.
namespace Test_Radio
{

#if SERVER

[[ModuleInit]]
void InitTestRadio()
{
    Game.OnTestingInit.Subscribe(OnTestingInit);
}

[[Event]]
void OnTestingInit()
{
    Testing::RegisterTest("radio", "channel_input_normalization", ChannelInputNormalization);
}

void ChannelInputNormalization(Testing::TestContext ctx)
{
    if (!Testing::ExpectEq(ctx, Radio::NormalizeChannel(-1), 0, "Отрицательный канал должен стать нулевым")) {
        return;
    }
    if (!Testing::ExpectEq(ctx, Radio::NormalizeChannel(70000), 0xFFFF, "Канал не должен превышать 65535")) {
        return;
    }
    if (!Testing::ExpectEq(ctx, Radio::ParseChannel("123\n"), 123, "Enter не должен оставаться в номере канала")) {
        return;
    }
    if (!Testing::ExpectEq(ctx, Radio::ParseChannel("65536"), 0xFFFF, "Текстовый канал должен ограничиваться серверным диапазоном")) {
        return;
    }
    if (!Testing::ExpectEq(ctx, Radio::ParseChannel("-12"), 0, "Отрицательный текстовый канал должен стать нулевым")) {
        return;
    }

    Testing::ExpectEq(ctx, Radio::ParseChannel("radio"), 0, "Некорректный текст канала должен стать нулём");
}

#endif

}
