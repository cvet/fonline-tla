// Test_EnergyBarier — регрессии решения об автовключении сети силовых полей.
// Проверяет чистую часть механики независимо от async-захвата предметов и карт.
namespace Test_EnergyBarier
{

#if SERVER

[[ModuleInit]]
void InitTestEnergyBarier()
{
    Game.OnTestingInit.Subscribe(OnTestingInit);
}

[[Event]]
void OnTestingInit()
{
    Testing::RegisterTest("energy_barier", "auto_enable_policy", AutoEnablePolicy);
}

void AutoEnablePolicy(Testing::TestContext ctx)
{
    Testing::Expect(ctx,
                    EnergyBarier::ShouldAutoEnable(EnergyBarier::BM_OFF, EnergyBarier::AE_DEFAULT, 0, 1),
                    "Обычное отключение должно включиться обратно при нулевом Val4");
    Testing::Expect(ctx,
                    !EnergyBarier::ShouldAutoEnable(EnergyBarier::BM_OFF, EnergyBarier::AE_DEFAULT, 1, 0),
                    "Обычное отключение не должно использовать флаг половинной мощности Val5");
    Testing::Expect(ctx,
                    EnergyBarier::ShouldAutoEnable(EnergyBarier::BM_HALF_ON, EnergyBarier::AE_DEFAULT, 1, 0),
                    "Половинная мощность должна включиться обратно при нулевом Val5");
    Testing::Expect(ctx,
                    !EnergyBarier::ShouldAutoEnable(EnergyBarier::BM_HALF_ON, EnergyBarier::AE_DEFAULT, 0, 1),
                    "Половинная мощность не должна использовать обычный флаг Val4");
    Testing::Expect(ctx,
                    EnergyBarier::ShouldAutoEnable(EnergyBarier::BM_OFF_NO_GUARD, EnergyBarier::AE_ON, 1, 1),
                    "AE_ON должен принудительно планировать автовключение");
    Testing::Expect(ctx,
                    !EnergyBarier::ShouldAutoEnable(EnergyBarier::BM_OFF, EnergyBarier::AE_OFF, 0, 0),
                    "AE_OFF должен запрещать автовключение независимо от свойств барьера");
    Testing::Expect(ctx,
                    !EnergyBarier::ShouldAutoEnable(EnergyBarier::BM_ON, EnergyBarier::AE_DEFAULT, 0, 0),
                    "Уже включённая сеть не должна планировать ещё одно включение");
}

#endif

}
