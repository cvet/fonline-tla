// Migration — правила миграции сериализованных данных при загрузке сохранёнок/контента.
// Содержит только MigrationRule-декларации движка: удаление и переименования свойств Critter и Item
// Правила сохраняют совместимость старых сохранений с актуальной схемой.
// SERVER: применяется движком на стороне сервера при разборе сериализованных свойств.
namespace Migration
{

#if SERVER

// Idle живого криттера выбирается в Animation::GetIdleActionAnim; сохранённое значение больше не используется.
///@ MigrationRule Property Critter Remove ActionAnimAlive
///@ MigrationRule Property Critter Remove AliveActionAnim

// Переименования свойств криттеров и предметов (старое имя -> новое имя).

///@ MigrationRule Property Critter Rename ActionAnimKnockout KnockoutActionAnim
///@ MigrationRule Property Critter Rename ActionAnimDead DeadActionAnim
///@ MigrationRule Property Critter Rename IsNoFlatten DeadDrawNoFlatten
///@ MigrationRule Property Item Rename Lexems TextArgs
///@ MigrationRule Property Critter Rename Lexems TextArgs

#endif

}
